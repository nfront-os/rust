# 9front port (../NOTES.md): the compiler for Linux, std for x86_64-unknown-plan9,
# linked by 9front-gcc's cross gcc against the built 9front tree (its sysroot)
profile = "compiler"
change-id = "ignore"

[llvm]
download-ci-llvm = true

[build]
# the submodules are the port's branches (llvm-project: plan9): bootstrap leaves them
submodules = false
target = ["x86_64-unknown-linux-gnu", "x86_64-unknown-plan9"]
docs = false
extended = false

[rust]
channel = "dev"
download-rustc = false
lld = false
llvm-tools = false

[target.x86_64-unknown-plan9]
cc = "$GCC9/build-gcc/amd64/cross/bin/x86_64-pc-plan9-gcc"
cxx = "$GCC9/build-gcc/amd64/cross/bin/x86_64-pc-plan9-g++"
ar = "$GCC9/build-gcc/amd64/cross/bin/x86_64-pc-plan9-ar"
ranlib = "$GCC9/build-gcc/amd64/cross/bin/x86_64-pc-plan9-ranlib"
linker = "$GCC9/build-gcc/amd64/cross/bin/x86_64-pc-plan9-gcc"
# rustc for 9front: its LLVM (scripts/build-llvm.sh; llvm-config answers on Linux:
# scripts/llvm-config-plan9.sh)
llvm-config = "/home/stefan/Devel/9front-rust/build/llvm-plan9/bin/llvm-config"

# 386 (cross only): ./x build --stage 1 library --target i686-unknown-plan9
[target.i686-unknown-plan9]
cc = "$GCC9/build-gcc/386/cross/bin/i686-pc-plan9-gcc"
cxx = "$GCC9/build-gcc/386/cross/bin/i686-pc-plan9-g++"
ar = "$GCC9/build-gcc/386/cross/bin/i686-pc-plan9-ar"
ranlib = "$GCC9/build-gcc/386/cross/bin/i686-pc-plan9-ranlib"
linker = "$GCC9/build-gcc/386/cross/bin/i686-pc-plan9-gcc"
# rustc for 9front 386: its LLVM (objtype=386 scripts/build-llvm.sh, llvm-config-plan9.sh)
llvm-config = "/home/stefan/Devel/9front-rust/build/llvm-plan9.386/bin/llvm-config"
