# 9front port (../NOTES.md): the compiler for Linux, std for x86_64-unknown-plan9,
# linked by 9front-gcc's cross gcc against the built 9front tree (its sysroot)
profile = "compiler"
change-id = "ignore"

[llvm]
download-ci-llvm = true

[build]
# the sources are an archive (fetch.sh) with vendor/; our patches change dependencies
# (libc by path, crates of other versions): cargo fetches them as for a clone
vendor = false
# the submodules are the port's branches (llvm-project: plan9): bootstrap leaves them
submodules = false
target = ["x86_64-unknown-linux-gnu", "x86_64-unknown-plan9", "i686-unknown-plan9", "aarch64-unknown-plan9"]
docs = false
extended = false

[rust]
channel = "dev"
download-rustc = false
lld = false
llvm-tools = false

[target.x86_64-unknown-plan9]
# ./x test: the test binaries run in a 9front guest
runner = "$RUST9/tests/std-runner.sh"
cc = "$GCC9/build/amd64/cross/bin/x86_64-pc-plan9-gcc"
cxx = "$GCC9/build/amd64/cross/bin/x86_64-pc-plan9-g++"
ar = "$GCC9/build/amd64/cross/bin/x86_64-pc-plan9-ar"
ranlib = "$GCC9/build/amd64/cross/bin/x86_64-pc-plan9-ranlib"
linker = "$GCC9/build/amd64/cross/bin/x86_64-pc-plan9-gcc"
# rustc for 9front: its LLVM (scripts/build-llvm.sh; llvm-config answers on Linux:
# scripts/llvm-config-plan9.sh)
llvm-config = "$RUST9/build/llvm-plan9/bin/llvm-config"

# 386 (cross only): ./x build --stage 1 library --target i686-unknown-plan9
[target.i686-unknown-plan9]
# ./x test: the test binaries run in a 9front guest
runner = "$RUST9/tests/std-runner.sh"
cc = "$GCC9/build/386/cross/bin/i686-pc-plan9-gcc"
cxx = "$GCC9/build/386/cross/bin/i686-pc-plan9-g++"
ar = "$GCC9/build/386/cross/bin/i686-pc-plan9-ar"
ranlib = "$GCC9/build/386/cross/bin/i686-pc-plan9-ranlib"
linker = "$GCC9/build/386/cross/bin/i686-pc-plan9-gcc"
# rustc for 9front 386: its LLVM (objtype=386 scripts/build-llvm.sh, llvm-config-plan9.sh)
llvm-config = "$RUST9/build/llvm-plan9.386/bin/llvm-config"
[target.aarch64-unknown-plan9]
# arm64: 9front-gcc's aarch64-pc-plan9 (objtype=arm64 build.sh cross)
runner = "$RUST9/tests/std-runner.sh"
cc = "$GCC9/build/arm64/cross/bin/aarch64-pc-plan9-gcc"
cxx = "$GCC9/build/arm64/cross/bin/aarch64-pc-plan9-g++"
ar = "$GCC9/build/arm64/cross/bin/aarch64-pc-plan9-ar"
ranlib = "$GCC9/build/arm64/cross/bin/aarch64-pc-plan9-ranlib"
linker = "$GCC9/build/arm64/cross/bin/aarch64-pc-plan9-gcc"
# rustc for 9front arm64: its LLVM (objtype=arm64 scripts/build-llvm.sh, llvm-config-plan9.sh)
llvm-config = "$RUST9/build/llvm-plan9.arm64/bin/llvm-config"
[target.riscv64gc-unknown-plan9]
# riscv64: 9front-gcc's riscv64-unknown-plan9 (branch riscv, objtype=riscv64 build.sh cross;
# its sysroot is ../9front-riscv)
runner = "$RUST9/tests/std-runner.sh"
cc = "$GCC9/build/riscv64/cross/bin/riscv64-unknown-plan9-gcc"
cxx = "$GCC9/build/riscv64/cross/bin/riscv64-unknown-plan9-g++"
ar = "$GCC9/build/riscv64/cross/bin/riscv64-unknown-plan9-ar"
ranlib = "$GCC9/build/riscv64/cross/bin/riscv64-unknown-plan9-ranlib"
linker = "$GCC9/build/riscv64/cross/bin/riscv64-unknown-plan9-gcc"
