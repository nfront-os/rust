From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 29 Oct 2026 12:48:23 +0100
Subject: [PATCH 3/7] plan9: APE's POSIX types and errno values, for bindings
 of C libraries built against APE

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/plan9.rs | 99 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 99 insertions(+)

diff --git a/src/plan9.rs b/src/plan9.rs
index 1a141aa1f..1245de453 100644
--- a/src/plan9.rs
+++ b/src/plan9.rs
@@ -306,3 +306,102 @@ extern "C" {
 pub const STDIN_FILENO: c_int = 0;
 pub const STDOUT_FILENO: c_int = 1;
 pub const STDERR_FILENO: c_int = 2;
+
+/*
+ * APE's: the POSIX types of the C libraries built against Plan 9's POSIX layer
+ * (<sys/types.h> &c. of /sys/include/ape, as 9front's gcc port compiles them), for
+ * the bindings of such libraries (zlib, curl, ...). Its functions are not here.
+ */
+pub type off_t = c_longlong;
+pub type mode_t = c_ushort;
+pub type uid_t = c_short;
+pub type gid_t = c_short;
+pub type pid_t = c_int;
+pub type time_t = c_long;
+pub type socklen_t = c_int;
+
+s! {
+    pub struct fd_set {
+        pub fds_bits: [c_long; 3],
+    }
+
+    pub struct sockaddr {
+        pub sa_family: c_ushort,
+        pub sa_data: [c_char; 108],
+    }
+}
+
+/* APE's errno values (<errno.h> of /sys/include/ape, 9front-gcc's compat for the rest) */
