index 5ba5cc96f41..07e67636747 100644
--- a/library/std/src/sys/pal/plan9/mod.rs
+++ b/library/std/src/sys/pal/plan9/mod.rs
@@ -32,6 +32,7 @@ pub fn unsupported_err() -> io::Error {
 // NOTE: this is not guaranteed to run, for example when Rust code is called externally.
 pub unsafe fn init(argc: isize, argv: *const *const u8, sigpipe: u8) {
     proc::keep_mainstack();
+    crate::sys::alloc::keep_c_alloc();
     unsafe {
         crate::sys::args::init(argc, argv);
         // sigpipe: DEFAULT (0) ignores it, as on unix; INHERIT (1) and SIG_DFL (3) keep
diff --git a/library/std/src/sys/pal/plan9/proc.rs b/library/std/src/sys/pal/plan9/proc.rs
index f8c062ff481..931ccd53997 100644
--- a/library/std/src/sys/pal/plan9/proc.rs
+++ b/library/std/src/sys/pal/plan9/proc.rs
@@ -177,9 +177,17 @@ fn kill_proc(pid: i32) {
     }
 }
 
+unsafe extern "C" {
+    /// APE in the program (ap/gnu/native.c, linked through this: it attaches APE from a
+    /// constructor); runs APE's atexit functions.
+    fn __ape_exit();
+}
+
 /// The program ends with `status` (exits(2)): the other threads go; from a thread, the
 /// proc that runs `main` ends with a note of the status, so that its parent sees that.
 pub fn end_program(status: &crate::ffi::CStr) -> ! {
+    // APE's atexit functions (the C's; stdio's flush): ap/gnu/native.c of 9front
+    unsafe { __ape_exit() };
     let me = unsafe { libc::getpid() };
     let main = MAIN_PID.load(Relaxed);
     ALL_LOCK.lock();
@@ -587,11 +595,64 @@ struct MainArgs {
 }
 
 /// Keeps `__plan9_mainstack` in the link: libgcc refers to it only weakly.
+struct CThread {
+    f: unsafe extern "C" fn(*mut c_void),
+    arg: *mut c_void,
+}
+
+unsafe fn cthread_main(v: *mut c_void) {
+    unsafe {
+        let c = v as *mut CThread;
+        let CThread { f, arg } = ptr::read(c);
+        libc::free(c.cast());
+        f(arg);
+    }
+}
+
+/// For C in the program (APE's POSIX threads, ap/gnu/pthread.c): a thread as std's, on a stack
+/// of `stack_size` bytes (0: std's default), running `f(arg)`; its handle, or null and the
+/// error string. The handle goes to `__plan9_thread_join` or `__plan9_thread_detach`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __plan9_thread_spawn(
+    stack_size: usize,
+    f: unsafe extern "C" fn(*mut c_void),
+    arg: *mut c_void,
+) -> *mut c_void {
+    unsafe {
+        let c = libc::malloc(size_of::<CThread>() as libc::ulong) as *mut CThread;
+        if c.is_null() {
+            return ptr::null_mut();
+        }
+        ptr::write(c, CThread { f, arg });
+        let size = if stack_size == 0 { crate::sys::thread::DEFAULT_MIN_STACK_SIZE } else { stack_size };
+        let p = spawn(size, cthread_main, c.cast());
+        if p.is_null() {
+            libc::free(c.cast());
+        }
+        p.cast()
+    }
+}
+
+/// Waits for a thread of `__plan9_thread_spawn`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __plan9_thread_join(p: *mut c_void) {
+    unsafe { join(p.cast()) }
+}
+
+/// A thread of `__plan9_thread_spawn` goes on without anyone waiting for it.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __plan9_thread_detach(p: *mut c_void) {
+    unsafe { detach(p.cast()) }
+}
+
 /// Keeps `__plan9_mainstack` and `__plan9_rforkproc` in the link: libgcc refers to the one
 /// only weakly, the other the C after std in the link.
 pub fn keep_mainstack() {
     crate::hint::black_box((__plan9_mainstack as *const ()).expose_provenance());
     crate::hint::black_box((__plan9_rforkproc as *const ()).expose_provenance());
+    crate::hint::black_box((__plan9_thread_spawn as *const ()).expose_provenance());
+    crate::hint::black_box((__plan9_thread_join as *const ()).expose_provenance());
+    crate::hint::black_box((__plan9_thread_detach as *const ()).expose_provenance());
 }
 
