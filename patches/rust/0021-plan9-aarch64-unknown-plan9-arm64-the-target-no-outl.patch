+// arm64: the system call number in R0, the argument at 8(SP) (libc's stubs), SVC #0; the
+// kernel gives the child a copy of all its parent's registers (arm64/trap.c forkchild), R0
+// zero. AAPCS64: x19-x29 callee-saved, x30 the link; the stack 16-byte aligned. As APE's
+// pthread.c, privtop and the argument go to the child in x26 and x27.
+/// Runs `f(arg)` on the stack below `top`, back on the caller's after.
+#[cfg(target_arch = "aarch64")]
+#[unsafe(naked)]
+unsafe extern "C" fn __rust_plan9_runon(
+    top: *mut u8,
+    f: unsafe extern "C" fn(*mut c_void),
+    arg: *mut c_void,
+) {
+    crate::arch::naked_asm!(
+        "   stp x29, x30, [sp, #-16]!",
+        "   mov x29, sp",
+        "   mov sp, x0",
+        "   mov x0, x2",
+        "   blr x1",
+        "   mov sp, x29",
+        "   ldp x29, x30, [sp], #16",
+        "   ret",
+    )
+}
+
+/// `rfork(flags)`; the child goes on at `__rust_plan9_threadstart(arg)` on the stack
+/// below `privtop`, without touching its parent's.
+#[cfg(target_arch = "aarch64")]
+#[unsafe(naked)]
+unsafe extern "C" fn __rust_plan9_rforkthread(flags: i32, privtop: usize, arg: *mut c_void) -> i32 {
+    crate::arch::naked_asm!(
+        "   sub sp, sp, #48",
+        "   str x0, [sp, #8]", // the argument, at 8(SP)
+        "   stp x29, x30, [sp, #16]",
+        "   stp x26, x27, [sp, #32]",
+        "   mov x26, x1",
+        "   mov x27, x2",
+        "   mov x0, #19", // RFORK
+        "   svc #0",
+        "   cbz x0, 1f",
+        "   ldp x29, x30, [sp, #16]",
+        "   ldp x26, x27, [sp, #32]",
+        "   add sp, sp, #48",
+        "   ret",
+        "1: mov sp, x26",
+        "   mov x29, #0",
+        "   mov x0, x27",
+        "   bl {start}",
+        "2: b 2b",
+        start = sym __rust_plan9_threadstart,
+    )
+}
+
+/// The same for a child that runs `(*arg).0(arg)`: process::Command's.
+#[cfg(target_arch = "aarch64")]
+#[unsafe(naked)]
+unsafe extern "C" fn __rust_plan9_rforkrun(flags: i32, privtop: usize, arg: *const c_void) -> i32 {
+    crate::arch::naked_asm!(
+        "   sub sp, sp, #48",
+        "   str x0, [sp, #8]", // the argument, at 8(SP)
+        "   stp x29, x30, [sp, #16]",
+        "   stp x26, x27, [sp, #32]",
+        "   mov x26, x1",
+        "   mov x27, x2",
+        "   mov x0, #19", // RFORK
+        "   svc #0",
+        "   cbz x0, 1f",
+        "   ldp x29, x30, [sp, #16]",
+        "   ldp x26, x27, [sp, #32]",
+        "   add sp, sp, #48",
+        "   ret",
+        "1: mov sp, x26",
+        "   mov x29, #0",
+        "   ldr x16, [x27]",
+        "   mov x0, x27",
+        "   blr x16",
+        "2: b 2b",
+    )
+}
+
 /// What a child of [`rfork_run`] runs: `f(self)`, which must not return.
 #[repr(C)]
