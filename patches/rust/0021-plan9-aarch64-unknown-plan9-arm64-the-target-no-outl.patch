@@ -0,0 +1,28 @@
+use crate::spec::{Arch, StackProbeType, Target, TargetMetadata, TargetOptions, base};
+
+pub(crate) fn target() -> Target {
+    Target {
+        // as x86_64-unknown-plan9: an unknown OS is ELF and the AAPCS64, which 9front's gcc
+        // port (aarch64-pc-plan9) uses too
+        llvm_target: "aarch64-unknown-plan9".into(),
+        metadata: TargetMetadata {
+            description: Some("ARM64 9front (Plan 9)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        arch: Arch::AArch64,
+        // aarch64-unknown-linux-gnu's
+        data_layout: "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32".into(),
+        options: TargetOptions {
+            // no outline atomics: their helpers choose LSE through getauxval, which Plan 9 does
+            // not have (the tree and its gcc: -mno-outline-atomics)
+            features: "+v8a".into(),
+            max_atomic_width: Some(128),
+            stack_probes: StackProbeType::Inline,
+            linker: Some("aarch64-pc-plan9-gcc".into()),
+            ..base::plan9::opts()
+        },
+    }
+}
