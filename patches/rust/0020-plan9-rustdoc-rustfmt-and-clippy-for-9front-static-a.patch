From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sat, 31 Oct 2026 11:53:54 +0100
Subject: [PATCH 20/25] plan9: rustdoc, rustfmt and clippy for 9front: static
 as rustc (rustc_driver_impl instead of the rustc_driver dylib; bootstrap
 keeps the compiler's rlibs in a plan9 sysroot), rustdoc's Os::Plan9 and its
 lock through os::plan9::fs::lock_file; stacker and dirs-sys from crates/

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.toml                                       |  2 ++
 src/bootstrap/src/core/build_steps/compile.rs    |  8 +++++++-
 src/librustdoc/clean/cfg.rs                      |  1 +
 src/librustdoc/html/render/write_shared/flock.rs | 11 +++++++++++
 src/librustdoc/lib.rs                            |  4 ++++
 src/tools/clippy/clippy_utils/src/lib.rs         |  2 ++
 src/tools/clippy/src/driver.rs                   |  4 ++++
 src/tools/clippy/src/main.rs                     |  6 ++++++
 src/tools/rustdoc/main.rs                        |  4 ++++
 src/tools/rustfmt/src/bin/main.rs                |  4 ++++
 src/tools/rustfmt/src/lib.rs                     |  2 ++
 11 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index 74ac247ddfac7bbbad134ff5007e60ef8c68ad2d..3d997d1de57779958661c945626ed93081f27e00 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -93,3 +93,5 @@ getrandom = { path = "../crates/getrandom-0.3.3" }
 libc = { path = "../libc" }
 libloading = { path = "../crates/libloading-0.9.0" }
 jobserver = { path = "../crates/jobserver-0.1.34" }
+stacker = { path = "../crates/stacker-0.1.21" }
+dirs-sys = { path = "../crates/dirs-sys-0.5.0" }
diff --git a/src/bootstrap/src/core/build_steps/compile.rs b/src/bootstrap/src/core/build_steps/compile.rs
index 96fff685ee55fc6c7524ee31e1fa704e22522136..3d7f7ad2cfedaeb0c318cfbf385219ec5599c955 100644
--- a/src/bootstrap/src/core/build_steps/compile.rs
+++ b/src/bootstrap/src/core/build_steps/compile.rs
@@ -1150,6 +1150,9 @@ impl CommandLineStep for Rustc {
             target,
         );
         let stamp = build_stamp::librustc_stamp(builder, build_compiler, target);
+        // plan9: no librustc_driver.so; rustdoc, rustfmt and clippy link the crates in
+        // (as rustc-main does), from rlibs
+        let static_driver = target.contains("plan9");
 
         run_cargo(
             builder,
@@ -1157,7 +1160,10 @@ impl CommandLineStep for Rustc {
             vec![],
             &stamp,
             vec![],
-            ArtifactKeepMode::Custom(Box::new(|filename| {
+            ArtifactKeepMode::Custom(Box::new(move |filename| {
+                if static_driver && filename.ends_with(".rlib") {
+                    return true;
+                }
                 if filename.contains("jemalloc_sys")
                     || filename.contains("rustc_public_bridge")
                     || filename.contains("rustc_public")
diff --git a/src/librustdoc/clean/cfg.rs b/src/librustdoc/clean/cfg.rs
index 22bbac3fd0b385180d7863611be7f6ed9712cc5d..328ca3318b7b991bd63e90aeeca36ab4fddee1a3 100644
--- a/src/librustdoc/clean/cfg.rs
+++ b/src/librustdoc/clean/cfg.rs
@@ -684,6 +684,7 @@ fn human_readable_target_os(os: Symbol) -> Option<&'static str> {
         Nto => "QNX SDP 7.x",
         NuttX => "NuttX",
         OpenBsd => "OpenBSD",
+        Plan9 => "Plan 9",
         Ps3 => "Play Station 3",
         Psp => "Play Station Portable",
         Psx => "Play Station 1",
diff --git a/src/librustdoc/html/render/write_shared/flock.rs b/src/librustdoc/html/render/write_shared/flock.rs
index 385c0bcc84cd303f8883a93d0d0ff2650691ac35..0f9ef6d5118ca78f95b70654e9ea7c73ada7626e 100644
--- a/src/librustdoc/html/render/write_shared/flock.rs
+++ b/src/librustdoc/html/render/write_shared/flock.rs
@@ -15,6 +15,11 @@ pub(super) enum Lock {
     #[doc(hidden)]
     #[cfg(unix)]
     FcntlFallback { _lock: FcntlLock },
+    /// 9front (Plan 9) has no advisory locks: the file opened alone, as an exclusive-use
+    /// (DMEXCL) file (`std::os::plan9::fs::lock_file`, as rustc's flock).
+    #[doc(hidden)]
+    #[cfg(target_os = "plan9")]
+    Plan9 { _lock: std::os::plan9::fs::FileLock },
 }
 
 impl Lock {
@@ -35,6 +40,12 @@ impl Lock {
             Err(err) if matches!(err.kind(), io::ErrorKind::Unsupported) => {
                 Ok(Lock::FcntlFallback { _lock: FcntlLock::new(file)? })
             }
+            #[cfg(target_os = "plan9")]
+            Err(err) if matches!(err.kind(), io::ErrorKind::Unsupported) => {
+                // the lock is lock_file's own open (it makes the file exclusive-use)
+                drop(file);
+                Ok(Lock::Plan9 { _lock: std::os::plan9::fs::lock_file(p, true)? })
+            }
             Err(err) => Err(err),
         }
     }
diff --git a/src/librustdoc/lib.rs b/src/librustdoc/lib.rs
index 9a16942a2e5bcc6900bc3828179433cd05e0c4c2..d78ae0e1ae1f246a4b73234a154c646f3756cb1c 100644
--- a/src/librustdoc/lib.rs
+++ b/src/librustdoc/lib.rs
@@ -34,7 +34,11 @@ extern crate rustc_ast_pretty;
 extern crate rustc_attr_ir;
 extern crate rustc_attr_parsing;
 extern crate rustc_data_structures;
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
+// plan9: no dylibs, the compiler's crates are linked in (as rustc-main does)
+#[cfg(target_os = "plan9")]
+extern crate rustc_driver_impl as rustc_driver;
 extern crate rustc_errors;
 extern crate rustc_feature;
 extern crate rustc_hir;
diff --git a/src/tools/clippy/clippy_utils/src/lib.rs b/src/tools/clippy/clippy_utils/src/lib.rs
index eb5befb52c3e4cd03571309ff35ae9b07ac9208a..04ce3a5da68d2f838b8f298fb85a455fd168bbf9 100644
--- a/src/tools/clippy/clippy_utils/src/lib.rs
+++ b/src/tools/clippy/clippy_utils/src/lib.rs
@@ -25,6 +25,8 @@ extern crate rustc_data_structures;
     unused_extern_crates,
     reason = "The `rustc_driver` crate seems to be required in order to use the `rust_ast` crate."
 )]
+// plan9: no rustc_driver dylib to link; the compiler's crates come in as rlibs
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
 extern crate rustc_errors;
 extern crate rustc_hir;
diff --git a/src/tools/clippy/src/driver.rs b/src/tools/clippy/src/driver.rs
index e83fe592a7ca690678aaabd23f5e1cefe478df27..71aed94e3c5916427683c532e015020e06a30283 100644
--- a/src/tools/clippy/src/driver.rs
+++ b/src/tools/clippy/src/driver.rs
@@ -7,7 +7,11 @@
 
 // FIXME: switch to something more ergonomic here, once available.
 // (Currently there is no way to opt into sysroot crates without `extern crate`.)
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
+// plan9: no dylibs, the compiler's crates are linked in (as rustc-main does)
+#[cfg(target_os = "plan9")]
+extern crate rustc_driver_impl as rustc_driver;
 extern crate rustc_interface;
 extern crate rustc_session;
 extern crate rustc_span;
diff --git a/src/tools/clippy/src/main.rs b/src/tools/clippy/src/main.rs
index 14a437fc874fe6b4f9dab10b3fa46754af0f4ec3..2f02ceb2c18af3840e8cbd1c35f1c031f8dea2fb 100644
--- a/src/tools/clippy/src/main.rs
+++ b/src/tools/clippy/src/main.rs
@@ -4,7 +4,13 @@
 // warn on lints, that are included in `rust-lang/rust`s bootstrap
 #![warn(rust_2018_idioms, unused_lifetimes)]
 
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
+// plan9: no rustc_driver dylib; cargo-clippy needs only this of it (rustc_driver_impl's)
+#[cfg(target_os = "plan9")]
+mod rustc_driver {
+    pub const EXIT_FAILURE: i32 = 1;
+}
 
 use std::env;
 use std::io::Write as _;
diff --git a/src/tools/rustdoc/main.rs b/src/tools/rustdoc/main.rs
index 15fd67a50383072910b53562fe0298c4a5459f18..b643b81582d9ac756487c743b045d3de494d541e 100644
--- a/src/tools/rustdoc/main.rs
+++ b/src/tools/rustdoc/main.rs
@@ -1,7 +1,11 @@
 // We need this feature as it changes `dylib` linking behavior and allows us to link to `rustc_driver`.
 #![feature(rustc_private)]
 
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
+// plan9: no dylibs, the compiler's crates are linked in (as rustc-main does)
+#[cfg(target_os = "plan9")]
+extern crate rustc_driver_impl as rustc_driver;
 
 use std::process::ExitCode;
 
diff --git a/src/tools/rustfmt/src/bin/main.rs b/src/tools/rustfmt/src/bin/main.rs
index 0653ad3d937582e7d69e8cb0795ee2661236061c..9f587334fc5f35b13332942c161ce4ea2655b353 100644
--- a/src/tools/rustfmt/src/bin/main.rs
+++ b/src/tools/rustfmt/src/bin/main.rs
@@ -24,7 +24,11 @@ use crate::rustfmt::{
 const BUG_REPORT_URL: &str = "https://github.com/rust-lang/rustfmt/issues/new?labels=bug";
 
 // N.B. these crates are loaded from the sysroot, so they need extern crate.
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
+// plan9: no dylibs, the compiler's crates are linked in (as rustc-main does)
+#[cfg(target_os = "plan9")]
+extern crate rustc_driver_impl as rustc_driver;
 
 fn main() {
     rustc_driver::install_ice_hook(BUG_REPORT_URL, |_| ());
diff --git a/src/tools/rustfmt/src/lib.rs b/src/tools/rustfmt/src/lib.rs
index fb42b06d469b459583cb8dbb6eadb27432952d23..2ee2cada776e86a6c751abb990cb3f6fc4ee25c2 100644
--- a/src/tools/rustfmt/src/lib.rs
+++ b/src/tools/rustfmt/src/lib.rs
@@ -19,6 +19,8 @@ extern crate thin_vec;
 // Necessary to pull in object code as the rest of the rustc crates are shipped only as rmeta
 // files.
 #[allow(unused_extern_crates)]
+// plan9: no rustc_driver dylib to link; the compiler's crates come in as rlibs
+#[cfg(not(target_os = "plan9"))]
 extern crate rustc_driver;
 
 use std::cell::RefCell;
