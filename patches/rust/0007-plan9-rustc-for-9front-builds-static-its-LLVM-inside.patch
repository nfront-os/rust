diff --git a/Cargo.toml b/Cargo.toml
index 36a5d7dfbe1..b2ae1332e83 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -90,3 +90,5 @@ codegen-units = 1
 # 9front: the crates.io crates rustc needs for plan9, changed for it (9front-rust's crates/)
 [patch.crates-io]
 getrandom = { path = "../crates/getrandom-0.3.3" }
+libc = { path = "../libc" }
