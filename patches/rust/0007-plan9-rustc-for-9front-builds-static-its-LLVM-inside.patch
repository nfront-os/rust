+/// Plan 9 has no dylibs: rustc is one static program, $sysroot/bin/rustc.
+#[cfg(target_os = "plan9")]
+pub unsafe fn dll_path(_function: *mut std::ffi::c_void) -> Result<PathBuf, String> {
+    std::env::current_exe().map_err(|e| e.to_string())
+}
