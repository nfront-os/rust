+        .config
+        .target_config
+        .get(&target)
+        .and_then(|c| c.llvm_config.clone())
+        .filter(|_| target.contains("plan9"));
+    cargo.env("LLVM_CONFIG", target_llvm_config.unwrap_or_else(|| builder.host_llvm_config()));
 
