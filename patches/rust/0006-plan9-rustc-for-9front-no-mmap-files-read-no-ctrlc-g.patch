     unsafe { detach(p.cast()) }
 }
 
+/// For APE in the program (9front's ap/plan9/_exit.c, gen/abort.c): an `exit` or `abort` of
+/// the C ends the program as std does, its other threads with it, the status for the parent.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __plan9_exit(status: *const libc::c_char) -> ! {
+    let status = if status.is_null() { c"" } else { unsafe { crate::ffi::CStr::from_ptr(status) } };
+    end_program(status)
+}
+
 /// Keeps `__plan9_mainstack` and `__plan9_rforkproc` in the link: libgcc refers to the one
 /// only weakly, the other the C after std in the link.
 pub fn keep_mainstack() {
@@ -653,6 +661,7 @@ pub fn keep_mainstack() {
     crate::hint::black_box((__plan9_thread_spawn as *const ()).expose_provenance());
     crate::hint::black_box((__plan9_thread_join as *const ()).expose_provenance());
     crate::hint::black_box((__plan9_thread_detach as *const ()).expose_provenance());
+    crate::hint::black_box((__plan9_exit as *const ()).expose_provenance());
 }
 
