@@ -0,0 +1,88 @@
+//! A thread is a proc (sys/pal/plan9/proc.rs).
+
+use crate::ffi::c_void;
+use crate::io;
+use crate::num::NonZero;
+use crate::sys::pal::proc;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 2 * 1024 * 1024;
+const MIN_STACK_SIZE: usize = 64 * 1024;
+
+pub struct Thread {
+    packet: *mut proc::Packet,
+}
+
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+unsafe fn thread_main(arg: *mut c_void) {
+    unsafe {
+        let init = Box::from_raw(arg as *mut ThreadInit);
+        let rust_start = init.init();
+        rust_start();
+        crate::sys::thread_local::key::run_dtors();
+    }
+    crate::rt::thread_cleanup();
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        let arg = Box::into_raw(init);
+        let packet = proc::spawn(stack.max(MIN_STACK_SIZE), thread_main, arg.cast());
+        if packet.is_null() {
+            let err = crate::sys::pal::last_error();
+            drop(unsafe { Box::from_raw(arg) });
+            return Err(err);
+        }
+        Ok(Thread { packet })
+    }
+
+    pub fn join(self) {
+        let p = self.packet;
+        crate::mem::forget(self);
+        unsafe { proc::join(p) }
+    }
+}
+
+impl Drop for Thread {
+    fn drop(&mut self) {
+        unsafe { proc::detach(self.packet) }
+    }
+}
+
+/// The processors: lines of `/dev/sysstat`.
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    let fd = unsafe { libc::open(c"/dev/sysstat".as_ptr(), libc::OREAD | libc::OCEXEC) };
+    if fd < 0 {
+        return Err(io::Error::UNKNOWN_THREAD_COUNT);
+    }
+    let mut buf = [0u8; 8192];
+    let n = unsafe { libc::read(fd, buf.as_mut_ptr().cast(), buf.len() as libc::c_long) };
+    unsafe { libc::close(fd) };
+    if n <= 0 {
+        return Err(io::Error::UNKNOWN_THREAD_COUNT);
+    }
+    let lines = buf[..n as usize].iter().filter(|&&c| c == b'\n').count();
+    NonZero::new(lines).ok_or(io::Error::UNKNOWN_THREAD_COUNT)
+}
+
+pub fn current_os_id() -> Option<u64> {
+    Some(unsafe { libc::getpid() } as u64)
+}
+
+pub fn yield_now() {
+    unsafe { libc::sleep(0) };
+}
+
+/// sleep(2) counts milliseconds: rounded up, so it never ends early.
+pub fn sleep(dur: Duration) {
+    let mut ms = dur.as_nanos().div_ceil(1_000_000);
+    while ms > 0 {
+        let n = ms.min(i32::MAX as u128);
+        unsafe { libc::sleep(n as libc::c_long) };
+        ms -= n;
+    }
+}
diff --git a/library/std/src/sys/thread_local/key/plan9.rs b/library/std/src/sys/thread_local/key/plan9.rs
new file mode 100644
index 00000000000..55f74996047
--- /dev/null
+++ b/library/std/src/sys/thread_local/key/plan9.rs
@@ -0,0 +1,90 @@
+//! Thread-local keys: a table per thread from libc's malloc, found through the
+//! thread's data in its `privalloc` slot (sys/pal/plan9/proc.rs). Keys are never reused;
+//! the thread runs the destructors itself when it ends (`run_dtors`).
+
+use crate::ptr;
+use crate::sync::atomic::Ordering::{Acquire, Relaxed, Release};
+use crate::sync::atomic::{Atomic, AtomicPtr, AtomicUsize};
+use crate::sys::pal::proc::{ThreadData, current};
+
+pub type Key = usize;
+pub type Dtor = unsafe extern "C" fn(*mut u8);
+
+const NKEYS: usize = 1024;
+
+static NEXT: Atomic<usize> = AtomicUsize::new(1);
+static DTORS: [Atomic<*mut ()>; NKEYS] = [const { AtomicPtr::new(ptr::null_mut()) }; NKEYS];
+
+fn table(alloc: bool) -> *mut *mut u8 {
+    let td = current() as *const ThreadData as *mut ThreadData;
+    unsafe {
+        if (*td).keys.is_null() && alloc {
+            let t = libc::mallocz((NKEYS * size_of::<*mut u8>()) as libc::ulong, 1);
+            if t.is_null() {
+                rtabort!("plan9: out of memory for thread-local storage");
+            }
+            (*td).keys = t.cast();
+        }
+        (*td).keys
+    }
+}
+
+#[inline]
+pub fn create(dtor: Option<Dtor>) -> Key {
+    let key = NEXT.fetch_add(1, Relaxed);
+    if key >= NKEYS {
+        rtabort!("out of TLS keys");
+    }
+    if let Some(dtor) = dtor {
+        // SAFETY: in bounds, checked above
+        unsafe { DTORS.get_unchecked(key) }.store(dtor as *mut (), Release);
+    }
+    key
+}
+
+#[inline]
+pub unsafe fn set(key: Key, value: *mut u8) {
+    if key == 0 || key >= NKEYS {
+        rtabort!("bad TLS key");
+    }
+    unsafe { *table(true).add(key) = value };
+}
+
+#[inline]
+pub unsafe fn get(key: Key) -> *mut u8 {
+    if key == 0 || key >= NKEYS {
+        rtabort!("bad TLS key");
+    }
+    let t = table(false);
+    if t.is_null() { ptr::null_mut() } else { unsafe { *t.add(key) } }
+}
+
+#[inline]
+pub unsafe fn destroy(_key: Key) {}
+
+/// The thread ends: the destructors of its values, in rounds while they set new ones.
+pub unsafe fn run_dtors() {
+    let t = table(false);
+    if t.is_null() {
+        return;
+    }
+    for _ in 0..5 {
+        let mut any = false;
+        let n = NEXT.load(Relaxed).min(NKEYS);
+        for key in 1..n {
+            unsafe {
+                let v = *t.add(key);
+                let d = DTORS.get_unchecked(key).load(Acquire);
+                if !v.is_null() && !d.is_null() {
+                    *t.add(key) = ptr::null_mut();
+                    let d: Dtor = crate::mem::transmute(d);
+                    d(v);
+                    any = true;
+                }
+            }
+        }
+        if !any {
+            break;
+        }
+    }
+}
