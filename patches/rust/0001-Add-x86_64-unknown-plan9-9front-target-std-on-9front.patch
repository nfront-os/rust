+++ b/library/std/src/sys/pal/plan9/mod.rs
@@ -0,0 +1,140 @@
+//! System bindings for 9front (Plan 9): its own C library (`libc`'s `plan9` module),
+//! not APE.
+
+#![deny(unsafe_op_in_unsafe_fn)]
+#![allow(missing_docs, nonstandard_style)]
+
+pub mod proc;
+
+use crate::ffi::{CStr, c_char, c_void};
+use crate::io;
+
+pub fn unsupported<T>() -> io::Result<T> {
+    Err(unsupported_err())
+}
+
+pub fn unsupported_err() -> io::Error {
+    io::Error::UNSUPPORTED_PLATFORM
+}
+
+/// Notes the program goes on after, as POSIX programs ignore SIGPIPE: a write on a
+/// closed pipe gives an error.
+unsafe extern "C" fn notehandler(_ureg: *mut c_void, note: *mut c_char) -> i32 {
+    let note = unsafe { CStr::from_ptr(note) }.to_bytes();
+    if note.starts_with(b"sys: write on closed pipe") { 1 } else { 0 }
+}
+
+// SAFETY: must be called only once during runtime initialization.
+// NOTE: this is not guaranteed to run, for example when Rust code is called externally.
+pub unsafe fn init(argc: isize, argv: *const *const u8, sigpipe: u8) {
+    proc::keep_mainstack();
+    unsafe {
+        crate::sys::args::init(argc, argv);
+        // sigpipe: DEFAULT (0) ignores it, as on unix; INHERIT (1) and SIG_DFL (3) keep
+        // Plan 9's default (the note kills the program)
+        if sigpipe == 0 || sigpipe == 2 {
+            libc::atnotify(Some(notehandler), 1);
+        }
+    }
+    let _ = proc::current();
+}
+
+// SAFETY: must be called only once during runtime cleanup.
+// NOTE: this is not guaranteed to run, for example when the program aborts.
+pub unsafe fn cleanup() {}
+
+pub fn abort_internal() -> ! {
+    proc::end_program(c"abort")
+}
+
+/// The calling proc's error string.
+pub fn errstr() -> Vec<u8> {
+    let mut buf = [0u8; libc::ERRMAX];
+    unsafe { libc::rerrstr(buf.as_mut_ptr().cast(), buf.len() as libc::uint) };
+    let n = buf.iter().position(|&c| c == 0).unwrap_or(buf.len());
+    buf[..n].to_vec()
+}
+
+/// The kind of a Plan 9 error string, from the kernel's (port/error.h) and the file
+/// servers' messages.
+pub fn error_kind(s: &[u8]) -> io::ErrorKind {
+    use io::ErrorKind::*;
+    let has = |p: &str| s.windows(p.len()).any(|w| w.eq_ignore_ascii_case(p.as_bytes()));
+    if has("interrupted") {
+        Interrupted
+    } else if has("does not exist") || has("not found") || has("no such") {
+        NotFound
+    } else if has("permission denied") || has("access denied") {
+        PermissionDenied
+    } else if has("already exists") || has("file exists") {
+        AlreadyExists
+    } else if has("not a directory") {
+        NotADirectory
+    } else if has("is a directory") {
+        IsADirectory
+    } else if has("not empty") {
+        DirectoryNotEmpty
+    } else if has("connection refused") {
+        ConnectionRefused
+    } else if has("connection reset") {
+        ConnectionReset
+    } else if has("timed out") {
+        TimedOut
+    } else if has("closed pipe") || has("hungup") || has("hangup") {
+        BrokenPipe
+    } else if has("address in use") || has("port not available") || has("connection in use") {
+        AddrInUse
+    } else if has("unreachable") {
+        HostUnreachable
+    } else if has("file system full") || has("disk full") || has("no space") {
+        StorageFull
+    } else if has("read only") || has("read-only") {
+        ReadOnlyFilesystem
+    } else if has("name too long") {
+        InvalidFilename
+    } else if has("in use") {
+        ResourceBusy
+    } else if has("bad arg") || has("bad character") || has("file name syntax") {
+        InvalidInput
+    } else if has("not implemented") || has("not supported") {
+        Unsupported
+    } else if has("allocate failed") || has("out of memory") {
+        OutOfMemory
+    } else {
+        Uncategorized
+    }
+}
+
+/// The error of the system call that just failed: Plan 9's errors are strings.
+pub fn last_error() -> io::Error {
+    let s = errstr();
+    let kind = error_kind(&s);
+    io::Error::new(kind, String::from_utf8_lossy(&s).into_owned())
+}
+
+/// `r < 0`: the error.
+pub fn cvt<T: PartialOrd + Default>(r: T) -> io::Result<T> {
+    if r < T::default() { Err(last_error()) } else { Ok(r) }
+}
+
+/// [`cvt`], again when a note interrupted the call.
+#[allow(dead_code)]
+pub fn cvt_r<T: PartialOrd + Default, F: FnMut() -> T>(mut f: F) -> io::Result<T> {
+    loop {
+        match cvt(f()) {
+            Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+            other => return other,
+        }
+    }
+}
+
+/// The program ends with `code`: the status is empty for 0, else the number
+/// (`process::ExitStatus` reads it back).
+pub fn exit(code: i32) -> ! {
+    let mut buf = [0u8; 16];
+    if code != 0 {
+        let mut w = io::Cursor::new(&mut buf[..15]);
+        let _ = io::Write::write_fmt(&mut w, format_args!("{code}"));
+    }
+    proc::end_program(CStr::from_bytes_until_nul(&buf).unwrap_or(c"exit"))
+}
diff --git a/library/std/src/sys/pal/plan9/proc.rs b/library/std/src/sys/pal/plan9/proc.rs
new file mode 100644
index 00000000000..f010d351e87
--- /dev/null
+++ b/library/std/src/sys/pal/plan9/proc.rs
@@ -0,0 +1,629 @@
+//! Threads as procs.
+//!
+//! A Rust thread is a proc, `rfork(RFPROC|RFMEM|RFNOWAIT)`: it shares data, bss and heap
+//! with the others, and has its own copy of the stack segment, as libthread's procs. Rust
+//! hands references to locals to other threads (scoped threads, channels), so every
+//! thread runs on a stack from malloc, shared memory, `main` too: libgcc's `__wrap_main`
+//! (9front's gcc port) calls `__plan9_mainstack`, defined here, which runs `main` on such
+//! a stack and ends the program with its result.
+//!
+//! On the proc's own stack segment are libc's `_privates` (`privalloc`): one slot holds
+//! the thread's [`ThreadData`], from libc's malloc (shared memory: other threads wake it
+//! through its semaphore). A new proc returns from `rfork` onto its parent's stack, so it
+//! must not touch it: [`rfork_thread`] makes the system call itself and moves the child,
+//! before anything else, onto its own segment, below where `main`'s proc stopped using it
+//! ([`PRIVTOP`]). The thread finishes there too, off its stack from malloc, so whoever frees
+//! that stack frees one nobody runs on.
+//!
+//! A stack has an unmapped gap below it, so that an overflow faults: the kernel says
+//! `suicide: sys: trap: fault ...` and leaves the proc Broken, as any program that
+//! crashes, instead of the proc going on over its neighbour's memory. Plan 9 has no
+//! mprotect: each stack is a segment of its own (`segattach`, class "memory", which
+//! procs that share memory share), on addresses with gaps between them. A segment a proc
+//! attaches later is its own, the others do not see it: the proc that runs `main`
+//! attaches [`NSLOT`] of them before the first thread, at fixed places. A thread beyond
+//! them, or one asking for more than [`SLOT`], gets a stack from malloc, without the gap.
+//!
+//! Waiting is on 9front's semaphores (`semacquire`, `tsemacquire`): [`futex_wait`] and
+//! [`futex_wake`] give std the futex it builds its locks on, a waiter per thread queued on
+//! a hash of the address.
+
+use crate::ffi::c_void;
+use crate::ptr;
+use crate::sync::atomic::Ordering::{Acquire, Relaxed, Release, SeqCst};
+use crate::sync::atomic::{Atomic, AtomicBool, AtomicI32, AtomicPtr, AtomicU32, AtomicUsize};
+use crate::time::Duration;
+
+/// Per thread, from libc's malloc.
+pub struct ThreadData {
+    /// the kernel's semaphore this thread waits on
+    pub sem: AtomicI32,
+    pub pid: i32,
+    /// futex queue: the address waited on, the next waiter of the bucket
+    addr: usize,
+    next: *mut ThreadData,
+    /// all threads, for exit
+    all_next: *mut ThreadData,
+    /// thread-local keys (thread_local/key/plan9.rs)
+    pub keys: *mut *mut u8,
+}
+
+/// The stack segment below this is free in every proc: `main`'s proc left it for a
+/// stack from malloc (or the creator of the first thread for its own frame).
+static PRIVTOP: AtomicUsize = AtomicUsize::new(0);
+/// The `privalloc` slot of [`ThreadData`].
+static PRIV_SLOT: AtomicPtr<*mut c_void> = AtomicPtr::new(ptr::null_mut());
+static ALL: AtomicPtr<ThreadData> = AtomicPtr::new(ptr::null_mut());
+static ALL_LOCK: SpinLock = SpinLock::new();
+
+/// A lock for a few instructions; a proc that does not get it gives up the processor.
+pub struct SpinLock(AtomicBool);
+
+impl SpinLock {
+    pub const fn new() -> SpinLock {
+        SpinLock(AtomicBool::new(false))
+    }
+
+    pub fn lock(&self) {
+        let mut n = 0u32;
+        while self.0.swap(true, Acquire) {
+            n += 1;
+            if n < 100 {
+                crate::hint::spin_loop();
+            } else {
+                unsafe { libc::sleep(0) };
+            }
+        }
+    }
+
+    pub fn unlock(&self) {
+        self.0.store(false, Release);
+    }
+}
+
+fn slot() -> *mut *mut c_void {
+    let s = PRIV_SLOT.load(Acquire);
+    if !s.is_null() {
+        return s;
+    }
+    ALL_LOCK.lock();
+    let mut s = PRIV_SLOT.load(Acquire);
+    if s.is_null() {
+        s = unsafe { libc::privalloc() };
+        if s.is_null() {
+            rtabort!("plan9: no privalloc slot left");
+        }
+        PRIV_SLOT.store(s, Release);
+    }
+    ALL_LOCK.unlock();
+    s
+}
+
+/// The calling thread's data; made on first use (the proc that runs `main`, or a proc
+/// that is not a Rust thread).
+pub fn current() -> &'static ThreadData {
+    unsafe {
+        let s = slot();
+        let td = *s as *mut ThreadData;
+        if !td.is_null() {
+            return &*td;
+        }
+        let td = new_thread_data();
+        *s = td.cast();
+        &*td
+    }
+}
+
+unsafe fn new_thread_data() -> *mut ThreadData {
+    unsafe {
+        let td = libc::mallocz(size_of::<ThreadData>() as libc::ulong, 1) as *mut ThreadData;
+        if td.is_null() {
+            rtabort!("plan9: out of memory for a thread");
+        }
+        ptr::write(
+            td,
+            ThreadData {
+                sem: AtomicI32::new(0),
+                pid: libc::getpid(),
+                addr: 0,
+                next: ptr::null_mut(),
+                all_next: ptr::null_mut(),
+                keys: ptr::null_mut(),
+            },
+        );
+        ALL_LOCK.lock();
+        (*td).all_next = ALL.load(Relaxed);
+        ALL.store(td, Relaxed);
+        ALL_LOCK.unlock();
+        td
+    }
+}
+
+/// Off the list of threads and freed: the calling thread is done with it.
+unsafe fn free_thread_data(td: *mut ThreadData) {
+    unsafe {
+        ALL_LOCK.lock();
+        let mut l: *mut *mut ThreadData = ALL.as_ptr();
+        while !(*l).is_null() {
+            if *l == td {
+                *l = (*td).all_next;
+                break;
+            }
+            l = &raw mut (**l).all_next;
+        }
+        ALL_LOCK.unlock();
+        if !(*td).keys.is_null() {
+            libc::free((*td).keys.cast());
+        }
+        libc::free(td.cast());
+        *slot() = ptr::null_mut();
+    }
+}
+
+/// The proc that runs `main`.
+static MAIN_PID: AtomicI32 = AtomicI32::new(0);
+
+/// proc(3)'s ctl "kill": a note could be caught.
+fn kill_proc(pid: i32) {
+    let mut path = [0u8; 32];
+    let mut w = crate::io::Cursor::new(&mut path[..]);
+    let _ = crate::io::Write::write_fmt(&mut w, format_args!("/proc/{pid}/ctl\0"));
+    unsafe {
+        let fd = libc::open(path.as_ptr().cast(), libc::OWRITE);
+        if fd >= 0 {
+            libc::write(fd, c"kill".as_ptr().cast(), 4);
+            libc::close(fd);
+        }
+    }
+}
+
+/// The program ends with `status` (exits(2)): the other threads go; from a thread, the
+/// proc that runs `main` ends with a note of the status, so that its parent sees that.
+pub fn end_program(status: &crate::ffi::CStr) -> ! {
+    let me = unsafe { libc::getpid() };
+    let main = MAIN_PID.load(Relaxed);
+    ALL_LOCK.lock();
+    let mut td = ALL.load(Relaxed);
+    while !td.is_null() {
+        unsafe {
+            if (*td).pid != me && (*td).pid != main {
+                kill_proc((*td).pid);
+            }
+            td = (*td).all_next;
+        }
+    }
+    ALL_LOCK.unlock();
+    unsafe {
+        let msg = if status.is_empty() { ptr::null() } else { status.as_ptr() };
+        if main == 0 || main == me {
+            libc::exits(msg)
+        }
+        libc::postnote(libc::PNPROC, main, status.as_ptr());
+        libc::_exits(msg)
+    }
+}
+
+/* stack switching and rfork */
+
+unsafe extern "C" {
+    /// Runs `f(arg)` on the stack below `top`, back on the caller's after.
+    fn __rust_plan9_runon(top: *mut u8, f: unsafe extern "C" fn(*mut c_void), arg: *mut c_void);
+    /// `rfork(flags)`; the child goes on at `__rust_plan9_threadstart(arg)` on the stack
+    /// below `privtop`, without touching its parent's.
+    fn __rust_plan9_rforkthread(flags: i32, privtop: usize, arg: *mut c_void) -> i32;
+}
+
+// amd64: the system call number in BP, the argument at 8(SP) (libc's system call stubs);
+// the kernel gives the child R14 and R15 of its parent (pc64/l.s forkret), the rest zero.
+#[cfg(target_arch = "x86_64")]
+crate::arch::global_asm!(
+    ".text",
+    ".globl __rust_plan9_runon",
+    "__rust_plan9_runon:",
+    "   pushq %rbp",
+    "   movq %rsp, %rbp",
+    "   movq %rdi, %rsp",
+    "   movq %rdx, %rdi",
+    "   call *%rsi",
+    "   movq %rbp, %rsp",
+    "   popq %rbp",
+    "   ret",
+    ".globl __rust_plan9_rforkthread",
+    "__rust_plan9_rforkthread:",
+    "   pushq %rbx",
+    "   pushq %rbp",
+    "   pushq %r12",
+    "   pushq %r13",
+    "   pushq %r14",
+    "   pushq %r15",
+    "   movq %rsi, %r14",
+    "   movq %rdx, %r15",
+    "   subq $16, %rsp",
+    "   movq %rdi, 8(%rsp)",
+    "   movq $19, %rbp", // RFORK
+    "   syscall",
+    "   testq %rax, %rax",
+    "   jz 1f",
+    "   addq $16, %rsp",
+    "   popq %r15",
+    "   popq %r14",
+    "   popq %r13",
+    "   popq %r12",
+    "   popq %rbp",
+    "   popq %rbx",
+    "   ret",
+    "1: movq %r14, %rsp",
+    "   movq %r15, %rdi",
+    "   call __rust_plan9_threadstart",
+    "2: jmp 2b",
+    options(att_syntax)
+);
+
+fn align_down(p: usize) -> usize {
+    p & !15
+}
+
+fn set_privtop_here() {
+    let here = 0u8;
+    let top = align_down((&raw const here).addr() - 65536);
+    let _ = PRIVTOP.compare_exchange(0, top, SeqCst, SeqCst);
+}
+
+/* stacks */
+
+/// Stacks with a gap below, attached by `main`'s proc.
+pub const NSLOT: usize = 64;
+/// Address space of one; its pages are made as they are touched.
+pub const SLOT: usize = 64 << 20;
+const GAP: usize = 1 << 20;
+const NOSLOT: usize = usize::MAX;
+
+/// Above the slots: slot i is [top - (i+1)*(SLOT+GAP), +SLOT)
+static SLOT_TOP: AtomicUsize = AtomicUsize::new(0);
+static NSLOTS: AtomicUsize = AtomicUsize::new(0);
+static SLOT_USED: [AtomicBool; NSLOT] = [const { AtomicBool::new(false) }; NSLOT];
+
+fn slot_va(i: usize) -> usize {
+    SLOT_TOP.load(Relaxed) - (i + 1) * (SLOT + GAP)
+}
+
+/// Only before the first thread: the others would not have them.
+fn attach_slots() {
+    let here = 0u8;
+    // a GiB below the stack segment, out of the way of the kernel's choice for
+    // segattach(…, 0, …), which goes down from there
+    let top = ((&raw const here).addr() & !((1usize << 30) - 1)) - (1usize << 30);
+    SLOT_TOP.store(top, Relaxed);
+    let mut n = 0;
+    while n < NSLOT {
+        let va = slot_va(n);
+        let r = unsafe {
+            libc::segattach(
+                libc::SG_CEXEC,
+                c"memory".as_ptr(),
+                ptr::with_exposed_provenance_mut(va),
+                SLOT as libc::ulong,
+            )
+        };
+        if r.addr() != va {
+            break;
+        }
+        n += 1;
+    }
+    NSLOTS.store(n, Release);
+}
+
+/// A stack of at least `size` bytes: (its slot or NOSLOT, the lowest address).
+fn alloc_stack(size: usize) -> Option<(usize, *mut u8)> {
+    if size <= SLOT {
+        for i in 0..NSLOTS.load(Acquire) {
+            if SLOT_USED[i].compare_exchange(false, true, Acquire, Relaxed).is_ok() {
+                return Some((i, ptr::with_exposed_provenance_mut(slot_va(i))));
+            }
+        }
+    }
+    let n = libc::ulong::try_from(size).ok()?;
+    let p = unsafe { libc::malloc(n) } as *mut u8;
+    if p.is_null() { None } else { Some((NOSLOT, p)) }
+}
+
+unsafe fn free_stack(slot: usize, stack: *mut u8) {
+    unsafe {
+        if slot == NOSLOT {
+            libc::free(stack.cast());
+        } else {
+            // its pages go back; touched again, they are zero
+            libc::segfree(stack.cast(), SLOT as libc::ulong);
+            SLOT_USED[slot].store(false, Release);
+        }
+    }
+}
+
+fn stack_top(slot: usize, stack: *mut u8, size: usize) -> *mut u8 {
+    let size = if slot == NOSLOT { size } else { SLOT };
+    ptr::with_exposed_provenance_mut(align_down(stack.addr() + size))
+}
+
+/// What a new thread runs, and its state for `join`.
+pub struct Packet {
+    pub slot: usize,
+    pub stack: *mut u8,
+    pub stack_size: usize,
+    pub main: unsafe fn(*mut c_void),
+    pub arg: *mut c_void,
+    /// RUNNING, EXITED (`join` frees it) or DETACHED (the thread frees it)
+    pub state: Atomic<u32>,
+}
+
+pub const RUNNING: u32 = 0;
+pub const EXITED: u32 = 1;
+pub const DETACHED: u32 = 2;
+
+unsafe fn free_packet(p: *mut Packet) {
+    unsafe {
+        free_stack((*p).slot, (*p).stack);
+        libc::free(p.cast());
+    }
+}
+
+/// A new thread running `main(arg)`, on a stack of `stack_size` bytes from malloc.
+pub fn spawn(stack_size: usize, main: unsafe fn(*mut c_void), arg: *mut c_void) -> *mut Packet {
+    set_privtop_here();
+    // the creator's data first, then the child's copy of the slot is overwritten
+    let _ = current();
+    let stack_size = (stack_size + 15) & !15;
+    let Ok(size) = libc::ulong::try_from(stack_size) else { return ptr::null_mut() };
+    unsafe {
+        let p = libc::mallocz(size_of::<Packet>() as libc::ulong, 1) as *mut Packet;
+        if p.is_null() {
+            return p;
+        }
+        let _ = size;
+        let Some((slot, stack)) = alloc_stack(stack_size) else {
+            libc::free(p.cast());
+            return ptr::null_mut();
+        };
+        ptr::write(
+            p,
+            Packet { slot, stack, stack_size, main, arg, state: AtomicU32::new(RUNNING) },
+        );
+        let pid = __rust_plan9_rforkthread(
+            libc::RFPROC | libc::RFMEM | libc::RFNOWAIT,
+            PRIVTOP.load(SeqCst),
+            p.cast(),
+        );
+        if pid < 0 {
+            free_packet(p);
+            return ptr::null_mut();
+        }
+        p
+    }
+}
+
+unsafe extern "C" fn run_packet(v: *mut c_void) {
+    unsafe {
+        let p = v as *mut Packet;
+        ((*p).main)((*p).arg);
+    }
+}
+
+/// The new proc, on its own copy of the stack segment.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn __rust_plan9_threadstart(v: *mut c_void) -> ! {
+    unsafe {
+        let p = v as *mut Packet;
+        // the parent's data in the copied slot: not ours
+        *slot() = ptr::null_mut();
+        let td = current() as *const ThreadData as *mut ThreadData;
+        let top = stack_top((*p).slot, (*p).stack, (*p).stack_size);
+        __rust_plan9_runon(top, run_packet, v);
+        // off the stack from malloc: it can go
+        free_thread_data(td);
+        match (*p).state.compare_exchange(RUNNING, EXITED, SeqCst, SeqCst) {
+            Ok(_) => {
+                futex_wake_all(&(*p).state);
+            }
+            Err(_) => free_packet(p),
+        }
+        libc::_exits(ptr::null());
+    }
+}
+
+/// `join`: waits for the thread, frees its stack.
+pub unsafe fn join(p: *mut Packet) {
+    unsafe {
+        while (*p).state.load(Acquire) == RUNNING {
+            futex_wait(&(*p).state, RUNNING, None);
+        }
+        free_packet(p);
+    }
+}
+
+/// The thread's handle is dropped: it frees itself when done.
+pub unsafe fn detach(p: *mut Packet) {
+    unsafe {
+        if (*p).state.compare_exchange(RUNNING, DETACHED, SeqCst, SeqCst).is_err() {
+            free_packet(p);
+        }
+    }
+}
+
+const MAIN_STACK: usize = 8 << 20;
+
+struct MainArgs {
+    main: unsafe extern "C" fn(i32, *mut *mut u8, *mut *mut u8) -> i32,
+    argc: i32,
+    argv: *mut *mut u8,
+    envp: *mut *mut u8,
+    ret: i32,
+}
+
+unsafe extern "C" fn run_main(v: *mut c_void) {
+    unsafe {
+        let a = v as *mut MainArgs;
+        (*a).ret = ((*a).main)((*a).argc, (*a).argv, (*a).envp);
+    }
+}
+
+/// libgcc's `__wrap_main` (9front's gcc port): `main` on a stack from malloc, as the other
+/// threads; the program ends with its result.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __plan9_mainstack(
+    main: unsafe extern "C" fn(i32, *mut *mut u8, *mut *mut u8) -> i32,
+    argc: i32,
+    argv: *mut *mut u8,
+    envp: *mut *mut u8,
+) -> i32 {
+    // below this frame (and runon's) the segment is not used again
+    set_privtop_here();
+    MAIN_PID.store(unsafe { libc::getpid() }, Relaxed);
+    attach_slots();
+    let mut a = MainArgs { main, argc, argv, envp, ret: 0 };
+    unsafe {
+        match alloc_stack(MAIN_STACK) {
+            None => run_main((&raw mut a).cast()),
+            Some((slot, stack)) => {
+                let top = stack_top(slot, stack, MAIN_STACK);
+                __rust_plan9_runon(top, run_main, (&raw mut a).cast());
+            }
+        }
+    }
+    crate::sys::exit::exit(a.ret)
+}
+
+/// Keeps `__plan9_mainstack` in the link: libgcc refers to it only weakly.
+pub fn keep_mainstack() {
+    crate::hint::black_box((__plan9_mainstack as *const ()).expose_provenance());
+}
+
+/* futex */
+
+const NBUCKET: usize = 64;
+
+struct Bucket {
+    lock: SpinLock,
+    head: AtomicPtr<ThreadData>,
+}
+
+static BUCKETS: [Bucket; NBUCKET] =
+    [const { Bucket { lock: SpinLock::new(), head: AtomicPtr::new(ptr::null_mut()) } }; NBUCKET];
+
+fn bucket(addr: usize) -> &'static Bucket {
+    &BUCKETS[(addr >> 2).wrapping_mul(0x9e3779b9) % NBUCKET]
+}
+
+/// Off the bucket's queue; whether it was there.
+unsafe fn unqueue(b: &Bucket, td: *mut ThreadData) -> bool {
+    unsafe {
+        let mut l: *mut *mut ThreadData = b.head.as_ptr();
+        while !(*l).is_null() {
+            if *l == td {
+                *l = (*td).next;
+                (*td).next = ptr::null_mut();
+                return true;
+            }
+            l = &raw mut (**l).next;
+        }
+        false
+    }
+}
+
+fn now_ms() -> u64 {
+    (unsafe { libc::uptime() } / 1_000_000) as u64
+}
+
+/// Waits while `*futex == expected`, at most `timeout`; false: timed out.
+pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    let td = current() as *const ThreadData as *mut ThreadData;
+    let addr = futex.as_ptr().addr();
+    let b = bucket(addr);
+    let deadline = timeout.map(|t| {
+        // round up: a wait never ends early
+        let ms = t.as_nanos().div_ceil(1_000_000);
+        now_ms().saturating_add(u64::try_from(ms).unwrap_or(u64::MAX))
+    });
+    unsafe {
+        b.lock.lock();
+        if futex.load(Relaxed) != expected {
+            b.lock.unlock();
+            return true;
+        }
+        (*td).addr = addr;
+        (*td).next = b.head.load(Relaxed);
+        b.head.store(td, Relaxed);
+        b.lock.unlock();
+        let sem = (*td).sem.as_ptr();
+        loop {
+            let r = match deadline {
+                None => libc::semacquire(sem, 1),
+                Some(d) => {
+                    let now = now_ms();
+                    if now >= d {
+                        0
+                    } else {
+                        let ms = (d - now).min(u32::MAX as u64) as libc::ulong;
+                        libc::tsemacquire(sem, ms)
+                    }
+                }
+            };
+            if r > 0 {
+                return true;
+            }
+            if r < 0 && deadline.is_none() {
+                // a note interrupted it; a spurious wakeup is allowed
+                b.lock.lock();
+                let queued = unqueue(b, td);
+                b.lock.unlock();
+                if !queued {
+                    // woken meanwhile: the release is ours
+                    while libc::semacquire(sem, 1) < 0 {}
+                }
+                return true;
+            }
+            if r == 0 || (r < 0 && deadline.is_some_and(|d| now_ms() >= d)) {
+                b.lock.lock();
+                let queued = unqueue(b, td);
+                b.lock.unlock();
+                if queued {
+                    return false;
+                }
+                while libc::semacquire(sem, 1) < 0 {}
+                return true;
+            }
+        }
+    }
+}
+
+fn wake(futex: &Atomic<u32>, mut n: usize) -> bool {
+    let addr = futex.as_ptr().addr();
+    let b = bucket(addr);
+    let mut woke = false;
+    b.lock.lock();
+    unsafe {
+        let mut l: *mut *mut ThreadData = b.head.as_ptr();
+        while n > 0 && !(*l).is_null() {
+            let td = *l;
+            if (*td).addr == addr {
+                *l = (*td).next;
+                (*td).next = ptr::null_mut();
+                // its data stays: it waits until released
+                libc::semrelease((*td).sem.as_ptr(), 1);
+                woke = true;
+                n -= 1;
+            } else {
+                l = &raw mut (*td).next;
+            }
+        }
+    }
+    b.lock.unlock();
+    woke
+}
+
+/// Wakes one waiter; whether there was one.
+pub fn futex_wake(futex: &Atomic<u32>) -> bool {
+    wake(futex, 1)
+}
+
+pub fn futex_wake_all(futex: &Atomic<u32>) {
+    wake(futex, usize::MAX);
+}
