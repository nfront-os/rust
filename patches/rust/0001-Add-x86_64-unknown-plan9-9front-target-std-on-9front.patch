+//! cons(3)'s `/dev/random`: the kernel's generator, never blocks once seeded.
+
+pub fn fill_bytes(mut bytes: &mut [u8]) {
+    let fd = unsafe { libc::open(c"/dev/random".as_ptr(), libc::OREAD | libc::OCEXEC) };
+    if fd < 0 {
+        rtabort!("plan9: cannot open /dev/random");
+    }
+    while !bytes.is_empty() {
+        let n = bytes.len().min(libc::IOUNIT);
+        let r = unsafe { libc::read(fd, bytes.as_mut_ptr().cast(), n as libc::c_long) };
+        if r <= 0 {
+            rtabort!("plan9: cannot read /dev/random");
+        }
+        bytes = &mut bytes[r as usize..];
+    }
+    unsafe { libc::close(fd) };
+}
