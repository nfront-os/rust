+//! File descriptors 0, 1 and 2.
+
+use crate::io;
+use crate::sys::pal::cvt;
+
+pub struct Stdin;
+pub struct Stdout;
+pub struct Stderr;
+
+fn read(fd: i32, buf: &mut [u8]) -> io::Result<usize> {
+    let n = buf.len().min(i32::MAX as usize);
+    cvt(unsafe { libc::read(fd, buf.as_mut_ptr().cast(), n as libc::c_long) }).map(|n| n as usize)
+}
+
+fn write(fd: i32, buf: &[u8]) -> io::Result<usize> {
+    let n = buf.len().min(i32::MAX as usize);
+    cvt(unsafe { libc::write(fd, buf.as_ptr().cast(), n as libc::c_long) }).map(|n| n as usize)
+}
+
+impl Stdin {
+    pub const fn new() -> Stdin {
+        Stdin
+    }
+}
+
+impl io::Read for Stdin {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        read(0, buf)
+    }
+}
+
+impl Stdout {
+    pub const fn new() -> Stdout {
+        Stdout
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write(1, buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Stderr {
+    pub const fn new() -> Stderr {
+        Stderr
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        write(2, buf)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+pub const STDIN_BUF_SIZE: usize = crate::sys::io::DEFAULT_BUF_SIZE;
+
+/// A closed descriptor ("fd out of range or not open"): the standard streams are quietly
+/// nothing, as on unix.
+pub fn is_ebadf(err: &io::Error) -> bool {
+    let s = err.to_string();
+    s.contains("fd out of range") || s.contains("not open")
+}
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(Stderr::new())
+}
