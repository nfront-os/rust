@@ -0,0 +1,41 @@
+//! libc's malloc (pool(2)): its sizes are `ulong`, 32 bits; blocks are aligned to 8
+//! bytes, more through `mallocalign`. `free` takes both.
+
+use crate::alloc::Layout;
+use crate::ptr;
+
+const ALIGN: usize = 8;
+
+fn size(layout: &Layout) -> Option<libc::ulong> {
+    libc::ulong::try_from(layout.size()).ok()
+}
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    let Some(n) = size(&layout) else { return ptr::null_mut() };
+    unsafe {
+        if layout.align() <= ALIGN {
+            libc::malloc(n) as *mut u8
+        } else {
+            let Ok(align) = libc::ulong::try_from(layout.align()) else { return ptr::null_mut() };
+            libc::mallocalign(n, align, 0, 0) as *mut u8
+        }
+    }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, _layout: Layout) {
+    unsafe { libc::free(ptr.cast()) }
+}
+
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+    unsafe {
+        if layout.align() <= ALIGN {
+            let Ok(n) = libc::ulong::try_from(new_size) else { return ptr::null_mut() };
+            libc::realloc(ptr.cast(), n) as *mut u8
+        } else {
+            super::realloc_fallback(ptr, layout, new_size)
+        }
+    }
+}
