--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/plan9.rs
@@ -0,0 +1,42 @@
+//! 9front (Plan 9): native Plan 9 programs, linked by the gcc of 9front's gcc port
+//! (`x86_64-pc-plan9-gcc`) against the system's own libc (`/$objtype/lib.gcc/libc.a`),
+//! not APE (its POSIX layer).
+//!
+//! The driver's linker script (`/$objtype/plan9.ld`) gives a static ELF executable with
+//! a text and a data segment, which the kernel loads. Without `-nodefaultlibs` the driver
+//! would link APE (`-lap`); it is passed (`no_default_libraries`), and the rest of what it
+//! leaves out comes back here: `--wrap=main` makes libc's `_main` call libgcc's
+//! `__wrap_main`, which sets the FPU up as on POSIX systems (exceptions masked: 9front's
+//! kernel starts a process trapping on division by zero) and runs `.init_array`
+//! (`crtbegin.o` registers the unwind tables there), then the program's `main`.
+
+use crate::spec::{
+    Cc, LinkerFlavor, Lld, Os, PanicStrategy, RelocModel, StackProbeType, TargetOptions,
+};
+
+pub(crate) fn opts() -> TargetOptions {
+    let flavor = LinkerFlavor::Gnu(Cc::Yes, Lld::No);
+    TargetOptions {
+        os: Os::Plan9,
+        executables: true,
+        dynamic_linking: false,
+        only_cdylib: false,
+        relocation_model: RelocModel::Static,
+        position_independent_executables: false,
+        static_position_independent_executables: false,
+        crt_static_default: true,
+        crt_static_respected: false,
+        // libc's `main` is a C function; a thread is a proc (rfork), its
+        // locals are kept by std (no TLS segment in Plan 9's executables)
+        has_thread_local: false,
+        no_default_libraries: true,
+        pre_link_args: TargetOptions::link_args(flavor, &["-Wl,--wrap=main"]),
+        // libgcc: __wrap_main, the unwinder; it needs libc's malloc and friends
+        late_link_args: TargetOptions::link_args(flavor, &["-lgcc", "-lc"]),
+        // no dl_iterate_phdr: the unwinder finds the frames registered by crtbegin.o
+        eh_frame_header: false,
+        panic_strategy: PanicStrategy::Abort,
+        stack_probes: StackProbeType::Inline,
+        ..Default::default()
+    }
+}
