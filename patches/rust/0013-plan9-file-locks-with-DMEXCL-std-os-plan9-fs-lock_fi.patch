 5 files changed, 154 insertions(+), 7 deletions(-)

diff --git a/compiler/rustc_data_structures/src/flock/plan9.rs b/compiler/rustc_data_structures/src/flock/plan9.rs
index 32a64d73945728907f3b8ee715dddb6d0cf75dbc..5fea5098f8cf69a4eea1986e19cde2f7c333cb4a 100644
--- a/compiler/rustc_data_structures/src/flock/plan9.rs
+++ b/compiler/rustc_data_structures/src/flock/plan9.rs
@@ -1,17 +1,30 @@
-//! 9front (Plan 9) has no advisory file locks: the lock is taken without one, as cargo does
-//! on 9front (a file system without locks). cargo never builds one crate twice at once into
-//! the same directory; two rustc on one incremental directory by hand are not kept apart.
+//! 9front (Plan 9) has no advisory file locks: a lock is the file opened alone, as an
+//! exclusive-use (DMEXCL) file (`std::os::plan9::fs::lock_file`); another open of it fails
+//! with "file is locked" (`WouldBlock`). There are no shared locks: a shared lock is
+//! exclusive. On a file server that keeps no DMEXCL (ext4srv), nothing is kept apart.
 use std::fs::File;
 use std::io;
+use std::os::plan9::fs::{FileLock, lock_file};
 use std::path::Path;
 
-#[derive(Debug)]
+use crate::marker::IntoDynSyncSend;
+
 pub struct Lock {
-    _file: File,
+    // Send and Sync (a File and its keep-alive thread), not on the marker module's list
+    _lock: IntoDynSyncSend<FileLock>,
+}
+
+impl std::fmt::Debug for Lock {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self._lock.0.fmt(f)
+    }
 }
 
 impl Lock {
-    pub fn try_lock(_p: &Path, file: File, _exclusive: bool) -> io::Result<Lock> {
-        Ok(Lock { _file: file })
+    pub fn try_lock(p: &Path, file: File, _exclusive: bool) -> io::Result<Lock> {
+        // the open of `file` was made before the file was exclusive-use, or it is the lock:
+        // the lock is lock_file's own open
+        drop(file);
+        Ok(Lock { _lock: IntoDynSyncSend(lock_file(p, false)?) })
     }
 }
