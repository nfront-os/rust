+/// os::plan9::fs::lock_file: `path` opened alone, as an exclusive-use (DMEXCL) file. A
+/// server that keeps no DMEXCL (or a file that cannot get it): the file, as upas' locks.
+pub fn lock_file(path: &Path, wait: bool) -> io::Result<File> {
+    let c = cstr(path)?;
+    let omode = libc::ORDWR | libc::OCEXEC;
+    let mut made = false;
+    loop {
+        let fd = unsafe { libc::open(c.as_ptr(), omode) };
+        let r = if fd >= 0 {
+            Ok(File(unsafe { FileDesc::from_raw_fd(fd) }))
+        } else {
+            let e = last_error();
+            if e.kind() == io::ErrorKind::NotFound {
+                // made exclusive-use; made meanwhile by another: open it
+                let fd = unsafe { libc::create(c.as_ptr(), omode | libc::OEXCL, libc::DMEXCL | 0o666) };
+                if fd >= 0 {
+                    Ok(File(unsafe { FileDesc::from_raw_fd(fd) }))
+                } else {
+                    let e = last_error();
+                    if e.kind() == io::ErrorKind::AlreadyExists {
+                        continue;
+                    }
+                    Err(e)
+                }
+            } else {
+                Err(e)
+            }
+        };
+        match r {
+            Ok(f) => {
+                set_state(f.0.as_raw_fd(), FdState::default());
+                let mode = f.file_attr()?.mode;
+                if mode & libc::DMEXCL != 0 || made {
+                    return Ok(f);
+                }
+                // made before without DMEXCL: it gets it, then the open that counts
+                let fd = f.0.as_raw_fd();
+                if wstat(|d| d.mode = mode | libc::DMEXCL, |d| unsafe { libc::dirfwstat(fd, d) })
+                    .is_err()
+                {
+                    return Ok(f);
+                }
+                made = true;
+            }
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock && wait => {
+                crate::thread::sleep(crate::time::Duration::from_millis(100));
+            }
+            Err(e) => return Err(e),
+        }
+    }
+}
