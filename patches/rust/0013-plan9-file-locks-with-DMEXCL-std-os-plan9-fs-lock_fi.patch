 use crate::sys::{AsInner, AsInnerMut, FromInner};
 
 /// The stat(5) entry of a file.
@@ -179,3 +184,74 @@ impl FileExt for File {
         self.as_inner().write_at(buf, offset)
     }
 }
+
+/// A file lock as Plan 9 has one: `path` opened alone. Its file server lets one open of
+/// an exclusive-use file (`DMEXCL`) at a time; another fails with "file is locked"
+/// ([`io::ErrorKind::WouldBlock`]). `path` is made exclusive-use if it is not (made with it
+/// if it does not exist). `wait`: try again until it is free, else return the error. There
+/// are no shared locks: a reader locks as a writer does. Most of 9front's file servers keep
+/// `DMEXCL` (gefs, cwfs, hjfs, ramfs); on one that does not (ext4srv), nothing is kept apart.
+///
+/// open(5) lets a server break the lock of a file not used for a while (cwfs and hjfs: five
+/// minutes); as upas' locks, a thread of the lock reads the file once a minute. Dropping the
+/// lock ends it and closes the file, which releases the lock.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn lock_file<P: AsRef<Path>>(path: P, wait: bool) -> io::Result<FileLock> {
+    let file = File::from_inner(crate::sys::fs::lock_file(path.as_ref(), wait)?);
+    let keep = Arc::new(Keep { stop: Mutex::new(false), cv: Condvar::new() });
+    let fd = file.as_raw_fd();
+    let k = keep.clone();
+    let thread = thread::Builder::new().name("lock_file".into()).spawn(move || {
+        let mut stop = k.stop.lock().unwrap();
+        while !*stop {
+            let (s, r) = k.cv.wait_timeout(stop, Duration::from_secs(60)).unwrap();
+            stop = s;
+            if !*stop && r.timed_out() {
+                // the lock's fd: closed only after this thread ends (FileLock's drop)
+                let f = mem::ManuallyDrop::new(unsafe { File::from_raw_fd(fd) });
+                let _ = f.read_at(&mut [0u8; 1], 0);
+            }
+        }
+    })?;
+    Ok(FileLock { file, keep, thread: Some(thread) })
+}
+
+struct Keep {
+    stop: Mutex<bool>,
+    cv: Condvar,
+}
+
+/// A lock of [`lock_file`]: the locked file, kept in use.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub struct FileLock {
+    file: File,
+    keep: Arc<Keep>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+
+impl FileLock {
+    /// The locked file, open for reading and writing.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn file(&self) -> &File {
+        &self.file
+    }
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl fmt::Debug for FileLock {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FileLock").field("file", &self.file).finish()
+    }
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl Drop for FileLock {
+    fn drop(&mut self) {
+        *self.keep.stop.lock().unwrap() = true;
+        self.keep.cv.notify_one();
+        if let Some(t) = self.thread.take() {
+            let _ = t.join();
+        }
+        // then the file closes: the lock is free
+    }
+}
