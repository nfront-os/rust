@@ -200,7 +206,27 @@ impl Pump {
     /// The reader; a stream's writer comes with its first write.
     fn start(self: &Arc<Self>) -> io::Result<()> {
         let p = self.clone();
-        spawn("socket reader", move || p.reader())
+        lock(&self.m).reader_running = true;
+        let r = spawn("socket reader", move || p.reader());
