+use crate::os::plan9::io::{AsFd, AsRawFd, BorrowedFd, IntoRawFd, OwnedFd, RawFd};
 use crate::process;
-use crate::sys::AsInner;
+use crate::sys::{AsInner, FromInner, IntoInner};
 
 /// A Plan 9 program ends with a message (exits(2)), not a number.
 #[stable(feature = "rust1", since = "1.0.0")]
@@ -21,3 +22,52 @@ fn msg(&self) -> &[u8] {
         self.as_inner().msg()
     }
 }
+
+// The pipes of a child: their descriptors, as on unix (os/unix/process.rs).
+macro_rules! child_pipe {
+    ($t:ident) => {
+        #[stable(feature = "rust1", since = "1.0.0")]
+        impl AsRawFd for process::$t {
+            #[inline]
+            fn as_raw_fd(&self) -> RawFd {
+                self.as_inner().as_raw_fd()
+            }
+        }
+
+        #[stable(feature = "rust1", since = "1.0.0")]
+        impl IntoRawFd for process::$t {
+            #[inline]
+            fn into_raw_fd(self) -> RawFd {
+                self.into_inner().into_raw_fd()
+            }
+        }
+
+        #[stable(feature = "rust1", since = "1.0.0")]
+        impl AsFd for process::$t {
+            #[inline]
+            fn as_fd(&self) -> BorrowedFd<'_> {
+                self.as_inner().as_fd()
+            }
+        }
+
+        #[stable(feature = "rust1", since = "1.0.0")]
+        impl From<process::$t> for OwnedFd {
+            #[inline]
+            fn from(p: process::$t) -> OwnedFd {
+                p.into_inner().into_inner()
+            }
+        }
+
+        #[stable(feature = "rust1", since = "1.0.0")]
+        impl From<OwnedFd> for process::$t {
+            #[inline]
+            fn from(fd: OwnedFd) -> process::$t {
+                process::$t::from_inner(FromInner::from_inner(fd))
+            }
+        }
+    };
+}
+
+child_pipe!(ChildStdin);
+child_pipe!(ChildStdout);
+child_pipe!(ChildStderr);
