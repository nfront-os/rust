@@ -0,0 +1,159 @@
+//! Plan 9-specific notes (notify(2)): what POSIX programs do with signals.
+//!
+//! A note the program does not catch ends it (Plan 9's default): `interrupt` (the console's
+//! Delete, as SIGINT), `hangup` (as SIGHUP), or any note sent to it. [`catch`] makes the
+//! program go on after a note and counts it; [`Note::wait`] waits for the next. That stays
+//! so for the rest of the program.
+//!
+//! A note to the program's note group (the console's Delete, `postnote(PNGROUP, ...)`)
+//! reaches every proc of it, each of its threads and std's helper procs: it is counted
+//! once, in the proc that runs `main`; the others go on (a blocked system call of theirs
+//! returns "interrupted", std's calls try again). A note to one proc
+//! (`/proc/<pid>/note`) counts when it is sent to that proc.
+//!
+//! [`catch`]: catch
+
+#![stable(feature = "rust1", since = "1.0.0")]
+
+use crate::cell::UnsafeCell;
+use crate::ffi::{CStr, c_char, c_int, c_void};
+use crate::sync::Mutex;
+use crate::sync::atomic::{AtomicBool, AtomicI32, AtomicUsize, Ordering};
+use crate::{fmt, io};
+
+/// Notes caught at most.
+const SLOTS: usize = 16;
+/// A note is at most ERRMAX bytes.
+const NAMELEN: usize = 128;
+
+struct Slot {
+    used: AtomicBool,
+    len: AtomicUsize,
+    /// written once, before `used`
+    name: UnsafeCell<[u8; NAMELEN]>,
+    /// semacquire(2)'s semaphore: the notes not waited for yet
+    sem: AtomicI32,
+}
+
+// SAFETY: `name` is written once, under REGISTER, before `used` is set (Release); read
+// only after `used` is seen (Acquire).
+unsafe impl Sync for Slot {}
+
+impl Slot {
+    const fn new() -> Slot {
+        Slot {
+            used: AtomicBool::new(false),
+            len: AtomicUsize::new(0),
+            name: UnsafeCell::new([0; NAMELEN]),
+            sem: AtomicI32::new(0),
+        }
+    }
+
+    fn name(&self) -> &[u8] {
+        // SAFETY: see `unsafe impl Sync`
+        unsafe { &(&*self.name.get())[..self.len.load(Ordering::Relaxed)] }
+    }
+}
+
+static TABLE: [Slot; SLOTS] = [const { Slot::new() }; SLOTS];
+static REGISTER: Mutex<bool> = Mutex::new(false);
+
+/// The notify handler (atnotify(2), after std's own): no lock, no allocation.
+unsafe extern "C" fn handler(_ureg: *mut c_void, note: *mut c_char) -> c_int {
+    let note = unsafe { CStr::from_ptr(note) }.to_bytes();
+    for s in &TABLE {
+        if !s.used.load(Ordering::Acquire) {
+            break;
+        }
+        if s.name() == note {
+            let main = crate::sys::proc::main_pid();
+            if main == 0 || unsafe { libc::getpid() } == main {
+                unsafe { libc::semrelease(s.sem.as_ptr(), 1) };
+            }
+            return 1;
+        }
+    }
+    0
+}
+
+/// A note the program catches (from [`catch`]).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub struct Note {
+    slot: &'static Slot,
+}
+
+/// Catch the note `name` (exactly): the program goes on after it, and [`Note::wait`] sees
+/// it. Catching a note again gives one more `Note` for the same count. Not the notes of
+/// traps (`sys: ...`) nor std's own (`alarm`, `rust: ...`).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn catch(name: &str) -> io::Result<Note> {
+    let b = name.as_bytes();
+    if b.is_empty()
+        || b.len() >= NAMELEN
+        || b.contains(&0)
+        || b.starts_with(b"sys:")
+        || b.starts_with(b"rust:")
+        || b == b"alarm"
+    {
+        return Err(io::const_error!(io::ErrorKind::InvalidInput, "note cannot be caught"));
+    }
+    let mut installed = REGISTER.lock().unwrap_or_else(|e| e.into_inner());
+    for s in &TABLE {
+        if !s.used.load(Ordering::Acquire) {
+            // SAFETY: not used yet, and REGISTER is held: no one else writes it, the
+            // handler does not read it
+            unsafe { (&mut *s.name.get())[..b.len()].copy_from_slice(b) };
+            s.len.store(b.len(), Ordering::Relaxed);
+            s.used.store(true, Ordering::Release);
+            if !*installed {
+                if unsafe { libc::atnotify(Some(handler), 1) } == 0 {
+                    s.used.store(false, Ordering::Release);
+                    return Err(io::const_error!(io::ErrorKind::Other, "atnotify: no room"));
+                }
+                *installed = true;
+            }
+            return Ok(Note { slot: s });
+        }
+        if s.name() == b {
+            return Ok(Note { slot: s });
+        }
+    }
+    Err(io::const_error!(io::ErrorKind::OutOfMemory, "too many notes caught"))
+}
+
+impl Note {
+    /// The note's name.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn name(&self) -> &str {
+        // SAFETY: made from a str
+        unsafe { crate::str::from_utf8_unchecked(self.slot.name()) }
+    }
+
+    /// Waits for the note: how many came since the last `wait` or `take` (at least one).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn wait(&self) -> usize {
+        // -1: a note interrupted it (this one, in the proc that runs main, or another)
+        while unsafe { libc::semacquire(self.slot.sem.as_ptr(), 1) } < 0 {}
+        1 + self.take()
+    }
+
+    /// How many came since the last `wait` or `take`, without waiting.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn take(&self) -> usize {
+        let mut n = 0;
+        loop {
+            match unsafe { libc::semacquire(self.slot.sem.as_ptr(), 0) } {
+                1 => n += 1,
+                0 => return n,
+                _ => {}
+            }
+        }
+    }
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl fmt::Debug for Note {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Note").field("name", &self.name()).finish()
+    }
+}
