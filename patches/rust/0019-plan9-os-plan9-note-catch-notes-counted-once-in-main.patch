+        }
+        r
+    }
+
+    /// A listener's close: its reader blocked in listen holds the announcement (another
+    /// connect would still be taken); as on unix the port is free when close returns. A
+    /// note only interrupts a call the proc is in: one that comes just before it enters
+    /// listen is lost, hence again every 10 ms (at most 5 s).
+    fn reader_gone(&self) {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut s = lock(&self.m);
+        while s.reader_running && Instant::now() < deadline {
+            s = self.cv.wait_timeout(s, Duration::from_millis(10)).unwrap_or_else(|e| e.into_inner()).0;
+            if s.reader_running {
+                interrupt(s.reader_pid);
+            }
+        }
     }
 
     /// Calls the hook, if any (no lock held).
@@ -275,7 +301,11 @@ fn reader(self: Arc<Self>) {
             }
             self.changed(s);
         }
-        lock(&self.m).reader_pid = 0;
+        let mut s = lock(&self.m);
+        s.reader_pid = 0;
+        s.reader_running = false;
+        drop(s);
+        self.cv.notify_all();
     }
 
