+++ b/library/std/src/sys/net/connection/plan9/pump.rs
@@ -0,0 +1,508 @@
+//! Non-blocking sockets on 9front, which has only blocking I/O: a socket that is set
+//! non-blocking (or peeked at) gets a pump, procs that do the blocking calls into buffers
+//! (as APE's select has its copy procs). A reader proc reads into a buffer (a stream's bytes,
+//! a UDP socket's datagrams, a listener's accepted calls); a stream's writes go into a buffer
+//! that a writer proc writes out. read, peek, recv and accept take from the buffers, write
+//! puts into one; empty or full, a non-blocking socket says WouldBlock, a blocking one waits.
+//!
+//! The pump has a descriptor of its own (a dup), so it outlives the socket's: when the last
+//! descriptor of the socket is closed (sys::fd's forget_state), the reader is interrupted (a
+//! note, mod.rs's INTERRUPT_NOTE: its read returns "interrupted"), the writer writes out what
+//! is buffered, and the pump's descriptor goes with the last of its procs.
+//!
+//! An event loop (mio) learns of readiness through a hook, called (from a pump's proc, with no
+//! lock held) whenever the socket may have become readable or writable, and `readiness`.
+
+use super::{Socket, TcpStream, accept_blocking};
+use crate::collections::{BTreeMap, VecDeque};
+use crate::io;
+use crate::net::SocketAddr;
+use crate::os::plan9::io::{AsRawFd, RawFd};
+use crate::sync::atomic::{AtomicBool, Ordering};
+use crate::sync::{Arc, Condvar, Mutex, MutexGuard};
+use crate::sys::fd::FileDesc;
+use crate::time::{Duration, Instant};
+
+/// A stream's buffers: the reader stops above, a writer takes no more beyond.
+const STREAM_BUF: usize = 64 * 1024;
+const CHUNK: usize = 64 * 1024;
+/// Datagrams and calls held at most.
+const QUEUE: usize = 128;
+const UDP_MAX: usize = 52 + 65536;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(super) enum Kind {
+    Stream,
+    Datagram,
+    Listener,
+}
+
+/// What a socket is ready for (os::plan9::net::readiness).
+#[derive(Clone, Copy, Default, Debug)]
+pub struct Readiness {
+    pub readable: bool,
+    pub writable: bool,
+    pub read_closed: bool,
+    pub write_closed: bool,
+    pub error: bool,
+}
+
+pub type Hook = Arc<dyn Fn() + Send + Sync>;
+
+struct State {
+    nonblocking: bool,
+    /// descriptors of the socket that have the pump
+    handles: usize,
+    closed: bool,
+    // reading
+    data: VecDeque<u8>,
+    dgrams: VecDeque<Vec<u8>>,
+    calls: VecDeque<(Socket, SocketAddr)>,
+    read_eof: bool,
+    read_err: Option<io::Error>,
+    reader_pid: i32,
+    // writing (streams)
+    out: VecDeque<u8>,
+    write_err: Option<io::Error>,
+    writer_pid: i32,
+    /// the writer is made with the first write (a socket that only reads has one proc)
+    writer: bool,
+    // a connect in the background (connect_nonblocking)
+    connecting: bool,
+    connect_err: Option<io::Error>,
+    hook: Option<Hook>,
+}
+
+pub(super) struct Pump {
+    kind: Kind,
+    /// the pump's own descriptor of the conversation (a dup); a listener's: its ctl
+    fd: FileDesc,
+    /// a listener's directory (listen(2))
+    dir: String,
+    m: Mutex<State>,
+    cv: Condvar,
+}
+
+static PUMPS: Mutex<BTreeMap<RawFd, Arc<Pump>>> = Mutex::new(BTreeMap::new());
+static ANY: AtomicBool = AtomicBool::new(false);
+
+fn lock<T>(m: &Mutex<T>) -> MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+pub(super) fn get(fd: RawFd) -> Option<Arc<Pump>> {
+    if !ANY.load(Ordering::Relaxed) {
+        return None;
+    }
+    lock(&PUMPS).get(&fd).cloned()
+}
+
+/// The socket's pump, made if it has none; `connecting`: its conversation is still being
+/// connected (no reader or writer yet).
+pub(super) fn of(sock: &Socket, kind: Kind, dir: String, connecting: bool) -> io::Result<Arc<Pump>> {
+    let fd = sock.as_raw_fd();
+    let mut t = lock(&PUMPS);
+    if let Some(p) = t.get(&fd) {
+        return Ok(p.clone());
+    }
+    let p = Arc::new(Pump {
+        kind,
+        fd: sock.fd.duplicate()?,
+        dir,
+        m: Mutex::new(State {
+            nonblocking: false,
+            handles: 1,
+            closed: false,
+            data: VecDeque::new(),
+            dgrams: VecDeque::new(),
+            calls: VecDeque::new(),
+            read_eof: false,
+            read_err: None,
+            reader_pid: 0,
+            out: VecDeque::new(),
+            write_err: None,
+            writer_pid: 0,
+            writer: false,
+            connecting,
+            connect_err: None,
+            hook: None,
+        }),
+        cv: Condvar::new(),
+    });
+    t.insert(fd, p.clone());
+    ANY.store(true, Ordering::Relaxed);
+    drop(t);
+    if !connecting {
+        p.start()?;
+    }
+    Ok(p)
+}
+
+/// A new descriptor of a pumped socket (try_clone) shares its pump.
+pub(super) fn duplicated(old: RawFd, new: RawFd) {
+    if let Some(p) = get(old) {
+        lock(&p.m).handles += 1;
+        lock(&PUMPS).insert(new, p);
+    }
+}
+
+/// A descriptor is closed (sys::fd::forget_state): the last one closes the pump.
+pub(crate) fn forget(fd: RawFd) {
+    if !ANY.load(Ordering::Relaxed) {
+        return;
+    }
+    let Some(p) = lock(&PUMPS).remove(&fd) else { return };
+    let mut s = lock(&p.m);
+    s.handles -= 1;
+    if s.handles == 0 {
+        s.closed = true;
+        let reader = s.reader_pid;
+        drop(s);
+        p.cv.notify_all();
+        interrupt(reader);
+    }
+}
+
+fn interrupt(pid: i32) {
+    if pid > 0 {
+        unsafe {
+            libc::postnote(libc::PNPROC, pid, crate::sys::pal::INTERRUPT_NOTE.as_ptr());
+        }
+    }
+}
+
+fn spawn(name: &str, f: impl FnOnce() + Send + 'static) -> io::Result<()> {
+    crate::thread::Builder::new()
+        .name(name.into())
+        .stack_size(64 * 1024)
+        .spawn(f)
+        .map(drop)
+}
+
+impl Pump {
+    /// The reader; a stream's writer comes with its first write.
+    fn start(self: &Arc<Self>) -> io::Result<()> {
+        let p = self.clone();
+        spawn("socket reader", move || p.reader())
+    }
+
+    /// Calls the hook, if any (no lock held).
+    fn changed(&self, s: MutexGuard<'_, State>) {
+        let hook = s.hook.clone();
+        drop(s);
+        self.cv.notify_all();
+        if let Some(h) = hook {
+            h();
+        }
+    }
+
+    fn reader(self: Arc<Self>) {
+        lock(&self.m).reader_pid = unsafe { libc::getpid() };
+        let mut buf = vec![0u8; if self.kind == Kind::Datagram { UDP_MAX } else { CHUNK }];
+        loop {
+            {
+                let mut s = lock(&self.m);
+                loop {
+                    let full = match self.kind {
+                        Kind::Stream => s.data.len() >= STREAM_BUF,
+                        Kind::Datagram => s.dgrams.len() >= QUEUE,
+                        Kind::Listener => s.calls.len() >= QUEUE,
+                    };
+                    if s.closed || s.read_eof || !full {
+                        break;
+                    }
+                    s = self.cv.wait(s).unwrap_or_else(|e| e.into_inner());
+                }
+                if s.closed || s.read_eof {
+                    break;
+                }
+            }
+            if self.kind == Kind::Listener {
+                let r = accept_blocking(&self.dir);
+                let mut s = lock(&self.m);
+                if s.closed {
+                    break;
+                }
+                match r {
+                    Ok(call) => s.calls.push_back(call),
+                    Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                    Err(e) => {
+                        s.read_err = Some(e);
+                        self.changed(s);
+                        break;
+                    }
+                }
+                self.changed(s);
+                continue;
+            }
+            let r = self.fd.read(&mut buf);
+            let mut s = lock(&self.m);
+            if s.closed {
+                break;
+            }
+            match r {
+                Ok(0) if self.kind == Kind::Stream => {
+                    s.read_eof = true;
+                    self.changed(s);
+                    break;
+                }
+                Ok(n) if self.kind == Kind::Stream => s.data.extend(&buf[..n]),
+                Ok(n) => s.dgrams.push_back(buf[..n].to_vec()),
+                // shutdown(Read) or a close: the loop's check
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                Err(e) => {
+                    s.read_err = Some(e);
+                    self.changed(s);
+                    break;
+                }
+            }
+            self.changed(s);
+        }
+        lock(&self.m).reader_pid = 0;
+    }
+
+    fn writer(self: Arc<Self>) {
+        lock(&self.m).writer_pid = unsafe { libc::getpid() };
+        let mut chunk = Vec::with_capacity(CHUNK);
+        loop {
+            {
+                let mut s = lock(&self.m);
+                while s.out.is_empty() && !s.closed {
+                    s = self.cv.wait(s).unwrap_or_else(|e| e.into_inner());
+                }
+                if s.out.is_empty() {
+                    break;
+                }
+                let n = s.out.len().min(CHUNK);
+                chunk.clear();
+                chunk.extend(s.out.drain(..n));
+            }
+            let mut off = 0;
+            let r = loop {
+                if off == chunk.len() {
+                    break Ok(());
+                }
+                match self.fd.write(&chunk[off..]) {
+                    Ok(0) => break Err(io::Error::from(io::ErrorKind::WriteZero)),
+                    Ok(n) => off += n,
+                    Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                    Err(e) => break Err(e),
+                }
+            };
+            let mut s = lock(&self.m);
+            if let Err(e) = r {
+                s.write_err = Some(e);
+                s.out.clear();
+                self.changed(s);
+                break;
+            }
+            self.changed(s);
+        }
+        lock(&self.m).writer_pid = 0;
+    }
+
+    /// connect_nonblocking's proc: the conversation is connected (or not).
+    pub(super) fn connected(self: &Arc<Self>, r: io::Result<()>) {
+        let mut s = lock(&self.m);
+        s.connecting = false;
+        match r {
+            Ok(()) => {
+                drop(s);
+                if let Err(e) = self.start() {
+                    let mut s = lock(&self.m);
+                    s.connect_err = Some(e);
+                    self.changed(s);
+                    return;
+                }
+                self.changed(lock(&self.m));
+            }
+            Err(e) => {
+                s.connect_err = Some(e);
+                self.changed(s);
+            }
+        }
+    }
+
+    pub(super) fn kind(&self) -> Kind {
+        self.kind
+    }
+
+    pub(super) fn set_nonblocking(&self, on: bool) {
+        lock(&self.m).nonblocking = on;
+    }
+
+    pub(super) fn set_hook(&self, hook: Option<Hook>) {
+        let s = {
+            let mut s = lock(&self.m);
+            s.hook = hook;
+            s
+        };
+        // ready already: the new hook hears of it
+        self.changed(s);
+    }
+
+    pub(super) fn readiness(&self) -> Readiness {
+        let s = lock(&self.m);
+        let readable = match self.kind {
+            Kind::Stream => !s.data.is_empty(),
+            Kind::Datagram => !s.dgrams.is_empty(),
+            Kind::Listener => !s.calls.is_empty(),
+        } || s.read_eof
+            || s.read_err.is_some();
+        let error = s.read_err.is_some() || s.write_err.is_some() || s.connect_err.is_some();
+        Readiness {
+            readable: readable || s.connect_err.is_some(),
+            writable: !s.connecting
+                && match self.kind {
+                    Kind::Stream => s.out.len() < STREAM_BUF,
+                    _ => true,
+                },
+            read_closed: s.read_eof,
+            write_closed: s.write_err.is_some(),
+            error,
+        }
+    }
+
+    pub(super) fn take_error(&self) -> Option<io::Error> {
+        let mut s = lock(&self.m);
+        s.connect_err.take().or_else(|| s.write_err.take())
+    }
+
+    /// Waits on the condition (a blocking socket), at most until `deadline`.
+    fn wait<'a>(
+        &self,
+        s: MutexGuard<'a, State>,
+        deadline: Option<Instant>,
+    ) -> io::Result<MutexGuard<'a, State>> {
+        match deadline {
+            None => Ok(self.cv.wait(s).unwrap_or_else(|e| e.into_inner())),
+            Some(d) => {
+                let now = Instant::now();
+                if now >= d {
+                    return Err(io::const_error!(io::ErrorKind::TimedOut, "timed out"));
+                }
+                Ok(self.cv.wait_timeout(s, d - now).unwrap_or_else(|e| e.into_inner()).0)
+            }
+        }
+    }
+
+    /// A stream's bytes (`peek`: left in the buffer), a datagram (truncated to `buf`).
+    pub(super) fn read(&self, buf: &mut [u8], peek: bool, timeout: Option<Duration>) -> io::Result<usize> {
+        let deadline = timeout.map(|t| Instant::now() + t);
+        let mut s = lock(&self.m);
+        loop {
+            match self.kind {
+                Kind::Stream if !s.data.is_empty() => {
+                    let n = buf.len().min(s.data.len());
+                    for (d, b) in buf[..n].iter_mut().zip(s.data.iter()) {
+                        *d = *b;
+                    }
+                    if !peek {
+                        s.data.drain(..n);
+                        drop(s);
+                        self.cv.notify_all();
+                    }
+                    return Ok(n);
+                }
+                Kind::Datagram if !s.dgrams.is_empty() => {
+                    let d = if peek { s.dgrams[0].clone() } else { s.dgrams.pop_front().unwrap() };
+                    let n = buf.len().min(d.len());
+                    buf[..n].copy_from_slice(&d[..n]);
+                    drop(s);
+                    self.cv.notify_all();
+                    return Ok(n);
+                }
+                _ => {}
+            }
+            if s.read_eof {
+                return Ok(0);
+            }
+            if let Some(e) = s.read_err.take() {
+                return Err(e);
+            }
+            if let Some(e) = s.connect_err.take() {
+                return Err(e);
+            }
+            if s.nonblocking {
+                return Err(io::Error::from(io::ErrorKind::WouldBlock));
+            }
+            s = self.wait(s, deadline)?;
+        }
+    }
+
+    /// A stream's write: into the buffer.
+    pub(super) fn write(self: &Arc<Self>, buf: &[u8], timeout: Option<Duration>) -> io::Result<usize> {
+        let deadline = timeout.map(|t| Instant::now() + t);
+        let mut s = lock(&self.m);
+        loop {
+            if let Some(e) = s.write_err.take() {
+                return Err(e);
+            }
+            if let Some(e) = s.connect_err.take() {
+                return Err(e);
+            }
+            if s.closed {
+                return Err(io::Error::from(io::ErrorKind::BrokenPipe));
+            }
+            if !s.connecting && s.out.len() < STREAM_BUF {
+                let n = buf.len().min(STREAM_BUF - s.out.len());
+                s.out.extend(&buf[..n]);
+                let start = !s.writer;
+                s.writer = true;
+                drop(s);
+                if start {
+                    let p = self.clone();
+                    if let Err(e) = spawn("socket writer", move || p.writer()) {
+                        lock(&self.m).writer = false;
+                        return Err(e);
+                    }
+                }
+                self.cv.notify_all();
+                return Ok(n);
+            }
+            if s.nonblocking {
+                return Err(io::Error::from(io::ErrorKind::WouldBlock));
+            }
+            s = self.wait(s, deadline)?;
+        }
+    }
+
+    /// A listener's next call.
+    pub(super) fn accept(&self) -> io::Result<(Socket, SocketAddr)> {
+        let mut s = lock(&self.m);
+        loop {
+            if let Some(c) = s.calls.pop_front() {
+                drop(s);
+                self.cv.notify_all();
+                return Ok(c);
+            }
+            if let Some(e) = s.read_err.take() {
+                return Err(e);
+            }
+            if s.nonblocking {
+                return Err(io::Error::from(io::ErrorKind::WouldBlock));
+            }
+            s = self.wait(s, None)?;
+        }
+    }
+
+    /// shutdown(Read): readers see the end, now.
+    pub(super) fn shutdown_read(&self) {
+        let mut s = lock(&self.m);
+        s.read_eof = true;
+        let reader = s.reader_pid;
+        self.changed(s);
+        interrupt(reader);
+    }
+}
+
+/// A stream's connect in the background (os::plan9::net::connect_nonblocking).
+pub(super) fn connecting(sock: &TcpStream, ctl: FileDesc, msg: String) -> io::Result<()> {
+    let p = of(sock.socket(), Kind::Stream, String::new(), true)?;
+    lock(&p.m).nonblocking = true;
+    spawn("socket connect", move || {
+        let r = ctl.write(msg.as_bytes()).map(drop);
+        drop(ctl);
+        p.connected(r);
+    })
+}
