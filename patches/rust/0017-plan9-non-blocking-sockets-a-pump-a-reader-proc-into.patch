+/// A non-blocking TCP stream to `addr`, connected in the background: writable when it is,
+/// its error (take_error) if not. The data file is opened before the connect (as dial(2)
+/// does after it; the conversation exists from the clone).
+pub fn connect_nonblocking(addr: &SocketAddr) -> io::Result<TcpStream> {
+    let clone = CString::new("/net/tcp/clone").unwrap();
+    let ctl = cvt(unsafe { libc::open(clone.as_ptr(), libc::ORDWR | libc::OCEXEC) })?;
+    let ctl = unsafe { FileDesc::from_raw_fd(ctl) };
+    let mut buf = [0u8; 16];
+    let n = ctl.read(&mut buf)?;
+    let num = crate::str::from_utf8(&buf[..n])
+        .map_err(|_| err(io::ErrorKind::InvalidData, "bad conversation number"))?
+        .trim();
+    let s = TcpStream { inner: Socket::new(open_conv(&format!("/net/tcp/{num}"), "data")?) };
+    pump::connecting(&s, ctl, format!("connect {}!{}", addr.ip(), addr.port()))?;
+    Ok(s)
+}
