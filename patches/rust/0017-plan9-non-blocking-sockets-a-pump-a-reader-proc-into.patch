+
+/// What a non-blocking socket is ready for; a socket without a pump (blocking): always.
+pub fn readiness(fd: RawFd) -> Readiness {
+    match pump::get(fd) {
+        Some(p) => p.readiness(),
+        None => Readiness { readable: true, writable: true, ..Readiness::default() },
+    }
+}
+
+/// The hook of a non-blocking socket, called when it may have become ready.
+pub fn set_ready_hook(fd: RawFd, hook: Option<Hook>) -> io::Result<()> {
+    match pump::get(fd) {
+        Some(p) => Ok(p.set_hook(hook)),
+        None => Err(io::const_error!(io::ErrorKind::InvalidInput, "not a non-blocking socket")),
+    }
+}
