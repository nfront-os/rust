+//! Plan 9-specific networking: what an event loop (mio) needs of non-blocking sockets.
+//!
+//! Plan 9 has only blocking I/O; a socket set non-blocking ([`TcpStream::set_nonblocking`]
+//! &c.) gets procs that do the blocking calls into buffers. [`readiness`] says what such a
+//! socket is ready for, a hook ([`set_ready_hook`]) is called whenever that may have changed
+//! (from one of those procs, with no lock held: it should only note and wake).
+//!
+//! [`TcpStream::set_nonblocking`]: crate::net::TcpStream::set_nonblocking
+
+#![stable(feature = "rust1", since = "1.0.0")]
+
+use crate::io;
+use crate::net::{SocketAddr, TcpStream};
+use crate::os::plan9::io::RawFd;
+use crate::sync::Arc;
+use crate::sys::FromInner;
+
+/// What a non-blocking socket is ready for. A blocking socket: everything.
+#[stable(feature = "rust1", since = "1.0.0")]
+#[derive(Clone, Copy, Default, Debug)]
+pub struct Readiness {
+    /// Data, a datagram or a call to read; or the end, or an error.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub readable: bool,
+    /// Room for a write (a stream: its buffer; connected).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub writable: bool,
+    /// The other end has closed (a read returns 0).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub read_closed: bool,
+    /// Writing failed.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub write_closed: bool,
+    /// An error to take (`take_error`).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub error: bool,
+}
+
+/// What the non-blocking socket `fd` is ready for.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn readiness(fd: RawFd) -> Readiness {
+    let r = crate::sys::net::readiness(fd);
+    Readiness {
+        readable: r.readable,
+        writable: r.writable,
+        read_closed: r.read_closed,
+        write_closed: r.write_closed,
+        error: r.error,
+    }
+}
+
+/// Sets (or clears) the hook of the non-blocking socket `fd`: called whenever it may have
+/// become ready, and at once. An error if `fd` is no non-blocking socket.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn set_ready_hook(fd: RawFd, hook: Option<Arc<dyn Fn() + Send + Sync>>) -> io::Result<()> {
+    crate::sys::net::set_ready_hook(fd, hook)
+}
+
+/// A non-blocking TCP stream to `addr`, connected in the background: writable once it is;
+/// if it cannot be, readable with the error (`take_error`, or the next read or write).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub fn connect_nonblocking(addr: &SocketAddr) -> io::Result<TcpStream> {
+    crate::sys::net::connect_nonblocking(addr).map(TcpStream::from_inner)
+}
