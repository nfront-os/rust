+// riscv64: the system call number and its result in s0 (x8), the argument at 8(sp) (libc's
+// stubs, gen-9syscall.sh), ECALL; the kernel gives the child all its parent's registers but
+// s0, which is zero (riscv64/trap.c forkchild). psABI: s0-s11 callee-saved, ra the link; the
+// stack 16-byte aligned. As APE's pthread.c, privtop and the argument go to the child in s1
+// and s2.
+/// Runs `f(arg)` on the stack below `top`, back on the caller's after.
+#[cfg(target_arch = "riscv64")]
+#[unsafe(naked)]
+unsafe extern "C" fn __rust_plan9_runon(
+    top: *mut u8,
+    f: unsafe extern "C" fn(*mut c_void),
+    arg: *mut c_void,
+) {
+    crate::arch::naked_asm!(
+        "   addi sp, sp, -16",
+        "   sd ra, 8(sp)",
+        "   sd s0, 0(sp)",
+        "   mv s0, sp",
+        "   mv sp, a0",
+        "   mv a0, a2",
+        "   jalr a1",
+        "   mv sp, s0",
+        "   ld ra, 8(sp)",
+        "   ld s0, 0(sp)",
+        "   addi sp, sp, 16",
+        "   ret",
+    )
+}
+
+/// `rfork(flags)`; the child goes on at `__rust_plan9_threadstart(arg)` on the stack
+/// below `privtop`, without touching its parent's.
+#[cfg(target_arch = "riscv64")]
+#[unsafe(naked)]
+unsafe extern "C" fn __rust_plan9_rforkthread(flags: i32, privtop: usize, arg: *mut c_void) -> i32 {
+    crate::arch::naked_asm!(
+        "   addi sp, sp, -32",
+        "   sd s0, 24(sp)",
+        "   sd s1, 16(sp)",
+        "   sd s2, 0(sp)",
+        "   mv s1, a1",
+        "   mv s2, a2",
+        "   sw a0, 8(sp)", // the argument, at 8(sp)
+        "   li s0, 19", // RFORK
+        "   ecall",
+        "   beqz s0, 1f",
+        "   mv a0, s0",
+        "   ld s0, 24(sp)",
+        "   ld s1, 16(sp)",
+        "   ld s2, 0(sp)",
+        "   addi sp, sp, 32",
+        "   ret",
+        "1: mv sp, s1",
+        "   li ra, 0",
+        "   mv a0, s2",
+        "   call {start}",
+        "2: j 2b",
+        start = sym __rust_plan9_threadstart,
+    )
+}
+
+/// The same for a child that runs `(*arg).0(arg)`: process::Command's.
+#[cfg(target_arch = "riscv64")]
+#[unsafe(naked)]
+unsafe extern "C" fn __rust_plan9_rforkrun(flags: i32, privtop: usize, arg: *const c_void) -> i32 {
+    crate::arch::naked_asm!(
+        "   addi sp, sp, -32",
+        "   sd s0, 24(sp)",
+        "   sd s1, 16(sp)",
+        "   sd s2, 0(sp)",
+        "   mv s1, a1",
+        "   mv s2, a2",
+        "   sw a0, 8(sp)", // the argument, at 8(sp)
+        "   li s0, 19", // RFORK
+        "   ecall",
+        "   beqz s0, 1f",
+        "   mv a0, s0",
+        "   ld s0, 24(sp)",
+        "   ld s1, 16(sp)",
+        "   ld s2, 0(sp)",
+        "   addi sp, sp, 32",
+        "   ret",
+        "1: mv sp, s1",
+        "   li ra, 0",
+        "   ld t0, 0(s2)",
+        "   mv a0, s2",
+        "   jalr t0",
+        "2: j 2b",
+    )
+}
+
 /// What a child of [`rfork_run`] runs: `f(self)`, which must not return.
 #[repr(C)]
 pub struct Run<T> {
