@@ -0,0 +1,31 @@
+use crate::spec::{Arch, CodeModel, LlvmAbi, Target, TargetMetadata, TargetOptions, base};
+
+pub(crate) fn target() -> Target {
+    Target {
+        // as x86_64-unknown-plan9: an unknown OS is ELF and the RISC-V psABI (lp64d), which
+        // 9front's gcc port (riscv64-unknown-plan9) uses too
+        llvm_target: "riscv64-unknown-plan9".into(),
+        metadata: TargetMetadata {
+            description: Some("RISC-V 64 9front (Plan 9)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        // riscv64gc-unknown-linux-gnu's
+        data_layout: "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128".into(),
+        arch: Arch::RiscV64,
+        options: TargetOptions {
+            // rv64gc, lp64d, medany: the tree's (riscv64/cflags.json) and its gcc's defaults
+            code_model: Some(CodeModel::Medium),
+            cpu: "generic-rv64".into(),
+            // no linker relaxation: nobody sets gp (__global_pointer$), neither 9front's
+            // _main nor the kernel (jc has the register as SB); the gcc is -mno-relax too
+            features: "+m,+a,+f,+d,+c,+zicsr,+zifencei,-relax".into(),
+            llvm_abiname: LlvmAbi::Lp64d,
+            max_atomic_width: Some(64),
+            linker: Some("riscv64-unknown-plan9-gcc".into()),
+            ..base::plan9::opts()
+        },
+    }
+}
