From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 29 Oct 2026 11:47:24 +0100
Subject: [PATCH 03/25] plan9: panic=unwind (libgcc's unwinder), backtraces

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 compiler/rustc_target/src/spec/base/plan9.rs | 3 ++-
 library/panic_unwind/src/lib.rs              | 1 +
 library/std/src/sys/personality/mod.rs       | 1 +
 library/unwind/src/lib.rs                    | 1 +
 4 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/compiler/rustc_target/src/spec/base/plan9.rs b/compiler/rustc_target/src/spec/base/plan9.rs
index 5734885b59a..104e9f300c1 100644
--- a/compiler/rustc_target/src/spec/base/plan9.rs
+++ b/compiler/rustc_target/src/spec/base/plan9.rs
@@ -35,7 +35,8 @@ pub(crate) fn opts() -> TargetOptions {
         late_link_args: TargetOptions::link_args(flavor, &["-lgcc", "-lc"]),
         // no dl_iterate_phdr: the unwinder finds the frames registered by crtbegin.o
         eh_frame_header: false,
-        panic_strategy: PanicStrategy::Abort,
+        // libgcc's DWARF unwinder, the tables registered by crtbegin.o
+        panic_strategy: PanicStrategy::Unwind,
         stack_probes: StackProbeType::Inline,
         ..Default::default()
     }
diff --git a/library/panic_unwind/src/lib.rs b/library/panic_unwind/src/lib.rs
index d25d94258a1..a269ba636e1 100644
--- a/library/panic_unwind/src/lib.rs
+++ b/library/panic_unwind/src/lib.rs
@@ -37,6 +37,7 @@
         target_os = "psp",
         target_os = "xous",
         target_os = "solid_asp3",
+        target_os = "plan9",
         all(target_family = "unix", not(any(target_os = "espidf", target_os = "nuttx"))),
         all(target_vendor = "fortanix", target_env = "sgx"),
         target_family = "wasm",
diff --git a/library/std/src/sys/personality/mod.rs b/library/std/src/sys/personality/mod.rs
index be79643bdf8..76a88f898d8 100644
--- a/library/std/src/sys/personality/mod.rs
+++ b/library/std/src/sys/personality/mod.rs
@@ -30,6 +30,7 @@ fn rust_eh_personality() {
         target_os = "psp",
         target_os = "xous",
         target_os = "solid_asp3",
+        target_os = "plan9",
         all(target_family = "unix", not(target_os = "espidf"), not(target_os = "nuttx")),
         all(target_vendor = "fortanix", target_env = "sgx"),
     ) => {
diff --git a/library/unwind/src/lib.rs b/library/unwind/src/lib.rs
index fb0acdab835..2774b0fa6d4 100644
--- a/library/unwind/src/lib.rs
+++ b/library/unwind/src/lib.rs
@@ -30,6 +30,7 @@
         all(target_vendor = "fortanix", target_env = "sgx"),
         all(target_os = "wasi", panic = "unwind"),
         target_os = "xous",
+        target_os = "plan9",
     ) => {
         mod libunwind;
         pub use libunwind::*;
