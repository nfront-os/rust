@@ -355,6 +355,15 @@ pub fn connect_nonblocking(addr: &SocketAddr) -> io::Result<TcpStream> {
     Ok(s)
 }
 
+/// The half close of a conversation, on its ctl: "shutdown" (9front's tcp in the gcc port); a
+/// kernel without it knows only "close" (both sides).
+fn shutdown_fd(ctl: &FileDesc) -> io::Result<()> {
+    match ctl.write(b"shutdown") {
+        Err(e) if e.to_string().contains("unknown control") => ctl.write(b"close").map(drop),
+        r => r.map(drop),
+    }
+}
+
 pub struct TcpStream {
     inner: Socket,
 }
@@ -445,7 +454,17 @@ pub fn shutdown(&self, how: Shutdown) -> io::Result<()> {
                 }
                 Ok(())
             }
-            Shutdown::Write | Shutdown::Both => write_ctl(&self.inner.dir()?, "close"),
+            // ctl "shutdown": a FIN, the receive side stays open (9front's tcp in the gcc
+            // port; a kernel without it knows only "close", both sides)
+            // a pumped stream's after what its writer has yet to write
+            Shutdown::Write => {
+                let ctl = open_conv(&self.inner.dir()?, "ctl")?;
+                match self.inner.pump() {
+                    Some(p) => p.shutdown_write(ctl),
+                    None => shutdown_fd(&ctl),
+                }
+            }
+            Shutdown::Both => write_ctl(&self.inner.dir()?, "close"),
         }
     }
 
