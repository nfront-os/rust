+    /// shutdown(Write): the half close after what is buffered (the writer does it, or now if
+    /// nothing is buffered or being written); no writes after it.
+    pub(super) fn shutdown_write(&self, ctl: FileDesc) -> io::Result<()> {
+        let mut s = lock(&self.m);
+        if s.shut_wr.is_some() {
+            return Ok(());
+        }
+        let now = s.out.is_empty() && !s.inflight;
+        let ctl = Arc::new(ctl);
+        s.shut_wr = Some(ctl.clone());
+        s.shut_done = now;
+        drop(s);
+        self.cv.notify_all();
+        if now { super::shutdown_fd(&ctl) } else { Ok(()) }
+    }
+
