diff --git a/compiler/rustc_target/src/spec/targets/i686_unknown_plan9.rs b/compiler/rustc_target/src/spec/targets/i686_unknown_plan9.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a6769d4ff421408521366548f81f7a3ccabf93fc
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/i686_unknown_plan9.rs
@@ -0,0 +1,29 @@
+use crate::spec::{Arch, Target, TargetMetadata, TargetOptions, base};
+
+pub(crate) fn target() -> Target {
+    Target {
+        // as x86_64-unknown-plan9: an unknown OS is ELF and the System V ABI (i386: cdecl,
+        // double and long long 4-byte aligned in structs), which 9front's gcc port uses too
+        llvm_target: "i686-unknown-plan9".into(),
+        metadata: TargetMetadata {
+            description: Some("32-bit x86 9front (Plan 9), SSE2".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 32,
+        arch: Arch::X86,
+        // i686-unknown-linux-gnu's
+        data_layout: "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-\
+            i128:128-f64:32:64-f80:32-n8:16:32-S128"
+            .into(),
+        options: TargetOptions {
+            // as Rust's i686 targets: SSE2 (the tree's own C is -march=pentium, x87; the C
+            // ABI is the same)
+            cpu: "pentium4".into(),
+            max_atomic_width: Some(64),
+            linker: Some("i686-pc-plan9-gcc".into()),
+            ..base::plan9::opts()
+        },
+    }
+}
diff --git a/library/std/src/sys/pal/plan9/proc.rs b/library/std/src/sys/pal/plan9/proc.rs
index 1e09971c275c82c16f1030017d56e204b050a39b..6ecdae9863a254c05859f9e0b1d39d99a0829d68 100644
--- a/library/std/src/sys/pal/plan9/proc.rs
+++ b/library/std/src/sys/pal/plan9/proc.rs
@@ -297,6 +297,82 @@ crate::arch::global_asm!(
     options(att_syntax)
 );
 
+// 386: the system call number in AX, the arguments from 4(SP) on (libc's stubs are called:
+// 0(SP) is their return address), INT $64; the kernel gives the child all registers of its
+// parent (pc/l.s forkret pops the copied Ureg), AX zero. cdecl: arguments on the stack,
+// %ebx, %esi, %edi, %ebp callee-saved; the stack 16-byte aligned at a call.
+#[cfg(target_arch = "x86")]
+crate::arch::global_asm!(
+    ".text",
+    ".globl __rust_plan9_runon",
+    "__rust_plan9_runon:",
+    "   pushl %ebp",
+    "   movl %esp, %ebp",
+    "   movl 8(%ebp), %eax", // top
+    "   movl 12(%ebp), %ecx", // f
+    "   movl 16(%ebp), %edx", // arg
+    "   movl %eax, %esp",
+    "   subl $12, %esp",
+    "   pushl %edx",
+    "   call *%ecx",
+    "   movl %ebp, %esp",
+    "   popl %ebp",
+    "   ret",
+    ".globl __rust_plan9_rforkthread",
+    "__rust_plan9_rforkthread:",
+    "   pushl %ebx",
+    "   pushl %ebp",
+    "   pushl %esi",
+    "   pushl %edi",
+    "   movl 20(%esp), %eax", // flags
+    "   movl 24(%esp), %esi", // privtop
+    "   movl 28(%esp), %edi", // arg
+    "   subl $8, %esp",
+    "   movl %eax, 4(%esp)",
+    "   movl $19, %eax", // RFORK
+    "   int $64",
+    "   testl %eax, %eax",
+    "   jz 1f",
+    "   addl $8, %esp",
+    "   popl %edi",
+    "   popl %esi",
+    "   popl %ebp",
+    "   popl %ebx",
+    "   ret",
+    "1: movl %esi, %esp",
+    "   subl $12, %esp",
+    "   pushl %edi",
+    "   call __rust_plan9_threadstart",
+    "2: jmp 2b",
+    ".globl __rust_plan9_rforkrun",
+    "__rust_plan9_rforkrun:",
+    "   pushl %ebx",
+    "   pushl %ebp",
+    "   pushl %esi",
+    "   pushl %edi",
+    "   movl 20(%esp), %eax",
+    "   movl 24(%esp), %esi",
+    "   movl 28(%esp), %edi",
+    "   subl $8, %esp",
+    "   movl %eax, 4(%esp)",
+    "   movl $19, %eax", // RFORK
+    "   int $64",
+    "   testl %eax, %eax",
+    "   jz 1f",
+    "   addl $8, %esp",
+    "   popl %edi",
+    "   popl %esi",
+    "   popl %ebp",
+    "   popl %ebx",
+    "   ret",
+    "1: movl %esi, %esp",
+    "   subl $12, %esp",
+    "   pushl %edi",
+    "   call *(%edi)",
+    "2: jmp 2b",
+    options(att_syntax)
+);
+
 /// What a child of [`rfork_run`] runs: `f(self)`, which must not return.
 #[repr(C)]
 pub struct Run<T> {
