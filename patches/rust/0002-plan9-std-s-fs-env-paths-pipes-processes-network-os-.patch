+////////////////////////////////////////////////////////////////////////////////
+// Exit status: the Waitmsg's message, `"prog pid: msg"`, empty for success
+////////////////////////////////////////////////////////////////////////////////
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub struct ExitStatus {
+    msg: [u8; libc::ERRMAX],
+    len: u8,
+}
+
+impl Default for ExitStatus {
+    fn default() -> ExitStatus {
+        ExitStatus { msg: [0; libc::ERRMAX], len: 0 }
+    }
+}
+
+impl ExitStatus {
+    fn new(msg: &[u8]) -> ExitStatus {
+        let mut s = ExitStatus::default();
+        let n = msg.len().min(libc::ERRMAX);
+        s.msg[..n].copy_from_slice(&msg[..n]);
+        s.len = n as u8;
+        s
+    }
+
+    /// The message of exits(2), with the program's name and pid before it.
+    pub fn msg(&self) -> &[u8] {
+        &self.msg[..self.len as usize]
+    }
+
+    /// What the program gave exits(2).
+    fn exits(&self) -> &[u8] {
+        let m = self.msg();
+        match m.windows(2).position(|w| w == b": ") {
+            Some(i) => &m[i + 2..],
+            None => m,
+        }
+    }
+
+    pub fn exit_ok(&self) -> Result<(), ExitStatusError> {
+        if self.len == 0 { Ok(()) } else { Err(ExitStatusError(*self)) }
+    }
+
+    /// 0 for success, the number of a Rust program's `exit` (its status is the number);
+    /// none for any other message.
+    pub fn code(&self) -> Option<i32> {
+        if self.len == 0 {
+            return Some(0);
+        }
+        crate::str::from_utf8(self.exits()).ok()?.trim().parse().ok()
+    }
+}
+
+impl fmt::Debug for ExitStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("ExitStatus").field(&String::from_utf8_lossy(self.msg())).finish()
+    }
+}
+
+impl fmt::Display for ExitStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if self.len == 0 {
+            write!(f, "exit status: 0")
+        } else {
+            write!(f, "exit status: {}", String::from_utf8_lossy(self.msg()))
+        }
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy)]
+pub struct ExitStatusError(ExitStatus);
+
+impl fmt::Debug for ExitStatusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("ExitStatusError").field(&self.0).finish()
+    }
+}
+
+impl Into<ExitStatus> for ExitStatusError {
+    fn into(self) -> ExitStatus {
+        self.0
+    }
+}
+
+impl ExitStatusError {
+    pub fn code(self) -> Option<NonZero<i32>> {
+        self.0.code().and_then(NonZero::new)
+    }
+}
+
+#[derive(PartialEq, Eq, Clone, Copy, Debug)]
+pub struct ExitCode(u8);
+
+impl ExitCode {
+    pub const SUCCESS: ExitCode = ExitCode(0);
+    pub const FAILURE: ExitCode = ExitCode(1);
+
+    pub fn as_i32(&self) -> i32 {
+        self.0 as i32
+    }
+}
+
+impl From<u8> for ExitCode {
+    fn from(code: u8) -> Self {
+        Self(code)
+    }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// Waiting: /proc/<spawner>/wait
+////////////////////////////////////////////////////////////////////////////////
+
+struct Waits {
+    /// Waitmsgs read for others: (pid, message)
+    done: Vec<(i32, ExitStatus)>,
+    /// spawners whose wait file a thread reads now
+    reading: Vec<i32>,
+}
+
+static WAITS: Mutex<Waits> = Mutex::new(Waits { done: Vec::new(), reading: Vec::new() });
+static WAITED: Condvar = Condvar::new();
+
+/// One Waitmsg of a child of `spawner`, as await(2): `pid time time time 'msg'`.
+fn read_wait(spawner: i32) -> io::Result<(i32, ExitStatus)> {
+    let path = CString::new(format!("/proc/{spawner}/wait")).unwrap();
+    let fd = cvt(unsafe { libc::open(path.as_ptr(), libc::OREAD | libc::OCEXEC) })?;
+    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+    let mut buf = [0u8; 512];
+    let n = loop {
+        match fd.read(&mut buf) {
+            Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+            r => break r?,
+        }
+    };
+    let s = &buf[..n];
+    let mut fields = s.splitn(5, |&c| c == b' ').filter(|f| !f.is_empty());
+    let pid = fields
+        .next()
+        .and_then(|p| crate::str::from_utf8(p).ok()?.trim().parse().ok())
+        .ok_or(io::const_error!(io::ErrorKind::InvalidData, "bad wait message"))?;
+    // the rest: three times, then the quoted message
+    let rest = &s[s.iter().position(|&c| c == b'\'').unwrap_or(s.len())..];
+    let mut msg = Vec::new();
+    if rest.len() >= 2 {
+        let inner = &rest[1..rest.len() - 1];
+        let mut i = 0;
+        while i < inner.len() {
+            msg.push(inner[i]);
+            if inner[i] == b'\'' && inner.get(i + 1) == Some(&b'\'') {
+                i += 1;
+            }
+            i += 1;
+        }
+    } else {
+        // unquoted: the fifth field
+        let f: Vec<&[u8]> = s.split(|&c| c == b' ').filter(|f| !f.is_empty()).collect();
+        if let Some(m) = f.get(4) {
+            msg.extend_from_slice(m);
+        }
+    }
+    Ok((pid, ExitStatus::new(&msg)))
+}
+
+fn wait_for(spawner: i32, pid: i32) -> io::Result<ExitStatus> {
+    let mut w = WAITS.lock().unwrap_or_else(|e| e.into_inner());
+    loop {
+        if let Some(i) = w.done.iter().position(|&(p, _)| p == pid) {
+            return Ok(w.done.swap_remove(i).1);
+        }
+        if w.reading.contains(&spawner) {
+            w = WAITED.wait(w).unwrap_or_else(|e| e.into_inner());
+            continue;
+        }
+        w.reading.push(spawner);
+        drop(w);
+        let r = read_wait(spawner);
+        w = WAITS.lock().unwrap_or_else(|e| e.into_inner());
+        w.reading.retain(|&s| s != spawner);
+        WAITED.notify_all();
+        match r {
+            Ok(d) => w.done.push(d),
+            Err(e) => return Err(e),
+        }
+    }
+}
+
+pub struct Process {
+    pid: i32,
+    spawner: i32,
+    status: Option<ExitStatus>,
+}
+
+impl Process {
+    pub fn id(&self) -> u32 {
+        self.pid as u32
+    }
+
+    /// proc(3)'s ctl "kill"; a child that has ended already is no error.
+    pub fn kill(&mut self) -> io::Result<()> {
+        if self.status.is_some() {
+            return Ok(());
+        }
+        let path = CString::new(format!("/proc/{}/ctl", self.pid)).unwrap();
+        let fd = unsafe { libc::open(path.as_ptr(), libc::OWRITE | libc::OCEXEC) };
+        if fd < 0 {
+            let e = last_error();
+            return if e.kind() == io::ErrorKind::NotFound { Ok(()) } else { Err(e) };
+        }
+        let fd = unsafe { FileDesc::from_raw_fd(fd) };
+        match fd.write(b"kill") {
+            Err(e) if e.kind() != io::ErrorKind::NotFound => Err(e),
+            _ => Ok(()),
+        }
+    }
+
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        if let Some(s) = self.status {
+            return Ok(s);
+        }
+        let s = wait_for(self.spawner, self.pid)?;
+        self.status = Some(s);
+        Ok(s)
+    }
+
+    /// Plan 9 has no zombies: a child whose proc is gone has ended, its Waitmsg waits.
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        if let Some(s) = self.status {
+            return Ok(Some(s));
+        }
+        {
+            let mut w = WAITS.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(i) = w.done.iter().position(|&(p, _)| p == self.pid) {
+                let s = w.done.swap_remove(i).1;
+                self.status = Some(s);
+                return Ok(Some(s));
+            }
+        }
+        let path = CString::new(format!("/proc/{}/status", self.pid)).unwrap();
+        let fd = unsafe { libc::open(path.as_ptr(), libc::OREAD | libc::OCEXEC) };
+        if fd >= 0 {
+            unsafe { libc::close(fd) };
+            return Ok(None);
+        }
+        self.wait().map(Some)
+    }
+}
+
+pub struct CommandArgs<'a> {
+    iter: crate::slice::Iter<'a, OsString>,
+}
+
+impl<'a> Iterator for CommandArgs<'a> {
+    type Item = &'a OsStr;
+    fn next(&mut self) -> Option<&'a OsStr> {
+        self.iter.next().map(|os| &**os)
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+impl<'a> ExactSizeIterator for CommandArgs<'a> {
+    fn len(&self) -> usize {
+        self.iter.len()
+    }
+    fn is_empty(&self) -> bool {
+        self.iter.is_empty()
+    }
+}
+
+impl<'a> fmt::Debug for CommandArgs<'a> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_list().entries(self.iter.clone()).finish()
+    }
+}
+
+pub type ChildPipe = crate::sys::pipe::Pipe;
+
+pub fn read_output(
+    out: ChildPipe,
+    stdout: &mut Vec<u8>,
+    err: ChildPipe,
+    stderr: &mut Vec<u8>,
+) -> io::Result<()> {
+    crate::thread::scope(|s| {
+        let err_reader = s.spawn(move || err.read_to_end(stderr));
+        let out_res = out.read_to_end(stdout);
+        let err_res = err_reader.join().expect("stderr reader thread panicked");
+        out_res?;
+        err_res?;
+        Ok(())
+    })
+}
+
+pub fn getpid() -> u32 {
+    unsafe { libc::getpid() as u32 }
+}
