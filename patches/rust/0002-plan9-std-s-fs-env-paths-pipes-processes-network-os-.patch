index 00000000000..7e4d05a8fb4
--- /dev/null
+++ b/library/std/src/sys/net/connection/plan9.rs
@@ -0,0 +1,783 @@
+//! The network of 9front: ip(3)'s conversations under `/net`, with dial(2), announce,
+//! listen and accept; names through ndb's `/net/cs`.
+//!
+//! A [`Socket`] is a file descriptor of a conversation: its `data` (TCP streams, UDP), or its
+//! `ctl` (a listener, whose announcement lives as long as the ctl file is open; opened by
+//! name, not announce's clone). The conversation's directory (`/net/tcp/4`) is the
+//! descriptor's name (fd2path), so a socket made from a raw descriptor works the same. A UDP socket reads and writes its datagrams
+//! with the `headers` of udp: 52 bytes, the remote, local and interface address (16 bytes
+//! each, IPv4 as v4-in-v6), the remote and local port (big-endian). Timeouts: alarm(2)
+//! around the call, which a note ends ("interrupted"). Plan 9 has no non-blocking I/O, no
+//! peeking, no socket options but a few ctl messages.
+
+use crate::ffi::CString;
+use crate::fmt;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut};
+use crate::net::{
+    Ipv4Addr, Ipv6Addr, Shutdown, SocketAddr, SocketAddrV4, SocketAddrV6, ToSocketAddrs,
+};
+use crate::os::plan9::io::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, RawFd};
+use crate::sys::fd::{FdState, FileDesc, cloexec, set_state, state};
+use crate::sys::{AsInner, FromInner, IntoInner, cvt, last_error, unsupported};
+use crate::time::Duration;
+
+fn err(kind: io::ErrorKind, msg: &'static str) -> io::Error {
+    io::Error::new(kind, msg)
+}
+
+/// `tcp!1.2.3.4!80`; the unspecified address is `*`.
+fn netaddr(proto: &str, addr: &SocketAddr) -> CString {
+    let s = if addr.ip().is_unspecified() {
+        format!("{proto}!*!{}", addr.port())
+    } else {
+        format!("{proto}!{}!{}", addr.ip(), addr.port())
+    };
+    CString::new(s).unwrap()
+}
+
+/// `1.2.3.4!80` (a conversation's `local` or `remote`, `/net/cs`'s answer).
+fn parse_addr(s: &str) -> io::Result<SocketAddr> {
+    let s = s.trim();
+    let (ip, port) =
+        s.rsplit_once('!').ok_or(err(io::ErrorKind::InvalidData, "bad network address"))?;
+    let port: u16 = port.parse().map_err(|_| err(io::ErrorKind::InvalidData, "bad port"))?;
+    let ip = if ip == "*" || ip == "::" {
+        crate::net::IpAddr::V4(Ipv4Addr::UNSPECIFIED)
+    } else {
+        ip.parse().map_err(|_| err(io::ErrorKind::InvalidData, "bad ip address"))?
+    };
+    Ok(match ip {
+        crate::net::IpAddr::V6(v6) => match v6.to_ipv4_mapped() {
+            Some(v4) => SocketAddr::V4(SocketAddrV4::new(v4, port)),
+            None => SocketAddr::V6(SocketAddrV6::new(v6, port, 0, 0)),
+        },
+        v4 => SocketAddr::new(v4, port),
+    })
+}
+
+fn read_file(path: &str) -> io::Result<String> {
+    let c = CString::new(path).unwrap();
+    let fd = cvt(unsafe { libc::open(c.as_ptr(), libc::OREAD | libc::OCEXEC) })?;
+    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+    let mut buf = [0u8; 256];
+    let n = fd.read(&mut buf)?;
+    Ok(String::from_utf8_lossy(&buf[..n]).into_owned())
+}
+
+fn write_ctl(dir: &str, msg: &str) -> io::Result<()> {
+    let c = CString::new(format!("{dir}/ctl")).unwrap();
+    let fd = cvt(unsafe { libc::open(c.as_ptr(), libc::OWRITE | libc::OCEXEC) })?;
+    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+    fd.write(msg.as_bytes()).map(drop)
+}
+
+/// A note "alarm" after `ms` (0: none) around `f`; its end is a timeout.
+fn with_alarm<T>(ms: u32, f: impl FnOnce() -> io::Result<T>) -> io::Result<T> {
+    if ms == 0 {
+        return f();
+    }
+    unsafe { libc::alarm(ms) };
+    let r = f();
+    unsafe { libc::alarm(0) };
+    match r {
+        Err(e) if e.kind() == io::ErrorKind::Interrupted => {
+            Err(err(io::ErrorKind::TimedOut, "timed out"))
+        }
+        r => r,
+    }
+}
+
+fn ms_of(t: Option<Duration>) -> io::Result<u32> {
+    match t {
+        None => Ok(0),
+        Some(d) if d.is_zero() => Err(io::Error::ZERO_TIMEOUT),
+        Some(d) => Ok(d.as_millis().clamp(1, u32::MAX as u128) as u32),
+    }
+}
+
+fn dur_of(ms: u32) -> Option<Duration> {
+    if ms == 0 { None } else { Some(Duration::from_millis(ms as u64)) }
+}
+
+/// The descriptor only (`os::fd` views a socket as one): timeouts and a UDP socket's
+/// peer are its `FdState`.
+pub struct Socket {
+    fd: FileDesc,
+}
+
+/// A descriptor of dial(2), announce or accept, made close-on-exec.
+fn socket_of(fd: RawFd) -> io::Result<Socket> {
+    let fd = cloexec(fd, libc::ORDWR)?;
+    set_state(fd, FdState::default());
+    Ok(Socket::new(unsafe { FileDesc::from_raw_fd(fd) }))
+}
+
+impl Socket {
+    fn new(fd: FileDesc) -> Socket {
+        Socket { fd }
+    }
+
+    fn state(&self) -> FdState {
+        state(self.fd.as_raw_fd())
+    }
+
+    fn update(&self, f: impl FnOnce(&mut FdState)) {
+        let mut s = self.state();
+        f(&mut s);
+        set_state(self.fd.as_raw_fd(), s);
+    }
+
+    /// The conversation's directory: the name of its data or ctl file without it.
+    fn dir(&self) -> io::Result<String> {
+        let mut buf = [0u8; 128];
+        cvt(unsafe {
+            libc::fd2path(self.fd.as_raw_fd(), buf.as_mut_ptr().cast(), buf.len() as i32)
+        })?;
+        let n = buf.iter().position(|&c| c == 0).unwrap_or(buf.len());
+        let p = crate::str::from_utf8(&buf[..n])
+            .map_err(|_| err(io::ErrorKind::InvalidData, "bad conversation name"))?;
+        let (dir, _) =
+            p.rsplit_once('/').ok_or(err(io::ErrorKind::InvalidData, "not a conversation"))?;
+        Ok(dir.to_owned())
+    }
+
+    fn local(&self) -> io::Result<SocketAddr> {
+        parse_addr(&read_file(&format!("{}/local", self.dir()?))?)
+    }
+
+    fn remote(&self) -> io::Result<SocketAddr> {
+        parse_addr(&read_file(&format!("{}/remote", self.dir()?))?)
+    }
+
+    fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        with_alarm(self.state().read_ms, || self.fd.read(buf))
+    }
+
+    fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        with_alarm(self.state().write_ms, || self.fd.write(buf))
+    }
+
+    fn duplicate(&self) -> io::Result<Socket> {
+        Ok(Socket::new(self.fd.duplicate()?))
+    }
+
+    fn set_read_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        let ms = ms_of(t)?;
+        self.update(|s| s.read_ms = ms);
+        Ok(())
+    }
+
+    fn set_write_timeout(&self, t: Option<Duration>) -> io::Result<()> {
+        let ms = ms_of(t)?;
+        self.update(|s| s.write_ms = ms);
+        Ok(())
+    }
+}
+
+impl AsInner<FileDesc> for Socket {
+    fn as_inner(&self) -> &FileDesc {
+        &self.fd
+    }
+}
+
+impl IntoInner<FileDesc> for Socket {
+    fn into_inner(self) -> FileDesc {
+        self.fd
+    }
+}
+
+impl FromInner<FileDesc> for Socket {
+    fn from_inner(fd: FileDesc) -> Socket {
+        Socket::new(fd)
+    }
+}
+
+impl AsFd for Socket {
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.fd.as_fd()
+    }
+}
+
+impl AsRawFd for Socket {
+    fn as_raw_fd(&self) -> RawFd {
+        self.fd.as_raw_fd()
+    }
+}
+
+impl IntoRawFd for Socket {
+    fn into_raw_fd(self) -> RawFd {
+        self.fd.into_raw_fd()
+    }
+}
+
+impl FromRawFd for Socket {
+    unsafe fn from_raw_fd(fd: RawFd) -> Socket {
+        Socket::new(unsafe { FileDesc::from_raw_fd(fd) })
+    }
+}
+
+fn each_addr<A: ToSocketAddrs, T>(
+    addr: A,
+    mut f: impl FnMut(&SocketAddr) -> io::Result<T>,
+) -> io::Result<T> {
+    let mut last = None;
+    for a in addr.to_socket_addrs()? {
+        match f(&a) {
+            Ok(t) => return Ok(t),
+            Err(e) => last = Some(e),
+        }
+    }
+    Err(last.unwrap_or(io::Error::NO_ADDRESSES))
+}
+
+fn dial(addr: &SocketAddr, ms: u32) -> io::Result<Socket> {
+    let a = netaddr("tcp", addr);
+    let fd = with_alarm(ms, || {
+        cvt(unsafe {
+            libc::dial(a.as_ptr(), crate::ptr::null(), crate::ptr::null_mut(), crate::ptr::null_mut())
+        })
+    })?;
+    socket_of(fd)
+}
+
+/* TCP */
+
+pub struct TcpStream {
+    inner: Socket,
+}
+
+impl TcpStream {
+    pub fn connect<A: ToSocketAddrs>(addr: A) -> io::Result<TcpStream> {
+        each_addr(addr, |a| dial(a, 0)).map(|inner| TcpStream { inner })
+    }
+
+    pub fn connect_timeout(addr: &SocketAddr, timeout: Duration) -> io::Result<TcpStream> {
+        dial(addr, ms_of(Some(timeout))?).map(|inner| TcpStream { inner })
+    }
+
+    pub fn socket(&self) -> &Socket {
+        &self.inner
+    }
+
+    pub fn into_socket(self) -> Socket {
+        self.inner
+    }
+
+    pub fn set_read_timeout(&self, t: Option<Duration>) -> io::Result<()> {
