+/* names: ndb's connection server */
+
+pub struct LookupHost {
+    addrs: crate::vec::IntoIter<SocketAddr>,
+}
+
+impl Iterator for LookupHost {
+    type Item = SocketAddr;
+    fn next(&mut self) -> Option<SocketAddr> {
+        self.addrs.next()
+    }
+}
+
+/// `/net/cs` translates `tcp!name!port` into lines `/net/tcp/clone 1.2.3.4!80`.
+pub fn lookup_host(host: &str, port: u16) -> io::Result<LookupHost> {
+    let fd = cvt(unsafe { libc::open(c"/net/cs".as_ptr(), libc::ORDWR | libc::OCEXEC) })?;
+    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+    let q = format!("tcp!{host}!{port}");
+    fd.write(q.as_bytes())?;
+    fd.seek(io::SeekFrom::Start(0))?;
+    let mut addrs = Vec::new();
+    let mut buf = [0u8; 512];
+    loop {
+        let n = match fd.read(&mut buf) {
+            Ok(0) => break,
+            Ok(n) => n,
+            Err(e) if addrs.is_empty() => return Err(e),
+            Err(_) => break,
+        };
+        let line = String::from_utf8_lossy(&buf[..n]);
+        if let Some((_, a)) = line.trim().split_once(' ') {
+            if let Ok(a) = parse_addr(a) {
+                if !addrs.contains(&a) {
+                    addrs.push(a);
+                }
+            }
+        }
+    }
+    Ok(LookupHost { addrs: addrs.into_iter() })
+}
