+//! Plan 9-specific extensions to primitives in the [`std::fs`] module: the fields of a
+//! file's stat(5) entry, permissions, `pread`/`pwrite`.
+//!
+//! [`std::fs`]: crate::fs
+
+#![stable(feature = "rust1", since = "1.0.0")]
+
+use crate::ffi::OsStr;
+use crate::fs::{self, DirBuilder, File, Metadata, OpenOptions, Permissions};
+use crate::io;
+use crate::sys::{AsInner, AsInnerMut, FromInner};
+
+/// The stat(5) entry of a file.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait MetadataExt {
+    /// `mode`: the permission bits and the `DM*` bits (directory, append-only, ...).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn mode(&self) -> u32;
+    /// `qid.type`: the `QT*` bits.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn qid_type(&self) -> u8;
+    /// `qid.path`: unique on its server.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn qid_path(&self) -> u64;
+    /// `qid.vers`: changes with the file.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn qid_vers(&self) -> u32;
+    /// `type`: the kernel device of the server.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn server_type(&self) -> u16;
+    /// `dev`: which of the device's servers.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn server_dev(&self) -> u32;
+    /// The owner.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn uid(&self) -> &OsStr;
+    /// The group.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn gid(&self) -> &OsStr;
+    /// Who changed it last.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn muid(&self) -> &OsStr;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl MetadataExt for Metadata {
+    fn mode(&self) -> u32 {
+        self.as_inner().mode()
+    }
+    fn qid_type(&self) -> u8 {
+        self.as_inner().qid_type()
+    }
+    fn qid_path(&self) -> u64 {
+        self.as_inner().qid_path()
+    }
+    fn qid_vers(&self) -> u32 {
+        self.as_inner().qid_vers()
+    }
+    fn server_type(&self) -> u16 {
+        self.as_inner().server_type()
+    }
+    fn server_dev(&self) -> u32 {
+        self.as_inner().server_dev()
+    }
+    fn uid(&self) -> &OsStr {
+        self.as_inner().uid()
+    }
+    fn gid(&self) -> &OsStr {
+        self.as_inner().gid()
+    }
+    fn muid(&self) -> &OsStr {
+        self.as_inner().muid()
+    }
+}
+
+/// Plan 9's file types beyond directory and file.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait FileTypeExt {
+    /// Writes go to the end (DMAPPEND).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn is_append(&self) -> bool;
+    /// One open at a time (DMEXCL).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn is_exclusive(&self) -> bool;
+    /// Not backed up (DMTMP).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn is_tmp(&self) -> bool;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl FileTypeExt for fs::FileType {
+    fn is_append(&self) -> bool {
+        self.as_inner().is_append()
+    }
+    fn is_exclusive(&self) -> bool {
+        self.as_inner().is_exclusive()
+    }
+    fn is_tmp(&self) -> bool {
+        self.as_inner().is_tmp()
+    }
+}
+
+/// The permission bits of a file's mode.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait PermissionsExt {
+    /// The mode, with the `DM*` bits.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn mode(&self) -> u32;
+    /// Sets the permission bits (0o777).
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn set_mode(&mut self, mode: u32);
+    /// Permissions of these bits.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn from_mode(mode: u32) -> Self;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl PermissionsExt for Permissions {
+    fn mode(&self) -> u32 {
+        self.as_inner().mode()
+    }
+    fn set_mode(&mut self, mode: u32) {
+        *self = Permissions::from_inner(FromInner::from_inner(mode));
+    }
+    fn from_mode(mode: u32) -> Permissions {
+        Permissions::from_inner(FromInner::from_inner(mode))
+    }
+}
+
+/// The permission of a new file.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait OpenOptionsExt {
+    /// For create(2), which takes the directory's into account; 0o666 if not set.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn mode(&mut self, mode: u32) -> &mut Self;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl OpenOptionsExt for OpenOptions {
+    fn mode(&mut self, mode: u32) -> &mut OpenOptions {
+        self.as_inner_mut().mode(mode);
+        self
+    }
+}
+
+/// The permission of a new directory.
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait DirBuilderExt {
+    /// 0o777 if not set.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn mode(&mut self, mode: u32) -> &mut Self;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl DirBuilderExt for DirBuilder {
+    fn mode(&mut self, mode: u32) -> &mut DirBuilder {
+        self.as_inner_mut().set_mode(mode);
+        self
+    }
+}
+
+/// I/O at an offset: pread(2), pwrite(2).
+#[stable(feature = "rust1", since = "1.0.0")]
+pub trait FileExt {
+    /// Reads at `offset`, not moving the file's.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn read_at(&self, buf: &mut [u8], offset: u64) -> io::Result<usize>;
+    /// Writes at `offset`, not moving the file's.
+    #[stable(feature = "rust1", since = "1.0.0")]
+    fn write_at(&self, buf: &[u8], offset: u64) -> io::Result<usize>;
+}
+
+#[stable(feature = "rust1", since = "1.0.0")]
+impl FileExt for File {
+    fn read_at(&self, buf: &mut [u8], offset: u64) -> io::Result<usize> {
+        self.as_inner().read_at(buf, offset)
+    }
+    fn write_at(&self, buf: &[u8], offset: u64) -> io::Result<usize> {
+        self.as_inner().write_at(buf, offset)
+    }
+}
