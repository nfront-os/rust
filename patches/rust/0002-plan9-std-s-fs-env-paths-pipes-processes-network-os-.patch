new file mode 100644
index 00000000000..496aa367d9f
--- /dev/null
+++ b/library/std/src/sys/paths/plan9.rs
@@ -0,0 +1,131 @@
+//! Working directory, `$path` (an rc list: NUL between the elements), `$home`, `/tmp`.
+
+use crate::ffi::{CString, OsStr, OsString};
+use crate::os::plan9::ffi::{OsStrExt, OsStringExt};
+use crate::path::{self, Path, PathBuf};
+use crate::sys::{cvt, last_error};
+use crate::{fmt, io, iter, slice};
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    let mut buf = vec![0u8; 1024];
+    loop {
+        let r = unsafe { libc::getwd(buf.as_mut_ptr().cast(), buf.len() as i32) };
+        if r.is_null() {
+            return Err(last_error());
+        }
+        let n = buf.iter().position(|&c| c == 0).unwrap_or(buf.len());
+        if n + 1 < buf.len() {
+            buf.truncate(n);
+            return Ok(PathBuf::from(OsString::from_vec(buf)));
+        }
+        let l = buf.len() * 2;
+        buf.resize(l, 0);
+    }
+}
+
+pub fn chdir(p: &path::Path) -> io::Result<()> {
+    let c = CString::new(p.as_os_str().as_bytes()).map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "file name contains a NUL byte"))?;
+    cvt(unsafe { libc::chdir(c.as_ptr()) }).map(drop)
+}
+
+pub struct SplitPaths<'a> {
+    iter: iter::Map<slice::Split<'a, u8, fn(&u8) -> bool>, fn(&'a [u8]) -> PathBuf>,
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    fn bytes_to_path(b: &[u8]) -> PathBuf {
+        PathBuf::from(<OsStr as OsStrExt>::from_bytes(b))
+    }
+    fn is_sep(b: &u8) -> bool {
+        *b == 0
+    }
+    let unparsed = unparsed.as_bytes();
+    SplitPaths {
+        iter: unparsed
+            .split(is_sep as fn(&u8) -> bool)
+            .map(bytes_to_path as fn(&[u8]) -> PathBuf),
+    }
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+    fn next(&mut self) -> Option<PathBuf> {
+        self.iter.next()
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.iter.size_hint()
+    }
+}
+
+pub struct SplitPathsRef<'a> {
+    iter: slice::Split<'a, u8, fn(&u8) -> bool>,
+}
+
+pub fn split_paths_ref(unparsed: &OsStr) -> Option<SplitPathsRef<'_>> {
+    fn is_sep(b: &u8) -> bool {
+        *b == 0
+    }
+    Some(SplitPathsRef { iter: unparsed.as_bytes().split(is_sep as fn(&u8) -> bool) })
+}
+
+impl<'a> Iterator for SplitPathsRef<'a> {
+    type Item = &'a Path;
+    fn next(&mut self) -> Option<&'a Path> {
+        self.iter.next().map(|b| Path::new(<OsStr as OsStrExt>::from_bytes(b)))
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut joined = Vec::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref().as_bytes();
+        if i > 0 {
+            joined.push(0);
+        }
+        if path.contains(&0) {
+            return Err(JoinPathsError);
+        }
+        joined.extend_from_slice(path);
+    }
+    Ok(OsStringExt::from_vec(joined))
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        "path segment contains a NUL byte".fmt(f)
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+/// Plan 9 keeps no name of the program a proc runs: argv[0], absolute, looked up in
+/// `$path` when it has no slash (as rc does).
+pub fn current_exe() -> io::Result<PathBuf> {
+    let arg0 = crate::env::args_os()
+        .next()
+        .ok_or(io::const_error!(io::ErrorKind::NotFound, "no argv[0]"))?;
+    let p = PathBuf::from(&arg0);
+    let found = if arg0.as_bytes().contains(&b'/') {
+        Some(p)
+    } else {
+        let path = crate::env::var_os("path").unwrap_or_else(|| OsString::from("/bin"));
+        split_paths(&path).map(|d| d.join(&p)).find(|c| crate::sys::fs::exists(c).unwrap_or(false))
+    };
+    let found = found.ok_or(io::const_error!(io::ErrorKind::NotFound, "program not found"))?;
+    if found.is_absolute() { Ok(found) } else { Ok(getcwd()?.join(found)) }
+}
+
+pub fn temp_dir() -> PathBuf {
+    crate::env::var_os("TMPDIR").map(PathBuf::from).unwrap_or_else(|| PathBuf::from("/tmp"))
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    crate::env::var_os("home").or_else(|| crate::env::var_os("HOME")).map(PathBuf::from)
+}
