+    "   movq %rdi, 8(%rsp)",
+    "   movq $19, %rbp", // RFORK
+    "   syscall",
+    "   testq %rax, %rax",
+    "   jz 1f",
+    "   addq $16, %rsp",
+    "   popq %r15",
+    "   popq %r14",
+    "   popq %r13",
+    "   popq %r12",
+    "   popq %rbp",
+    "   popq %rbx",
+    "   ret",
+    "1: movq %r14, %rsp",
+    "   movq %r15, %rdi",
+    "   call *(%r15)",
+    "2: jmp 2b",
     options(att_syntax)
 );
 
+/// What a child of [`rfork_run`] runs: `f(self)`, which must not return.
+#[repr(C)]
+pub struct Run<T> {
+    pub f: unsafe extern "C" fn(*const Run<T>) -> !,
+    pub data: T,
+}
+
+/// `rfork(flags)` of a child that runs, on its own stack segment, `run.f(run)`: it touches
+/// nothing of its parent's stack, which is shared memory (a stack slot) even without
+/// RFMEM. `run` stays the parent's until the child is done with it; the child's memory is
+/// a copy: it must not take a lock (malloc's) another thread may have held at the fork.
+pub unsafe fn rfork_run<T>(flags: i32, run: &Run<T>) -> i32 {
+    set_privtop_here();
+    unsafe { __rust_plan9_rforkrun(flags, PRIVTOP.load(SeqCst), (run as *const Run<T>).cast()) }
+}
+
 fn align_down(p: usize) -> usize {
     p & !15
 }
