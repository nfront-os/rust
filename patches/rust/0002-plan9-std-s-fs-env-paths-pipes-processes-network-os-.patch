new file mode 100644
index 00000000000..b48de364dcd
--- /dev/null
+++ b/library/std/src/sys/fd/plan9.rs
@@ -0,0 +1,207 @@
+//! A file descriptor of 9front's: read(2), pread, seek, dup.
+
+#![unstable(reason = "not public", issue = "none", feature = "fd")]
+
+use crate::collections::BTreeMap;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, Read, SeekFrom};
+use crate::sync::Mutex;
+use crate::sync::atomic::{AtomicBool, Ordering};
+use crate::os::plan9::io::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, OwnedFd, RawFd};
+use crate::sys::{AsInner, FromInner, IntoInner, cvt};
+
+/// What a descriptor has beyond the kernel's, kept beside it (a `File` or `TcpStream` is
+/// only its descriptor, `os::fd` views them as such): the append mode of a file (Plan 9's
+/// open has none), timeouts of a connection, the peer of a "connected" UDP socket. Who makes
+/// a descriptor sets it, closing it drops it.
+#[derive(Clone, Copy, Default, Debug)]
+pub struct FdState {
+    pub append: bool,
+    pub read_ms: u32,
+    pub write_ms: u32,
+    pub peer: Option<crate::net::SocketAddr>,
+}
+
+static STATES: Mutex<BTreeMap<RawFd, FdState>> = Mutex::new(BTreeMap::new());
+static ANY_STATE: AtomicBool = AtomicBool::new(false);
+
+pub fn state(fd: RawFd) -> FdState {
+    if !ANY_STATE.load(Ordering::Relaxed) {
+        return FdState::default();
+    }
+    STATES.lock().unwrap_or_else(|e| e.into_inner()).get(&fd).copied().unwrap_or_default()
+}
+
+pub fn set_state(fd: RawFd, s: FdState) {
+    let mut t = STATES.lock().unwrap_or_else(|e| e.into_inner());
+    if s.append || s.read_ms != 0 || s.write_ms != 0 || s.peer.is_some() {
+        t.insert(fd, s);
+        ANY_STATE.store(true, Ordering::Relaxed);
+    } else {
+        t.remove(&fd);
+    }
+}
+
+/// The descriptor is closed (OwnedFd's drop).
+pub fn forget_state(fd: RawFd) {
+    if ANY_STATE.load(Ordering::Relaxed) {
+        STATES.lock().unwrap_or_else(|e| e.into_inner()).remove(&fd);
+    }
+}
+
+/// A copy of `fd` that closes on exec (an open of dup(3)'s `#d/n` with OCEXEC; pipe(2) and
+/// dial(2) give none), in place of it.
+pub fn cloexec(fd: RawFd, mode: i32) -> io::Result<RawFd> {
+    let path = crate::ffi::CString::new(format!("#d/{fd}")).unwrap();
+    let n = unsafe { libc::open(path.as_ptr(), mode | libc::OCEXEC) };
+    let r = if n < 0 { Err(crate::sys::last_error()) } else { Ok(n) };
+    unsafe { libc::close(fd) };
+    r
+}
+
+#[derive(Debug)]
+pub struct FileDesc {
+    fd: OwnedFd,
+}
+
+/// read(2) takes a `long`; the kernel's i/o is at most a few MB at a time anyway.
+const MAX_IO: usize = i32::MAX as usize;
+
+impl FileDesc {
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        let n = buf.len().min(MAX_IO);
+        let r = cvt(unsafe { libc::read(self.as_raw_fd(), buf.as_mut_ptr().cast(), n as _) })?;
+        Ok(r as usize)
+    }
+
+    pub fn read_buf(&self, mut cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        let n = cursor.capacity().min(MAX_IO);
+        let r = cvt(unsafe {
+            libc::read(self.as_raw_fd(), cursor.as_mut().as_mut_ptr().cast(), n as _)
+        })?;
+        unsafe { cursor.advance(r as usize) };
+        Ok(())
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        io::default_read_vectored(|b| self.read(b), bufs)
+    }
+
+    #[inline]
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_to_end(&self, buf: &mut Vec<u8>) -> io::Result<usize> {
+        let mut me = self;
+        (&mut me).read_to_end(buf)
+    }
+
+    pub fn read_at(&self, buf: &mut [u8], offset: u64) -> io::Result<usize> {
+        let n = buf.len().min(MAX_IO);
+        let r = cvt(unsafe {
+            libc::pread(self.as_raw_fd(), buf.as_mut_ptr().cast(), n as _, offset as i64)
+        })?;
+        Ok(r as usize)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        let n = buf.len().min(MAX_IO);
+        let r = cvt(unsafe { libc::write(self.as_raw_fd(), buf.as_ptr().cast(), n as _) })?;
+        Ok(r as usize)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    #[inline]
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn write_at(&self, buf: &[u8], offset: u64) -> io::Result<usize> {
+        let n = buf.len().min(MAX_IO);
+        let r = cvt(unsafe {
+            libc::pwrite(self.as_raw_fd(), buf.as_ptr().cast(), n as _, offset as i64)
+        })?;
+        Ok(r as usize)
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let (whence, pos) = match pos {
+            SeekFrom::Start(off) => (libc::SEEK_SET, off as i64),
+            SeekFrom::End(off) => (libc::SEEK_END, off),
+            SeekFrom::Current(off) => (libc::SEEK_CUR, off),
+        };
+        let n = cvt(unsafe { libc::seek(self.as_raw_fd(), pos, whence) })?;
+        Ok(n as u64)
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        self.seek(SeekFrom::Current(0))
+    }
+
+    pub fn duplicate(&self) -> io::Result<FileDesc> {
+        let fd = Self { fd: self.fd.try_clone()? };
+        set_state(fd.as_raw_fd(), state(self.as_raw_fd()));
+        Ok(fd)
+    }
+
+    pub fn try_clone(&self) -> io::Result<FileDesc> {
+        self.duplicate()
+    }
+}
+
+impl<'a> Read for &'a FileDesc {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        (**self).read(buf)
+    }
+
+    fn read_buf(&mut self, cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        (**self).read_buf(cursor)
+    }
+}
+
+impl AsInner<OwnedFd> for FileDesc {
+    #[inline]
+    fn as_inner(&self) -> &OwnedFd {
+        &self.fd
+    }
+}
+
+impl IntoInner<OwnedFd> for FileDesc {
+    fn into_inner(self) -> OwnedFd {
+        self.fd
+    }
+}
+
+impl FromInner<OwnedFd> for FileDesc {
+    fn from_inner(owned_fd: OwnedFd) -> Self {
+        Self { fd: owned_fd }
+    }
+}
+
+impl AsFd for FileDesc {
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.fd.as_fd()
+    }
+}
+
+impl AsRawFd for FileDesc {
+    #[inline]
+    fn as_raw_fd(&self) -> RawFd {
+        self.fd.as_raw_fd()
+    }
+}
+
+impl IntoRawFd for FileDesc {
+    fn into_raw_fd(self) -> RawFd {
+        self.fd.into_raw_fd()
+    }
+}
+
+impl FromRawFd for FileDesc {
+    unsafe fn from_raw_fd(raw_fd: RawFd) -> Self {
+        Self { fd: unsafe { FromRawFd::from_raw_fd(raw_fd) } }
+    }
+}
