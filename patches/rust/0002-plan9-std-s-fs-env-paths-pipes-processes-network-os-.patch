+//! pipe(2): both ends read and write; here the first is read, the second written.
+
+use crate::io;
+use crate::os::plan9::io::FromRawFd;
+use crate::sys::cvt;
+use crate::sys::fd::FileDesc;
+
+pub type Pipe = FileDesc;
+
+pub fn pipe() -> io::Result<(Pipe, Pipe)> {
+    let mut fds = [0; 2];
+    cvt(unsafe { libc::pipe(fds.as_mut_ptr()) })?;
+    // close on exec, as every descriptor std makes
+    let r = crate::sys::fd::cloexec(fds[0], libc::ORDWR);
+    let w = crate::sys::fd::cloexec(fds[1], libc::ORDWR);
+    match (r, w) {
+        (Ok(r), Ok(w)) => unsafe { Ok((FileDesc::from_raw_fd(r), FileDesc::from_raw_fd(w))) },
+        (r, w) => {
+            for fd in [r.as_ref().ok(), w.as_ref().ok()].into_iter().flatten() {
+                unsafe { libc::close(*fd) };
+            }
+            Err(r.err().or(w.err()).unwrap())
+        }
+    }
+}
