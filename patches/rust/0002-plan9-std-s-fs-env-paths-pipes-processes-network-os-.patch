+++ b/library/std/src/sys/fs/plan9.rs
@@ -0,0 +1,896 @@
+//! Files of 9front: open(2), create, the directory entries of stat(5) (`Dir`: dirstat,
+//! dirfstat, dirwstat, dirread).
+//!
+//! What Plan 9 has not: links (hard or symbolic), file locks, fsync (a write is done when
+//! the file server answers it), an append mode of open (a file can be append-only, DMAPPEND;
+//! here a write in append mode seeks to the end first). A rename (a wstat of the name) stays
+//! in its directory and does not replace a file; across directories a file is copied and
+//! removed.
+
+use crate::ffi::{CStr, CString, OsStr, OsString};
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::{Hash, Hasher};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::os::plan9::ffi::{OsStrExt, OsStringExt};
+use crate::os::plan9::io::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, RawFd};
+use crate::path::{Path, PathBuf};
+use crate::sync::Arc;
+pub use crate::sys::fs::common::{Dir, ExtraHomeDirs, ExtraMediaDirs, copy, exists};
+use crate::sys::fd::{FdState, FileDesc, set_state, state};
+use crate::sys::time::SystemTime;
+use crate::sys::{AsInner, AsInnerMut, FromInner, IntoInner, cvt, last_error, unsupported};
+use crate::{mem, ptr};
+
+fn cstr(p: &Path) -> io::Result<CString> {
+    CString::new(p.as_os_str().as_bytes()).map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "file name contains a NUL byte"))
+}
+
+fn no_links() -> io::Error {
+    io::const_error!(io::ErrorKind::Unsupported, "Plan 9 has no links")
+}
+
+pub struct File(FileDesc);
+
+#[derive(Clone)]
+pub struct FileAttr {
+    mode: u32,
+    qtype: u8,
+    length: u64,
+    atime: u32,
+    mtime: u32,
+    /// server type, subtype, qid path and version
+    ty: u16,
+    dev: u32,
+    qpath: u64,
+    vers: u32,
+    uid: Arc<OsStr>,
+    gid: Arc<OsStr>,
+    muid: Arc<OsStr>,
+}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    mode: u32,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    mode: u32,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {
+    accessed: Option<SystemTime>,
+    modified: Option<SystemTime>,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+    mode: u32,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {
+    mode: u32,
+}
+
+pub struct ReadDir {
+    root: Arc<PathBuf>,
+    fd: FileDesc,
+    buf: *mut libc::Dir,
+    n: usize,
+    i: usize,
+    end: bool,
+}
+
+unsafe impl Send for ReadDir {}
+unsafe impl Sync for ReadDir {}
+
+pub struct DirEntry {
+    root: Arc<PathBuf>,
+    name: OsString,
+    attr: FileAttr,
+}
+
+unsafe fn str_of(p: *const libc::c_char) -> Arc<OsStr> {
+    if p.is_null() {
+        return Arc::from(OsStr::new(""));
+    }
+    Arc::from(OsStr::from_bytes(unsafe { CStr::from_ptr(p) }.to_bytes()))
+}
+
+impl FileAttr {
+    unsafe fn from_dir(d: *const libc::Dir) -> FileAttr {
+        unsafe {
+            let d = &*d;
+            FileAttr {
+                mode: d.mode,
+                qtype: d.qid.type_,
+                length: d.length as u64,
+                atime: d.atime,
+                mtime: d.mtime,
+                ty: d.type_,
+                dev: d.dev,
+                qpath: d.qid.path,
+                vers: d.qid.vers,
+                uid: str_of(d.uid),
+                gid: str_of(d.gid),
+                muid: str_of(d.muid),
+            }
+        }
+    }
+
+    pub fn size(&self) -> u64 {
+        self.length
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { mode: self.mode }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType { mode: self.mode }
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(SystemTime::from_secs(self.mtime))
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        Ok(SystemTime::from_secs(self.atime))
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        unsupported()
+    }
+
+    /* os::plan9::fs::MetadataExt */
+    pub fn mode(&self) -> u32 {
+        self.mode
+    }
+    pub fn qid_type(&self) -> u8 {
+        self.qtype
+    }
+    pub fn qid_path(&self) -> u64 {
+        self.qpath
+    }
+    pub fn qid_vers(&self) -> u32 {
+        self.vers
+    }
+    pub fn server_type(&self) -> u16 {
+        self.ty
+    }
+    pub fn server_dev(&self) -> u32 {
+        self.dev
+    }
+    pub fn uid(&self) -> &OsStr {
+        &self.uid
+    }
+    pub fn gid(&self) -> &OsStr {
+        &self.gid
+    }
+    pub fn muid(&self) -> &OsStr {
+        &self.muid
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.mode & 0o222 == 0
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        if readonly {
+            self.mode &= !0o222;
+        } else {
+            self.mode |= 0o222;
+        }
+    }
+
+    pub fn mode(&self) -> u32 {
+        self.mode
+    }
+}
+
+impl FromInner<u32> for FilePermissions {
+    fn from_inner(mode: u32) -> FilePermissions {
+        FilePermissions { mode }
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, t: SystemTime) {
+        self.accessed = Some(t);
+    }
+
+    pub fn set_modified(&mut self, t: SystemTime) {
+        self.modified = Some(t);
+    }
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.mode & libc::DMDIR != 0
+    }
+
+    pub fn is_file(&self) -> bool {
+        !self.is_dir() && self.mode & (libc::DMAUTH | libc::DMMOUNT) == 0
+    }
+
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+
+    pub fn is_append(&self) -> bool {
+        self.mode & libc::DMAPPEND != 0
+    }
+
+    pub fn is_exclusive(&self) -> bool {
+        self.mode & libc::DMEXCL != 0
+    }
+
+    pub fn is_tmp(&self) -> bool {
+        self.mode & libc::DMTMP != 0
+    }
+}
+
+impl fmt::Debug for FileAttr {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FileAttr")
+            .field("mode", &format_args!("{:#o}", self.mode))
+            .field("length", &self.length)
+            .field("mtime", &self.mtime)
+            .field("uid", &self.uid)
+            .finish_non_exhaustive()
+    }
+}
+
+/* directories */
+
+impl ReadDir {
+    pub fn dir(&self) -> io::Result<Dir> {
+        Dir::open_for_traversal(&self.root)
+    }
+
+    fn fill(&mut self) -> io::Result<bool> {
+        unsafe {
+            if !self.buf.is_null() {
+                libc::free(self.buf.cast());
+                self.buf = ptr::null_mut();
+            }
+            let n = libc::dirread(self.fd.as_raw_fd(), &mut self.buf);
+            if n < 0 {
+                return Err(last_error());
+            }
+            self.n = n as usize;
+            self.i = 0;
+            Ok(n > 0)
+        }
+    }
+}
+
+impl Drop for ReadDir {
+    fn drop(&mut self) {
+        if !self.buf.is_null() {
+            unsafe { libc::free(self.buf.cast()) };
+        }
+    }
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        fmt::Debug::fmt(&*self.root, f)
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        if self.end {
+            return None;
+        }
+        if self.i >= self.n {
+            match self.fill() {
+                Ok(true) => {}
+                Ok(false) => {
+                    self.end = true;
+                    return None;
+                }
+                Err(e) => {
+                    self.end = true;
+                    return Some(Err(e));
+                }
+            }
+        }
+        unsafe {
+            let d = self.buf.add(self.i);
+            self.i += 1;
+            let name = OsString::from_vec(CStr::from_ptr((*d).name).to_bytes().to_vec());
+            Some(Ok(DirEntry { root: self.root.clone(), name, attr: FileAttr::from_dir(d) }))
+        }
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.root.join(&self.name)
+    }
+
+    pub fn file_name(&self) -> OsString {
+        self.name.clone()
+    }
+
+    /// The entry's own: a directory's entries are its files' stat(5) entries.
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        Ok(self.attr.clone())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.attr.file_type())
+    }
+}
+
+pub fn readdir(p: &Path) -> io::Result<ReadDir> {
+    let c = cstr(p)?;
+    let fd = cvt(unsafe { libc::open(c.as_ptr(), libc::OREAD | libc::OCEXEC) })?;
+    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+    let attr = dirfstat(fd.as_raw_fd())?;
+    if !attr.file_type().is_dir() {
+        return Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"));
+    }
+    Ok(ReadDir {
+        root: Arc::new(p.to_path_buf()),
+        fd,
+        buf: ptr::null_mut(),
+        n: 0,
+        i: 0,
+        end: false,
+    })
+}
+
+/* files */
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions {
+            read: false,
+            write: false,
+            append: false,
+            truncate: false,
+            create: false,
+            create_new: false,
+            mode: 0o666,
+        }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read;
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write;
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append;
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate;
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create;
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new;
+    }
+    /// The permission of a new file (create(2) takes the directory's into account).
+    pub fn mode(&mut self, mode: u32) {
+        self.mode = mode;
+    }
+
+    fn omode(&self) -> io::Result<i32> {
+        let write = self.write || self.append;
+        let mut m = match (self.read, write) {
+            (true, false) => libc::OREAD,
+            (false, true) => libc::OWRITE,
+            (true, true) => libc::ORDWR,
+            (false, false) => return Err(io::Error::from(io::ErrorKind::InvalidInput)),
+        };
+        if self.truncate || self.create || self.create_new {
+            if !write {
+                return Err(io::Error::from(io::ErrorKind::InvalidInput));
+            }
+        }
+        if self.truncate && !self.append {
+            m |= libc::OTRUNC;
+        }
+        Ok(m | libc::OCEXEC)
+    }
+}
+
+fn dirfstat(fd: RawFd) -> io::Result<FileAttr> {
+    unsafe {
+        let d = libc::dirfstat(fd);
+        if d.is_null() {
+            return Err(last_error());
+        }
+        let a = FileAttr::from_dir(d);
+        libc::free(d.cast());
+        Ok(a)
+    }
+}
+
+/// A Dir that changes nothing (nulldir), changed by `f`, written with `w`.
+fn wstat(f: impl FnOnce(&mut libc::Dir), w: impl FnOnce(*mut libc::Dir) -> i32) -> io::Result<()> {
+    unsafe {
+        let mut d: libc::Dir = mem::zeroed();
+        libc::nulldir(&mut d);
+        f(&mut d);
+        cvt(w(&mut d)).map(drop)
+    }
+}
+
+fn times(times: &FileTimes, d: &mut libc::Dir) {
+    if let Some(t) = times.accessed {
+        d.atime = t.to_secs();
+    }
+    if let Some(t) = times.modified {
+        d.mtime = t.to_secs();
+    }
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let c = cstr(path)?;
+        let omode = opts.omode()?;
+        let perm = opts.mode & 0o777;
+        let fd = unsafe {
+            if opts.create_new {
+                // create(2) of an existing file truncates it; OEXCL refuses it
+                cvt(libc::create(c.as_ptr(), omode | libc::OEXCL, perm))?
+            } else if opts.create {
+                loop {
+                    let fd = libc::open(c.as_ptr(), omode);
+                    if fd >= 0 {
+                        break fd;
+                    }
+                    let e = last_error();
+                    if e.kind() != io::ErrorKind::NotFound {
+                        return Err(e);
+                    }
+                    let fd = libc::create(c.as_ptr(), omode | libc::OEXCL, perm);
+                    if fd >= 0 {
+                        break fd;
+                    }
+                    let e = last_error();
+                    if e.kind() != io::ErrorKind::AlreadyExists {
+                        return Err(e);
+                    }
+                    // made meanwhile: open it
+                }
+            } else {
+                cvt(libc::open(c.as_ptr(), omode))?
+            }
+        };
+        let f = File(unsafe { FileDesc::from_raw_fd(fd) });
+        set_state(fd, FdState { append: opts.append, ..FdState::default() });
+        Ok(f)
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        dirfstat(self.0.as_raw_fd())
+    }
+
+    /// The file server has every write when it answers it.
+    pub fn fsync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Err(TryLockError::Error(io::Error::UNSUPPORTED_PLATFORM))
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Err(TryLockError::Error(io::Error::UNSUPPORTED_PLATFORM))
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        let fd = self.0.as_raw_fd();
+        wstat(|d| d.length = size as i64, |d| unsafe { libc::dirfwstat(fd, d) })
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        self.0.read(buf)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        self.0.read_vectored(bufs)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        self.0.is_read_vectored()
+    }
+
+    pub fn read_buf(&self, cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        self.0.read_buf(cursor)
+    }
+
+    pub fn read_at(&self, buf: &mut [u8], offset: u64) -> io::Result<usize> {
+        self.0.read_at(buf, offset)
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        if state(self.0.as_raw_fd()).append {
+            self.0.seek(SeekFrom::End(0))?;
+        }
+        self.0.write(buf)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn write_at(&self, buf: &[u8], offset: u64) -> io::Result<usize> {
+        self.0.write_at(buf, offset)
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        self.0.seek(pos)
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(self.file_attr().map(|a| a.size()))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        self.0.tell()
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        Ok(File(self.0.duplicate()?))
+    }
+
+    pub fn set_permissions(&self, perm: FilePermissions) -> io::Result<()> {
+        let old = self.file_attr()?.mode;
+        let fd = self.0.as_raw_fd();
+        wstat(|d| d.mode = (old & !0o777) | (perm.mode & 0o777), |d| unsafe {
+            libc::dirfwstat(fd, d)
+        })
+    }
+
+    pub fn set_times(&self, t: FileTimes) -> io::Result<()> {
+        let fd = self.0.as_raw_fd();
+        wstat(|d| times(&t, d), |d| unsafe { libc::dirfwstat(fd, d) })
+    }
+
+    /// The name it was opened by (fd2path(2)).
+    pub fn path(&self) -> io::Result<PathBuf> {
+        fd2path(self.0.as_raw_fd())
+    }
+}
+
+fn fd2path(fd: RawFd) -> io::Result<PathBuf> {
+    let mut buf = vec![0u8; 1024];
+    loop {
+        cvt(unsafe { libc::fd2path(fd, buf.as_mut_ptr().cast(), buf.len() as i32) })?;
+        let n = buf.iter().position(|&c| c == 0).unwrap_or(buf.len());
+        if n + 1 < buf.len() {
+            buf.truncate(n);
+            return Ok(PathBuf::from(OsString::from_vec(buf)));
+        }
+        let l = buf.len() * 2;
+        buf.resize(l, 0);
+    }
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder { mode: 0o777 }
+    }
+
+    pub fn set_mode(&mut self, mode: u32) {
+        self.mode = mode;
+    }
+
+    pub fn mkdir(&self, p: &Path) -> io::Result<()> {
+        let c = cstr(p)?;
+        let fd = cvt(unsafe {
+            libc::create(c.as_ptr(), libc::OREAD | libc::OEXCL, libc::DMDIR | (self.mode & 0o777))
+        })?;
+        unsafe { libc::close(fd) };
+        Ok(())
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let mut b = f.debug_struct("File");
+        b.field("fd", &self.0.as_raw_fd());
+        if let Ok(path) = self.path() {
+            b.field("path", &path);
+        }
+        b.finish()
+    }
+}
+
+impl AsInner<FileDesc> for File {
+    #[inline]
+    fn as_inner(&self) -> &FileDesc {
+        &self.0
+    }
+}
+
+impl AsInnerMut<FileDesc> for File {
+    #[inline]
+    fn as_inner_mut(&mut self) -> &mut FileDesc {
+        &mut self.0
+    }
+}
+
+impl IntoInner<FileDesc> for File {
+    fn into_inner(self) -> FileDesc {
+        self.0
+    }
+}
+
+impl FromInner<FileDesc> for File {
+    fn from_inner(fd: FileDesc) -> File {
+        File(fd)
+    }
+}
+
+impl AsFd for File {
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.0.as_fd()
+    }
+}
+
+impl AsRawFd for File {
+    #[inline]
+    fn as_raw_fd(&self) -> RawFd {
+        self.0.as_raw_fd()
+    }
+}
+
+impl IntoRawFd for File {
+    fn into_raw_fd(self) -> RawFd {
+        self.0.into_raw_fd()
+    }
+}
+
+impl FromRawFd for File {
+    unsafe fn from_raw_fd(raw_fd: RawFd) -> Self {
+        File(unsafe { FileDesc::from_raw_fd(raw_fd) })
+    }
+}
+
+impl Hash for FileAttr {
+    fn hash<H: Hasher>(&self, h: &mut H) {
+        (self.ty, self.dev, self.qpath).hash(h)
+    }
+}
+
+/* paths */
+
+pub fn stat(p: &Path) -> io::Result<FileAttr> {
+    let c = cstr(p)?;
+    unsafe {
+        let d = libc::dirstat(c.as_ptr());
+        if d.is_null() {
+            return Err(last_error());
+        }
+        let a = FileAttr::from_dir(d);
+        libc::free(d.cast());
+        Ok(a)
+    }
+}
+
+/// No symbolic links: the file itself.
+pub fn lstat(p: &Path) -> io::Result<FileAttr> {
+    stat(p)
+}
+
+fn remove(p: &Path) -> io::Result<()> {
+    let c = cstr(p)?;
+    cvt(unsafe { libc::remove(c.as_ptr()) }).map(drop)
+}
+
+/// remove(2) takes files and empty directories: a directory is refused here.
+pub fn unlink(p: &Path) -> io::Result<()> {
+    if stat(p)?.file_type().is_dir() {
+        return Err(io::const_error!(io::ErrorKind::IsADirectory, "is a directory"));
+    }
+    remove(p)
+}
+
+pub fn rmdir(p: &Path) -> io::Result<()> {
+    if !stat(p)?.file_type().is_dir() {
+        return Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"));
+    }
+    remove(p)
+}
+
+pub fn remove_dir_all(path: &Path) -> io::Result<()> {
+    crate::sys::fs::common::remove_dir_all(path)
+}
+
+fn parent(p: &Path) -> &Path {
+    match p.parent() {
+        Some(d) if !d.as_os_str().is_empty() => d,
+        _ => Path::new("."),
+    }
+}
+
+fn same_file(a: &FileAttr, b: &FileAttr) -> bool {
+    (a.ty, a.dev, a.qpath) == (b.ty, b.dev, b.qpath)
+}
+
+fn rename_impl(old: &Path, new: &Path, replace: bool) -> io::Result<()> {
+    let from = stat(old)?;
+    let target = stat(new);
+    if let Ok(t) = &target {
+        if same_file(&from, t) {
+            return Ok(());
+        }
+        if !replace {
+            return Err(io::const_error!(io::ErrorKind::AlreadyExists, "file exists"));
+        }
+        if t.file_type().is_dir() != from.file_type().is_dir() {
+            return Err(if t.file_type().is_dir() {
+                io::const_error!(io::ErrorKind::IsADirectory, "is a directory")
+            } else {
+                io::const_error!(io::ErrorKind::NotADirectory, "not a directory")
+            });
+        }
+    }
+    let Some(name) = new.file_name() else {
+        return Err(io::Error::from(io::ErrorKind::InvalidInput));
+    };
+    if same_file(&stat(parent(old))?, &stat(parent(new))?) {
+        // the same directory: a wstat of the name, which refuses an existing one
+        if target.is_ok() {
+            remove(new)?;
+        }
+        let c = cstr(old)?;
+        let n = CString::new(name.as_bytes()).map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "file name contains a NUL byte"))?;
+        return wstat(|d| d.name = n.as_ptr().cast_mut(), |d| unsafe {
+            libc::dirwstat(c.as_ptr(), d)
+        });
+    }
+    if from.file_type().is_dir() {
+        return Err(io::const_error!(
+            io::ErrorKind::CrossesDevices,
+            "Plan 9 renames a directory only in its directory",
+        ));
+    }
+    // another directory: copied with its permissions and times, the old one removed
+    let mut src = File::open(old, &{
+        let mut o = OpenOptions::new();
+        o.read(true);
+        o
+    })?;
+    let mut o = OpenOptions::new();
+    o.write(true);
+    o.truncate(true);
+    o.create(true);
+    o.mode(from.mode & 0o777);
+    let mut dst = File::open(new, &o)?;
+    io::copy(&mut FileRw(&mut src), &mut FileRw(&mut dst))?;
+    dst.set_times(FileTimes {
+        accessed: Some(SystemTime::from_secs(from.atime)),
+        modified: Some(SystemTime::from_secs(from.mtime)),
+    })?;
+    remove(old)
+}
+
+struct FileRw<'a>(&'a mut File);
+
+impl io::Read for FileRw<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.0.read(buf)
+    }
+}
+
+impl io::Write for FileRw<'_> {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.0.write(buf)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    rename_impl(old, new, true)
+}
+
+pub fn rename_noreplace(old: &Path, new: &Path) -> io::Result<()> {
+    rename_impl(old, new, false)
+}
+
+pub fn set_perm(p: &Path, perm: FilePermissions) -> io::Result<()> {
+    let old = stat(p)?.mode;
+    let c = cstr(p)?;
+    wstat(|d| d.mode = (old & !0o777) | (perm.mode & 0o777), |d| unsafe {
+        libc::dirwstat(c.as_ptr(), d)
+    })
+}
+
+pub fn set_perm_nofollow(p: &Path, perm: FilePermissions) -> io::Result<()> {
+    set_perm(p, perm)
+}
+
+pub fn set_times(p: &Path, t: FileTimes) -> io::Result<()> {
+    let c = cstr(p)?;
+    wstat(|d| times(&t, d), |d| unsafe { libc::dirwstat(c.as_ptr(), d) })
+}
+
+pub fn set_times_nofollow(p: &Path, t: FileTimes) -> io::Result<()> {
+    set_times(p, t)
+}
+
+pub fn readlink(_p: &Path) -> io::Result<PathBuf> {
+    Err(no_links())
+}
+
+pub fn symlink(_original: &Path, _link: &Path) -> io::Result<()> {
+    Err(no_links())
+}
+
+pub fn link(_src: &Path, _dst: &Path) -> io::Result<()> {
+    Err(no_links())
+}
+
+/// The name the kernel has for it (fd2path(2) of the file opened), else cleaned up
+/// against the working directory.
+pub fn canonicalize(p: &Path) -> io::Result<PathBuf> {
+    let c = cstr(p)?;
+    let fd = unsafe { libc::open(c.as_ptr(), libc::OREAD | libc::OCEXEC) };
+    if fd >= 0 {
+        let fd = unsafe { FileDesc::from_raw_fd(fd) };
+        return fd2path(fd.as_raw_fd());
+    }
+    stat(p)?;
+    let abs = if p.is_absolute() { p.to_path_buf() } else { crate::env::current_dir()?.join(p) };
+    let mut out = PathBuf::from("/");
+    for c in abs.components() {
+        match c {
+            crate::path::Component::ParentDir => {
+                out.pop();
+            }
+            crate::path::Component::Normal(n) => out.push(n),
+            _ => {}
+        }
+    }
+    Ok(out)
+}
