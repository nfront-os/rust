+/* UDP */
+
+const UDP_HDR: usize = 52;
+
+fn put_addr(b: &mut [u8], a: &SocketAddr) {
+    let ip = match a {
+        SocketAddr::V4(v4) => v4.ip().to_ipv6_mapped(),
+        SocketAddr::V6(v6) => *v6.ip(),
+    };
+    b[..16].copy_from_slice(&ip.octets());
+}
+
+fn get_addr(b: &[u8], port: &[u8]) -> SocketAddr {
+    let mut o = [0u8; 16];
+    o.copy_from_slice(&b[..16]);
+    let ip = Ipv6Addr::from(o);
+    let port = u16::from_be_bytes([port[0], port[1]]);
+    match ip.to_ipv4_mapped() {
+        Some(v4) => SocketAddr::V4(SocketAddrV4::new(v4, port)),
+        None => SocketAddr::V6(SocketAddrV6::new(ip, port, 0, 0)),
+    }
+}
+
+/// The data file, with headers; connect's address (for send and recv) is its `FdState`.
+pub struct UdpSocket {
+    inner: Socket,
+}
+
+impl UdpSocket {
+    pub fn bind<A: ToSocketAddrs>(addr: A) -> io::Result<UdpSocket> {
+        each_addr(addr, |a| {
+            let n = netaddr("udp", a);
+            let mut dir = [0u8; 40];
+            let cfd = cvt(unsafe { libc::announce(n.as_ptr(), dir.as_mut_ptr().cast()) })?;
+            let cfd = unsafe { FileDesc::from_raw_fd(cfd) };
+            cfd.write(b"headers")?;
+            let n = dir.iter().position(|&c| c == 0).unwrap_or(dir.len());
+            let mut data = dir[..n].to_vec();
+            data.extend_from_slice(b"/data");
+            let data = CString::new(data).unwrap();
+            let fd = cvt(unsafe { libc::open(data.as_ptr(), libc::ORDWR | libc::OCEXEC) })?;
+            set_state(fd, FdState::default());
+            Ok(UdpSocket { inner: Socket::new(unsafe { FileDesc::from_raw_fd(fd) }) })
+        })
+    }
+
+    pub fn socket(&self) -> &Socket {
+        &self.inner
+    }
+
+    pub fn into_socket(self) -> Socket {
+        self.inner
+    }
+
+    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.state().peer.ok_or(io::const_error!(io::ErrorKind::NotConnected, "not connected"))
+    }
+
+    pub fn socket_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.local()
+    }
+
+    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
+        let mut b = vec![0u8; UDP_HDR + buf.len()];
+        loop {
+            let n = self.inner.read(&mut b)?;
+            if n < UDP_HDR {
+                return Err(err(io::ErrorKind::InvalidData, "short udp header"));
+            }
+            let from = get_addr(&b[0..16], &b[48..50]);
+            // a connected socket takes only its peer's
+            if let Some(p) = self.inner.state().peer {
+                if p != from {
+                    continue;
+                }
+            }
+            let len = (n - UDP_HDR).min(buf.len());
+            buf[..len].copy_from_slice(&b[UDP_HDR..UDP_HDR + len]);
+            return Ok((len, from));
+        }
+    }
+
+    pub fn peek_from(&self, _: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
+        unsupported()
+    }
+
+    pub fn send_to(&self, buf: &[u8], dst: &SocketAddr) -> io::Result<usize> {
+        let mut b = vec![0u8; UDP_HDR + buf.len()];
+        put_addr(&mut b[0..16], dst);
+        // the local address: the kernel picks the interface
+        b[48..50].copy_from_slice(&dst.port().to_be_bytes());
+        b[UDP_HDR..].copy_from_slice(buf);
+        let n = self.inner.write(&b)?;
+        Ok(n.saturating_sub(UDP_HDR))
+    }
+
+    pub fn duplicate(&self) -> io::Result<UdpSocket> {
+        Ok(UdpSocket { inner: self.inner.duplicate()? })
+    }
