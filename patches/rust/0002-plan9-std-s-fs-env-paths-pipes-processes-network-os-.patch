+pub struct TcpListener {
+    /// the announcement's ctl
+    inner: Socket,
+}
+
+impl TcpListener {
+    pub fn bind<A: ToSocketAddrs>(addr: A) -> io::Result<TcpListener> {
+        each_addr(addr, |a| {
+            let n = netaddr("tcp", a);
+            let mut dir = [0u8; 40];
+            let afd = cvt(unsafe { libc::announce(n.as_ptr(), dir.as_mut_ptr().cast()) })?;
+            let afd = unsafe { FileDesc::from_raw_fd(afd) };
+            // by its name (announce's is the clone file's): the socket's directory is its
+            let n = dir.iter().position(|&c| c == 0).unwrap_or(dir.len());
+            let mut ctl = dir[..n].to_vec();
+            ctl.extend_from_slice(b"/ctl");
+            let ctl = CString::new(ctl).unwrap();
+            let fd = cvt(unsafe { libc::open(ctl.as_ptr(), libc::ORDWR | libc::OCEXEC) })?;
+            drop(afd);
+            set_state(fd, FdState::default());
+            Ok(TcpListener { inner: Socket::new(unsafe { FileDesc::from_raw_fd(fd) }) })
+        })
+    }
+
+    pub fn socket(&self) -> &Socket {
+        &self.inner
+    }
+
+    pub fn into_socket(self) -> Socket {
+        self.inner
+    }
+
+    pub fn socket_addr(&self) -> io::Result<SocketAddr> {
+        self.inner.local()
+    }
+
+    pub fn accept(&self) -> io::Result<(TcpStream, SocketAddr)> {
+        let dir = CString::new(self.inner.dir()?).unwrap();
+        let mut newdir = [0u8; 40];
+        let lcfd = loop {
+            let fd = unsafe { libc::listen(dir.as_ptr(), newdir.as_mut_ptr().cast()) };
+            if fd >= 0 {
+                break fd;
+            }
+            let e = last_error();
+            if e.kind() != io::ErrorKind::Interrupted {
+                return Err(e);
+            }
+        };
+        let lcfd = unsafe { FileDesc::from_raw_fd(lcfd) };
+        let fd = cvt(unsafe { libc::accept(lcfd.as_raw_fd(), newdir.as_ptr().cast()) })?;
+        let s = TcpStream { inner: socket_of(fd)? };
+        let peer = s.peer_addr()?;
+        Ok((s, peer))
+    }
+
+    pub fn duplicate(&self) -> io::Result<TcpListener> {
+        Ok(TcpListener { inner: self.inner.duplicate()? })
+    }
+
+    pub fn set_ttl(&self, ttl: u32) -> io::Result<()> {
+        write_ctl(&self.inner.dir()?, &format!("ttl {ttl}"))
+    }
+
+    pub fn ttl(&self) -> io::Result<u32> {
+        unsupported()
+    }
+
+    pub fn set_hop_limit_v6(&self, limit: u8) -> io::Result<()> {
+        self.set_ttl(limit as u32)
+    }
+
+    pub fn hop_limit_v6(&self) -> io::Result<u8> {
+        unsupported()
+    }
+
+    pub fn set_only_v6(&self, _: bool) -> io::Result<()> {
+        unsupported()
+    }
+
+    pub fn only_v6(&self) -> io::Result<bool> {
+        Ok(false)
+    }
+
+    pub fn take_error(&self) -> io::Result<Option<io::Error>> {
+        Ok(None)
+    }
+
+    pub fn set_nonblocking(&self, _: bool) -> io::Result<()> {
+        unsupported()
+    }
+}
