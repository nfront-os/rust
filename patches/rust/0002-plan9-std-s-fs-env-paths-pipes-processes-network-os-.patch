diff --git a/library/std/src/sys/process/plan9.rs b/library/std/src/sys/process/plan9.rs
new file mode 100644
index 00000000000..ab1ea41cc81
--- /dev/null
+++ b/library/std/src/sys/process/plan9.rs
@@ -0,0 +1,715 @@
+//! Processes of 9front: rfork(2) and exec, waited for through proc(3)'s `wait` file.
+//!
+//! The child is forked without RFMEM: a copy of the parent's memory, which it does not
+//! change. It runs on its own stack segment at once (`pal::proc::rfork_run`: the stack slots
+//! are shared even so), takes no locks and allocates nothing: everything it needs is made
+//! before. It sets up its descriptors 0, 1 and 2 (dup), its directory, its environment
+//! (RFENVG, a copy of the environment group, or RFCENVG, an empty one; then `/env`), and
+//! execs; every other descriptor std made closes on exec. That the exec failed it tells the
+//! parent through a pipe that closes on exec.
+//!
+//! The Waitmsg of a child goes to the proc that forked it, and Rust lets any thread wait
+//! for a child: here every thread reads `/proc/<that proc>/wait`, one at a time, and keeps
+//! what it reads for whom it is. A child of a thread that ended before it has no one to
+//! tell its end (Plan 9 hands no children on): it cannot be waited for.
+
+use super::env::{CommandEnv, CommandEnvs, CommandResolvedEnvs};
+pub use crate::ffi::OsString as EnvKey;
+use crate::ffi::{CString, OsStr, OsString, c_char};
+use crate::num::NonZero;
+use crate::os::plan9::ffi::OsStrExt;
+use crate::os::plan9::io::{AsRawFd, FromRawFd};
+use crate::path::{Path, PathBuf};
+use crate::process::StdioPipes;
+use crate::sync::{Condvar, Mutex};
+use crate::sys::fd::FileDesc;
+use crate::sys::fs::File;
+use crate::sys::pal::proc::{Run, rfork_run};
+use crate::sys::{IntoInner, cvt, last_error};
+use crate::{fmt, io, ptr};
+
+////////////////////////////////////////////////////////////////////////////////
+// Command
+////////////////////////////////////////////////////////////////////////////////
+
+pub struct Command {
+    program: OsString,
+    args: Vec<OsString>,
+    env: CommandEnv,
+    cwd: Option<OsString>,
+    stdin: Option<Stdio>,
+    stdout: Option<Stdio>,
+    stderr: Option<Stdio>,
+}
+
+#[derive(Debug)]
+pub enum Stdio {
+    Inherit,
+    Null,
+    MakePipe,
+    ParentStdout,
+    ParentStderr,
+    Fd(FileDesc),
+}
+
+impl Command {
+    pub fn new(program: &OsStr) -> Command {
+        Command {
+            program: program.to_owned(),
+            args: vec![program.to_owned()],
+            env: Default::default(),
+            cwd: None,
+            stdin: None,
+            stdout: None,
+            stderr: None,
+        }
+    }
+
+    pub fn arg(&mut self, arg: &OsStr) {
+        self.args.push(arg.to_owned());
+    }
+
+    pub fn env_mut(&mut self) -> &mut CommandEnv {
+        &mut self.env
+    }
+
+    pub fn cwd(&mut self, dir: &OsStr) {
+        self.cwd = Some(dir.to_owned());
+    }
+
+    pub fn stdin(&mut self, stdin: Stdio) {
+        self.stdin = Some(stdin);
+    }
+
+    pub fn stdout(&mut self, stdout: Stdio) {
+        self.stdout = Some(stdout);
+    }
+
+    pub fn stderr(&mut self, stderr: Stdio) {
+        self.stderr = Some(stderr);
+    }
+
+    pub fn get_program(&self) -> &OsStr {
+        &self.program
+    }
+
+    pub fn get_args(&self) -> CommandArgs<'_> {
+        let mut iter = self.args.iter();
+        iter.next();
+        CommandArgs { iter }
+    }
+
+    pub fn get_envs(&self) -> CommandEnvs<'_> {
+        self.env.iter()
+    }
+
+    pub fn get_env_clear(&self) -> bool {
+        self.env.does_clear()
+    }
+
+    pub fn get_resolved_envs(&self) -> CommandResolvedEnvs {
+        CommandResolvedEnvs::new(self.env.capture())
+    }
+
+    pub fn get_current_dir(&self) -> Option<&Path> {
+        self.cwd.as_ref().map(|cs| Path::new(cs))
+    }
+
+    /// The file to exec: as rc, a name without a slash is looked up in `$path` (the
+    /// child's, if the command sets it).
+    fn resolve(&self) -> io::Result<PathBuf> {
+        let prog = Path::new(&self.program);
+        let b = self.program.as_bytes();
+        if b.contains(&b'/') || b.starts_with(b"#") {
+            return Ok(prog.to_path_buf());
+        }
+        let path = self
+            .env
+            .iter()
+            .find(|(k, _)| *k == OsStr::new("path"))
+            .map(|(_, v)| v.map(|v| v.to_owned()))
+            .unwrap_or_else(|| {
+                if self.env.does_clear() { None } else { crate::env::var_os("path") }
+            })
+            .unwrap_or_else(|| OsString::from(".\0/bin"));
+        for dir in crate::env::split_paths(&path) {
+            let cand = dir.join(prog);
+            let cand = match self.cwd.as_ref() {
+                Some(cwd) if cand.is_relative() => Path::new(cwd).join(cand),
+                _ => cand,
+            };
+            if crate::sys::fs::exists(&cand).unwrap_or(false) {
+                return Ok(cand);
+            }
+        }
+        Err(io::const_error!(io::ErrorKind::NotFound, "program not found"))
+    }
+
+    pub fn spawn(
+        &mut self,
+        default: Stdio,
+        needs_stdin: bool,
+    ) -> io::Result<(Process, StdioPipes)> {
+        let cstr = |s: &OsStr| {
+            CString::new(s.as_bytes())
+                .map_err(|_| io::const_error!(io::ErrorKind::InvalidInput, "NUL byte in argument"))
+        };
+        let prog = cstr(self.resolve()?.as_os_str())?;
+        let args: Vec<CString> = self.args.iter().map(|a| cstr(a)).collect::<io::Result<_>>()?;
+        let mut argv: Vec<*const c_char> = args.iter().map(|a| a.as_ptr()).collect();
+        argv.push(ptr::null());
+        let cwd = self.cwd.as_deref().map(cstr).transpose()?;
+
+        // the environment: a copy of the group, or an empty one, then the changes
+        let mut flags = libc::RFPROC | libc::RFFDG | libc::RFREND;
+        let mut envs: Vec<(CString, Option<Vec<u8>>)> = Vec::new();
+        if self.env.does_clear() {
+            flags |= libc::RFCENVG;
+        } else if !self.env.is_unchanged() {
+            flags |= libc::RFENVG;
+        }
+        for (k, v) in self.env.iter() {
+            let mut p = b"/env/".to_vec();
+            p.extend_from_slice(k.as_bytes());
+            envs.push((cstr(OsStr::from_bytes(&p))?, v.map(|v| v.as_bytes().to_vec())));
+        }
+        let envs: Vec<EnvOp> = envs
+            .iter()
+            .map(|(p, v)| EnvOp {
+                path: p.as_ptr(),
+                val: v.as_ref().map_or(ptr::null(), |v| v.as_ptr()),
+                len: v.as_ref().map_or(0, |v| v.len()),
+                set: v.is_some(),
+            })
+            .collect();
+
+        // descriptors 0, 1, 2: what the child dups there (-1: its parent's)
+        let mut keep: Vec<FileDesc> = Vec::new();
+        let mut ours: [Option<FileDesc>; 3] = [None, None, None];
+        let mut fds = [-1; 3];
+        let stdin = match self.stdin.take() {
+            Some(s) => s,
+            None if needs_stdin => clone_stdio(&default)?,
+            None => Stdio::Null,
+        };
+        let stdout = match self.stdout.take() {
+            Some(s) => s,
+            None => clone_stdio(&default)?,
+        };
+        let stderr = match self.stderr.take() {
+            Some(s) => s,
+            None => clone_stdio(&default)?,
+        };
+        for (i, s) in [stdin, stdout, stderr].into_iter().enumerate() {
+            match s {
+                Stdio::Inherit => {}
+                Stdio::Null => {
+                    let mode = if i == 0 { libc::OREAD } else { libc::OWRITE };
+                    let fd = cvt(unsafe {
+                        libc::open(c"/dev/null".as_ptr(), mode | libc::OCEXEC)
+                    })?;
+                    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+                    fds[i] = fd.as_raw_fd();
+                    keep.push(fd);
+                }
+                Stdio::MakePipe => {
+                    let (r, w) = crate::sys::pipe::pipe()?;
+                    let (theirs, mine) = if i == 0 { (r, w) } else { (w, r) };
+                    fds[i] = theirs.as_raw_fd();
+                    keep.push(theirs);
+                    ours[i] = Some(mine);
+                }
+                Stdio::ParentStdout => fds[i] = 1,
+                Stdio::ParentStderr => fds[i] = 2,
+                Stdio::Fd(fd) => {
+                    fds[i] = fd.as_raw_fd();
+                    keep.push(fd);
+                }
+            }
+        }
+
+        let (errr, errw) = crate::sys::pipe::pipe()?;
+        let run = Run {
+            f: child,
+            data: ChildArgs {
+                prog: prog.as_ptr(),
+                argv: argv.as_ptr(),
+                cwd: cwd.as_ref().map_or(ptr::null(), |c| c.as_ptr()),
+                fds,
+                envs: envs.as_ptr(),
+                nenv: envs.len(),
+                errw: errw.as_raw_fd(),
+            },
+        };
+        let pid = unsafe { rfork_run(flags, &run) };
+        if pid < 0 {
+            return Err(last_error());
+        }
+        let spawner = unsafe { libc::getpid() };
+        drop(errw);
+        drop(keep);
+        let mut buf = [0u8; libc::ERRMAX + 16];
+        let n = errr.read(&mut buf).unwrap_or(0);
+        if n > 0 {
+            // exec failed: the child is gone
+            let _ = wait_for(spawner, pid);
+            let s = &buf[..n];
+            return Err(io::Error::new(
+                crate::sys::pal::error_kind(s),
+                String::from_utf8_lossy(s).into_owned(),
+            ));
+        }
+        let [stdin, stdout, stderr] = ours;
+        Ok((Process { pid, spawner, status: None }, StdioPipes { stdin, stdout, stderr }))
+    }
+}
+
+/// The default of spawn for each stream (it is used up by each).
+fn clone_stdio(s: &Stdio) -> io::Result<Stdio> {
+    Ok(match s {
+        Stdio::Inherit => Stdio::Inherit,
+        Stdio::Null => Stdio::Null,
+        Stdio::MakePipe => Stdio::MakePipe,
+        Stdio::ParentStdout => Stdio::ParentStdout,
+        Stdio::ParentStderr => Stdio::ParentStderr,
+        Stdio::Fd(fd) => Stdio::Fd(fd.duplicate()?),
+    })
+}
+
+#[repr(C)]
+struct EnvOp {
+    path: *const c_char,
+    val: *const u8,
+    len: usize,
+    set: bool,
+}
+
+#[repr(C)]
+struct ChildArgs {
+    prog: *const c_char,
+    argv: *const *const c_char,
+    cwd: *const c_char,
+    fds: [i32; 3],
+    envs: *const EnvOp,
+    nenv: usize,
+    errw: i32,
+}
+
+/// The child, on its own stack segment, with a copy of its parent's memory: system calls
+/// only.
+unsafe extern "C" fn child(run: *const Run<ChildArgs>) -> ! {
+    unsafe {
+        let a = &(*run).data;
+        // first out of the way of 0, 1, 2, then there (dup clears close-on-exec)
+        let mut tmp = [-1; 3];
+        for i in 0..3 {
+            if a.fds[i] >= 0 {
+                tmp[i] = libc::dup(a.fds[i], -1);
+                if tmp[i] < 0 {
+                    fail(a.errw);
+                }
+            }
+        }
+        for i in 0..3 {
+            if tmp[i] >= 0 {
+                if libc::dup(tmp[i], i as i32) < 0 {
+                    fail(a.errw);
+                }
+                libc::close(tmp[i]);
+            }
+        }
+        if !a.cwd.is_null() && libc::chdir(a.cwd) < 0 {
+            fail(a.errw);
+        }
+        for i in 0..a.nenv {
+            let e = &*a.envs.add(i);
+            if e.set {
+                let fd = libc::create(e.path, libc::OWRITE, 0o664);
+                if fd < 0 {
+                    fail(a.errw);
+                }
+                libc::write(fd, e.val.cast(), e.len as _);
+                libc::close(fd);
+            } else {
+                libc::remove(e.path);
+            }
+        }
+        libc::exec(a.prog, a.argv);
+        fail(a.errw)
+    }
+}
+
+unsafe fn fail(errw: i32) -> ! {
+    unsafe {
+        let mut buf = [0u8; libc::ERRMAX];
+        libc::rerrstr(buf.as_mut_ptr().cast(), buf.len() as _);
+        let n = buf.iter().position(|&c| c == 0).unwrap_or(buf.len()).max(1);
+        libc::write(errw, buf.as_ptr().cast(), n as _);
+        libc::_exits(c"exec".as_ptr())
+    }
+}
+
+pub fn output(cmd: &mut Command) -> io::Result<(ExitStatus, Vec<u8>, Vec<u8>)> {
+    let (mut process, mut pipes) = cmd.spawn(Stdio::MakePipe, false)?;
+    drop(pipes.stdin.take());
+    let (mut stdout, mut stderr) = (Vec::new(), Vec::new());
+    match (pipes.stdout.take(), pipes.stderr.take()) {
+        (None, None) => {}
+        (Some(out), None) => {
+            out.read_to_end(&mut stdout)?;
+        }
+        (None, Some(err)) => {
+            err.read_to_end(&mut stderr)?;
+        }
+        (Some(out), Some(err)) => read_output(out, &mut stdout, err, &mut stderr)?,
+    }
+    let status = process.wait()?;
+    Ok((status, stdout, stderr))
+}
+
+impl From<ChildPipe> for Stdio {
+    fn from(pipe: ChildPipe) -> Stdio {
+        Stdio::Fd(pipe)
+    }
+}
+
+impl From<io::Stdout> for Stdio {
+    fn from(_: io::Stdout) -> Stdio {
+        Stdio::ParentStdout
+    }
+}
+
+impl From<io::Stderr> for Stdio {
+    fn from(_: io::Stderr) -> Stdio {
+        Stdio::ParentStderr
+    }
+}
+
+impl From<File> for Stdio {
+    fn from(file: File) -> Stdio {
+        Stdio::Fd(file.into_inner())
+    }
+}
+
+impl fmt::Debug for Command {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if f.alternate() {
+            let mut d = f.debug_struct("Command");
+            d.field("program", &self.program).field("args", &self.args);
+            if !self.env.is_unchanged() {
+                d.field("env", &self.env);
+            }
+            if self.cwd.is_some() {
+                d.field("cwd", &self.cwd);
+            }
+            d.finish()
+        } else {
+            if let Some(ref cwd) = self.cwd {
+                write!(f, "cd {cwd:?} && ")?;
+            }
+            write!(f, "{:?}", self.program)?;
+            for arg in self.args.iter().skip(1) {
+                write!(f, " {:?}", arg)?;
+            }
+            Ok(())
+        }
+    }
+}
