index 00000000000..6d2a5900e19
--- /dev/null
+++ b/library/std/src/sys/env/plan9.rs
@@ -0,0 +1,91 @@
+//! The environment is env(3), the files of `/env`, shared by the procs of an
+//! environment group (the threads, and children unless they make their own). A value is
+//! the file's bytes: rc's lists keep their elements apart with NUL bytes (`$path`), the
+//! final NUL is dropped, as getenv(2) does (which makes the inner ones spaces; here they
+//! stay, for `env::split_paths`).
+
+pub use super::common::Env;
+use crate::ffi::{CString, OsStr, OsString};
+use crate::io;
+use crate::os::plan9::ffi::{OsStrExt, OsStringExt};
+use crate::path::Path;
+
+fn bad_name(k: &[u8]) -> bool {
+    k.is_empty() || k == b"." || k == b".." || k.contains(&b'/') || k.contains(&0)
+}
+
+fn path(k: &[u8]) -> Option<CString> {
+    if bad_name(k) {
+        return None;
+    }
+    let mut p = b"/env/".to_vec();
+    p.extend_from_slice(k);
+    CString::new(p).ok()
+}
+
+fn read_value(p: &CString) -> Option<Vec<u8>> {
+    unsafe {
+        let fd = libc::open(p.as_ptr(), libc::OREAD | libc::OCEXEC);
+        if fd < 0 {
+            return None;
+        }
+        let mut v = Vec::new();
+        let mut buf = [0u8; 1024];
+        loop {
+            let n = libc::read(fd, buf.as_mut_ptr().cast(), buf.len() as _);
+            if n <= 0 {
+                break;
+            }
+            v.extend_from_slice(&buf[..n as usize]);
+        }
+        libc::close(fd);
+        while v.last() == Some(&0) {
+            v.pop();
+        }
+        Some(v)
+    }
+}
+
+pub fn env() -> Env {
+    let mut vars = Vec::new();
+    if let Ok(dir) = crate::sys::fs::read_dir(Path::new("/env")) {
+        for e in dir.flatten() {
+            let name = e.file_name();
+            if e.file_type().map(|t| t.is_dir()).unwrap_or(true) {
+                continue;
+            }
+            if let Some(p) = path(name.as_bytes()) {
+                if let Some(v) = read_value(&p) {
+                    vars.push((name, OsString::from_vec(v)));
+                }
+            }
+        }
+    }
+    Env::new(vars)
+}
+
+pub fn getenv(k: &OsStr) -> Option<OsString> {
+    read_value(&path(k.as_bytes())?).map(OsString::from_vec)
+}
+
+pub unsafe fn setenv(k: &OsStr, v: &OsStr) -> io::Result<()> {
+    let p = path(k.as_bytes())
+        .ok_or(io::const_error!(io::ErrorKind::InvalidInput, "invalid environment variable name"))?;
+    unsafe {
+        let fd = crate::sys::cvt(libc::create(p.as_ptr(), libc::OWRITE | libc::OCEXEC, 0o664))?;
+        let v = v.as_bytes();
+        let n = libc::write(fd, v.as_ptr().cast(), v.len() as _);
+        libc::close(fd);
+        if n < 0 || n as usize != v.len() {
+            return Err(crate::sys::last_error());
+        }
+    }
+    Ok(())
+}
+
+pub unsafe fn unsetenv(k: &OsStr) -> io::Result<()> {
+    let p = path(k.as_bytes())
+        .ok_or(io::const_error!(io::ErrorKind::InvalidInput, "invalid environment variable name"))?;
+    unsafe { libc::remove(p.as_ptr()) };
+    Ok(())
+}
