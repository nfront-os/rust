+//! Proc macros as programs (9front: Plan 9 has no dynamic libraries).
+//!
+//! A proc-macro crate for a plan9 host is linked as a program (rustc's proc-macro harness
+//! gives it a `main` that calls [`serve`]). rustc starts it ([`load`]) and talks to it over
+//! its standard input and output: the bridge already turns every exchange between macro and
+//! compiler into [`Buffer`]s (token streams and spans are handles, symbols strings), as the
+//! cross-thread execution strategy has them; here they go through a pipe.
+//!
+//! A message is a tag byte, a little-endian `u64` length and that many bytes.
+//! rustc to the program: `L` (how many macros), `R` (run: `u32` index, `u8`
+//! force_show_panics, the input buffer), `r` (the answer to a request).
+//! The program to rustc: `l` (`u32` count), `D` (a request of the macro: a server method),
+//! `O` (the output buffer of a run).
+//!
+//! A program serves one run at a time; a macro whose request makes rustc run another macro
+//! of the same crate (nested `expand_expr`) gets a second instance of the program.
+
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::Mutex;
+
+use super::client::Client;
+use super::server::{Dispatcher, ExecutionStrategy, Server};
+use super::{BridgeConfig, Buffer, Encode, PanicMessage};
+
+fn write_msg(w: &mut impl Write, tag: u8, data: &[u8]) -> io::Result<()> {
+    let mut head = [0u8; 9];
+    head[0] = tag;
+    head[1..].copy_from_slice(&(data.len() as u64).to_le_bytes());
+    w.write_all(&head)?;
+    w.write_all(data)?;
+    w.flush()
+}
+
+fn read_msg(r: &mut impl Read) -> io::Result<(u8, Vec<u8>)> {
+    let mut head = [0u8; 9];
+    r.read_exact(&mut head)?;
+    let len = u64::from_le_bytes(head[1..].try_into().unwrap()) as usize;
+    let mut data = vec![0u8; len];
+    r.read_exact(&mut data)?;
+    Ok((head[0], data))
+}
+
+/* the program's side */
+
+#[allow(unsafe_code)]
+unsafe extern "C" {
+    // the native libc (libp9.a's names)
+    #[link_name = "__p9_dup"]
+    fn dup(old: i32, new: i32) -> i32;
+}
+
+/// The `main` of a proc-macro program: serves rustc on standard input and output until it
+/// closes them. What the macros print to standard output goes to standard error.
+pub fn serve(decls: &'static [Client]) {
+    // the protocol on a copy of fd 1; fd 1 becomes fd 2
+    let mut out = match std::fs::OpenOptions::new().write(true).open("#d/1") {
+        Ok(f) => f,
+        Err(_) => std::process::exit(1),
+    };
+    #[allow(unsafe_code)]
+    unsafe {
+        dup(2, 1)
+    };
+    let mut inp = io::stdin().lock();
+    loop {
+        let Ok((tag, data)) = read_msg(&mut inp) else { std::process::exit(0) };
+        match tag {
+            b'L' => {
+                if write_msg(&mut out, b'l', &(decls.len() as u32).to_le_bytes()).is_err() {
+                    std::process::exit(1);
+                }
+            }
+            b'R' if data.len() >= 5 => {
+                let index = u32::from_le_bytes(data[..4].try_into().unwrap()) as usize;
+                let force_show_panics = data[4] != 0;
+                let input = Buffer::from(data[5..].to_vec());
+                let mut dispatch = |b: Buffer| -> Buffer {
+                    if write_msg(&mut out, b'D', &b).is_err() {
+                        std::process::exit(1);
+                    }
+                    match read_msg(&mut inp) {
+                        Ok((b'r', d)) => Buffer::from(d),
+                        _ => std::process::exit(1),
+                    }
+                };
+                let Some(client) = decls.get(index) else { std::process::exit(1) };
+                let output = (client.run)(BridgeConfig {
+                    input,
+                    dispatch: (&mut dispatch).into(),
+                    force_show_panics,
+                });
+                if write_msg(&mut out, b'O', &output).is_err() {
+                    std::process::exit(1);
+                }
+            }
+            _ => std::process::exit(1),
+        }
+    }
+}
+
+/* rustc's side */
+
+struct Proc {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: ChildStdout,
+}
+
+struct Program {
+    path: PathBuf,
+    idle: Vec<Proc>,
+}
+
+static PROGRAMS: Mutex<Vec<Program>> = Mutex::new(Vec::new());
+
+fn spawn(path: &Path) -> io::Result<Proc> {
+    let mut child = Command::new(path)
+        .arg("--rustc-proc-macro")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .spawn()?;
+    let stdin = child.stdin.take().unwrap();
+    let stdout = child.stdout.take().unwrap();
+    Ok(Proc { _child: child, stdin, stdout })
+}
+
+/// Starts the proc-macro program at `path` and gives its macros as clients that run there
+/// (the names and kinds are in the crate's metadata, in the same order).
+pub fn load(path: &Path) -> Result<&'static [Client], String> {
+    let err = |e: io::Error| format!("proc-macro program {}: {e}", path.display());
+    let mut p = spawn(path).map_err(err)?;
+    write_msg(&mut p.stdin, b'L', &[]).map_err(err)?;
+    let n = match read_msg(&mut p.stdout).map_err(err)? {
+        (b'l', d) if d.len() == 4 => u32::from_le_bytes(d[..4].try_into().unwrap()),
+        _ => return Err(format!("proc-macro program {}: no list of macros", path.display())),
+    };
+    let mut programs = PROGRAMS.lock().unwrap();
+    programs.push(Program { path: path.to_owned(), idle: vec![p] });
+    let program = programs.len() as u64;
+    let clients: Vec<Client> =
+        (0..n as u64).map(|i| Client::remote_placeholder(program << 32 | i)).collect();
+    Ok(Box::leak(clients.into_boxed_slice()))
+}
+
+fn take(program: usize) -> io::Result<Proc> {
+    let path = {
+        let mut programs = PROGRAMS.lock().unwrap();
+        let p = &mut programs[program - 1];
+        if let Some(proc) = p.idle.pop() {
+            return Ok(proc);
+        }
+        p.path.clone()
+    };
+    spawn(&path)
+}
+
+fn give(program: usize, proc: Proc) {
+    PROGRAMS.lock().unwrap()[program - 1].idle.push(proc);
+}
+
+/// Runs a macro of a proc-macro program: the client's `remote` says which.
+pub(super) struct RemoteStrategy {
+    pub(super) remote: u64,
+}
+
+impl RemoteStrategy {
+    fn run<S: Server>(
+        &self,
+        dispatcher: &mut Dispatcher<S>,
+        input: Buffer,
+        force_show_panics: bool,
+    ) -> io::Result<Buffer> {
+        let program = (self.remote >> 32) as usize;
+        let index = (self.remote & 0xffff_ffff) as u32;
+        let mut p = take(program)?;
+        let mut req = Vec::with_capacity(5 + input.len());
+        req.extend_from_slice(&index.to_le_bytes());
+        req.push(force_show_panics as u8);
+        req.extend_from_slice(&input);
+        write_msg(&mut p.stdin, b'R', &req)?;
+        loop {
+            match read_msg(&mut p.stdout)? {
+                (b'D', d) => {
+                    let answer = dispatcher.dispatch(Buffer::from(d));
+                    write_msg(&mut p.stdin, b'r', &answer)?;
+                }
+                (b'O', d) => {
+                    give(program, p);
+                    return Ok(Buffer::from(d));
+                }
+                _ => return Err(io::Error::other("unexpected message")),
+            }
+        }
+    }
+}
+
+impl ExecutionStrategy for RemoteStrategy {
+    fn run_bridge_and_client(
+        &self,
+        dispatcher: &mut Dispatcher<impl Server>,
+        input: Buffer,
+        _run_client: extern "C" fn(BridgeConfig<'_>) -> Buffer,
+        force_show_panics: bool,
+    ) -> Buffer {
+        match self.run(dispatcher, input, force_show_panics) {
+            Ok(b) => b,
+            Err(e) => {
+                // as a panic of the macro: rustc reports it
+                let mut b = Buffer::new();
+                Err::<(), PanicMessage>(PanicMessage::String(format!(
+                    "proc-macro program failed: {e}"
+                )))
+                .encode(&mut b, &mut ());
+                b
+            }
+        }
+    }
+}
