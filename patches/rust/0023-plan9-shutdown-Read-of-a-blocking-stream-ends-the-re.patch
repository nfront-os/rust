+    /// shutdown(Read), as unix has it for every descriptor of the socket (those dup'ed
+    /// before too, `try_clone`): each of the process' descriptors of the conversation (its
+    /// fd table, `#p/<pid>/fd`: "/net/tcp/N/data") reads the end from now on (`FdState`,
+    /// which a dup copies), a pumped one's readers at once. A read already blocked in the
+    /// kernel goes on until data or the end comes (9front has no way to end it but a note,
+    /// and which proc reads is not known).
+    fn shut_read(&self) -> io::Result<()> {
+        let data = format!("{}/data", self.dir()?);
+        let pid = unsafe { libc::getpid() };
+        let table = read_all(&format!("#p/{pid}/fd"))?;
+        // the first line is the working directory; then "fd mode type dev (qid) iounit
+        // offset name"
+        let mut found = false;
+        for line in table.lines().skip(1) {
+            let mut w = line.split_whitespace();
+            let Some(fd) = w.next().and_then(|n| n.parse::<RawFd>().ok()) else { continue };
+            if w.last() != Some(data.as_str()) {
+                continue;
+            }
+            found |= fd == self.fd.as_raw_fd();
+            shut_read_fd(fd);
+        }
+        // the table names the channel as it was opened; this one at least
+        if !found {
+            shut_read_fd(self.fd.as_raw_fd());
+        }
+        Ok(())
+    }
+
     /// set_nonblocking: on, the socket gets its pump.
