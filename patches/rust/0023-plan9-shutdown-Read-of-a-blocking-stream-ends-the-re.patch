 }
 
+/// A remote address as the kernel is to have it: the unspecified one (0.0.0.0, ::) is this
+/// machine, its loopback (as on unix, and Go's net on Plan 9: toLocal). 9front's ip takes it
+/// as any other address: the default route's (a SYN nobody answers).
+fn remote_of(addr: &SocketAddr) -> SocketAddr {
+    let mut a = *addr;
+    match a {
+        SocketAddr::V4(ref mut v4) if v4.ip().is_unspecified() => v4.set_ip(Ipv4Addr::LOCALHOST),
+        SocketAddr::V6(ref mut v6) if v6.ip().is_unspecified() => v6.set_ip(Ipv6Addr::LOCALHOST),
+        _ => {}
+    }
+    a
+}
