+/// A file of any length (a process' fd table).
+fn read_all(path: &str) -> io::Result<String> {
+    use crate::io::Read;
+    let c = CString::new(path).unwrap();
+    let fd = cvt(unsafe { libc::open(c.as_ptr(), libc::OREAD | libc::OCEXEC) })?;
+    let fd = unsafe { FileDesc::from_raw_fd(fd) };
+    let mut s = String::new();
+    (&fd).read_to_string(&mut s)?;
+    Ok(s)
+}
+
+/// A descriptor's reads give the end (Socket::shut_read).
+fn shut_read_fd(fd: RawFd) {
+    let mut s = state(fd);
+    s.read_shut = true;
+    set_state(fd, s);
+    if let Some(p) = pump::get(fd) {
+        p.shutdown_read();
+    }
+}
