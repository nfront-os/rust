+++ b/compiler/rustc_data_structures/src/flock/plan9.rs
@@ -0,0 +1,17 @@
+//! 9front (Plan 9) has no advisory file locks: the lock is taken without one, as cargo does
+//! on 9front (a file system without locks). cargo never builds one crate twice at once into
+//! the same directory; two rustc on one incremental directory by hand are not kept apart.
+use std::fs::File;
+use std::io;
+use std::path::Path;
+
+#[derive(Debug)]
+pub struct Lock {
+    _file: File,
+}
+
+impl Lock {
+    pub fn try_lock(_p: &Path, file: File, _exclusive: bool) -> io::Result<Lock> {
+        Ok(Lock { _file: file })
+    }
+}
