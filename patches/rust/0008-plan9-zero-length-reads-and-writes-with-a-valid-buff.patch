diff --git a/library/std/src/sys/pal/plan9/mod.rs b/library/std/src/sys/pal/plan9/mod.rs
index 07e67636747..b191f5c0af3 100644
--- a/library/std/src/sys/pal/plan9/mod.rs
+++ b/library/std/src/sys/pal/plan9/mod.rs
@@ -9,6 +9,20 @@
 use crate::ffi::{CStr, c_char, c_void};
 use crate::io;
 
+/// The kernel checks a buffer's address even for zero bytes (validaddr), and an empty
+/// slice's pointer is dangling (0x1): zero-length reads and writes, meaningful on Plan 9
+/// (a pipe's message boundaries), get a byte of their own instead.
+pub fn buf_ptr(p: *const u8, n: usize) -> *const libc::c_void {
+    static ZERO: [u8; 1] = [0];
+    if n == 0 { ZERO.as_ptr().cast() } else { p.cast() }
+}
+
+/// As [`buf_ptr`], for buffers the kernel writes (none, at zero bytes).
+pub fn buf_mut_ptr(p: *mut u8, n: usize) -> *mut libc::c_void {
+    static mut ZERO: [u8; 1] = [0];
+    if n == 0 { (&raw mut ZERO).cast() } else { p.cast() }
+}
+
 pub fn unsupported<T>() -> io::Result<T> {
     Err(unsupported_err())
 }
