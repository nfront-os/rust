-        libc::write(errw, buf.as_ptr().cast(), n as _);
+        libc::write(errw, crate::sys::pal::buf_ptr(buf.as_ptr(), n as usize), n as _);
         libc::_exits(c"exec".as_ptr())
     }
 }
