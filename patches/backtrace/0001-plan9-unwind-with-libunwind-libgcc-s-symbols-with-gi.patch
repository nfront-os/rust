index 0000000000000000000000000000000000000000..2e3cd85bc91393e2456807f7801a398706bacfa2
--- /dev/null
+++ b/src/symbolize/gimli/libs_plan9.rs
@@ -0,0 +1,19 @@
+//! 9front (Plan 9): a program is one static executable, at the addresses it was linked
+//! for; proc(3)'s `text` is the file the proc runs.
+
+use super::{Library, LibrarySegment};
+use alloc::vec::Vec;
+
+pub(super) fn native_libraries() -> Vec<Library> {
+    let path = alloc::format!("/proc/{}/text", super::mystd::process::id());
+    let mut ret = Vec::new();
+    ret.push(Library {
+        name: path.into(),
+        segments: alloc::vec![LibrarySegment {
+            stated_virtual_memory_address: 0,
+            len: usize::MAX,
+        }],
+        bias: 0,
+    });
+    ret
+}
