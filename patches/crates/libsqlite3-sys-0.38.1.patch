diff -ruN '--exclude=target' libsqlite3-sys-0.38.1/sqlite3/plan9.c /home/stefan/Devel/9front-rust/crates/libsqlite3-sys-0.38.1/sqlite3/plan9.c
--- a/sqlite3/plan9.c	1970-01-01 01:00:00.000000000 +0100
+++ b/sqlite3/plan9.c	2026-10-29 13:09:42.908566644 +0100
@@ -0,0 +1,13 @@
+/*
+ * 9front (Plan 9): sqlite against APE, Plan 9's POSIX layer, whose fcntl has no record
+ * locks: the default VFS is "unix-dotfile", which locks with a directory (mkdir, an
+ * exclusive create on Plan 9). Called at the end of sqlite3_initialize (SQLITE_EXTRA_INIT).
+ */
+#include "sqlite3.h"
+
+int
+sqlite3_plan9_init(const char *unused)
+{
+	(void)unused;
+	return sqlite3_vfs_register(sqlite3_vfs_find("unix-dotfile"), 1);
+}
