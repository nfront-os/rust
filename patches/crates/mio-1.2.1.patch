diff -ruN '--exclude=target' mio-1.2.1/src/sys/plan9/mod.rs /home/stefan/Devel/9front-rust/crates/mio-1.2.1/src/sys/plan9/mod.rs
--- a/src/sys/plan9/mod.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/src/sys/plan9/mod.rs	2026-10-31 00:54:27.073277245 +0100
@@ -0,0 +1,356 @@
+//! 9front (Plan 9): readiness from std's non-blocking sockets.
+//!
+//! Plan 9 has no epoll, kqueue or poll(2): it only blocks. std gives a socket set
+//! non-blocking a pump, procs that do the blocking calls into buffers, and tells of its
+//! readiness (`std::os::plan9::net`): a hook, called whenever the socket may have become
+//! readable or writable, and `readiness`. The selector keeps the registered descriptors;
+//! a source's hook puts its descriptor on the selector's list and wakes it, `select` makes an
+//! event of each listed source that is ready for what it is registered for (edge-triggered:
+//! a source is listed again only when its state changes). A waker puts its token on the list.
+
+use std::collections::HashMap;
+use std::fmt;
+use std::io;
+use std::net::{self, SocketAddr};
+use std::os::plan9::io::RawFd;
+use std::os::plan9::net::{readiness, set_ready_hook};
+#[cfg(debug_assertions)]
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard};
+use std::time::{Duration, Instant};
+
+use crate::{Interest, Token};
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Event {
+    token: Token,
+    readable: bool,
+    writable: bool,
+    error: bool,
+    read_closed: bool,
+    write_closed: bool,
+}
+
+pub(crate) type Events = Vec<Event>;
+
+pub(crate) mod event {
+    use std::fmt;
+
+    use crate::sys::Event;
+    use crate::Token;
+
+    pub(crate) fn token(e: &Event) -> Token {
+        e.token
+    }
+    pub(crate) fn is_readable(e: &Event) -> bool {
+        e.readable
+    }
+    pub(crate) fn is_writable(e: &Event) -> bool {
+        e.writable
+    }
+    pub(crate) fn is_error(e: &Event) -> bool {
+        e.error
+    }
+    pub(crate) fn is_read_closed(e: &Event) -> bool {
+        e.read_closed
+    }
+    pub(crate) fn is_write_closed(e: &Event) -> bool {
+        e.write_closed
+    }
+    pub(crate) fn is_priority(_: &Event) -> bool {
+        false
+    }
+    pub(crate) fn is_aio(_: &Event) -> bool {
+        false
+    }
+    pub(crate) fn is_lio(_: &Event) -> bool {
+        false
+    }
+    pub(crate) fn debug_details(f: &mut fmt::Formatter<'_>, e: &Event) -> fmt::Result {
+        fmt::Debug::fmt(e, f)
+    }
+}
+
+/// What is waiting for `select`.
+#[derive(Default)]
+struct Pending {
+    /// sources whose state changed
+    fds: Vec<RawFd>,
+    /// wakers' tokens
+    wakes: Vec<Token>,
+}
+
+struct Reg {
+    token: Token,
+    interests: Interest,
+}
+
+struct Inner {
+    regs: Mutex<HashMap<RawFd, Reg>>,
+    pending: Mutex<Pending>,
+    cv: Condvar,
+}
+
+fn lock<T>(m: &Mutex<T>) -> MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+impl Inner {
+    fn changed(&self, fd: RawFd) {
+        let mut p = lock(&self.pending);
+        if !p.fds.contains(&fd) {
+            p.fds.push(fd);
+        }
+        drop(p);
+        self.cv.notify_all();
+    }
+
+    fn wake(&self, token: Token) {
+        let mut p = lock(&self.pending);
+        if !p.wakes.contains(&token) {
+            p.wakes.push(token);
+        }
+        drop(p);
+        self.cv.notify_all();
+    }
+}
+
+#[cfg(debug_assertions)]
+static NEXT_ID: AtomicUsize = AtomicUsize::new(1);
+
+pub(crate) struct Selector {
+    #[cfg(debug_assertions)]
+    id: usize,
+    inner: Arc<Inner>,
+}
+
+impl fmt::Debug for Selector {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Selector").finish()
+    }
+}
+
+impl Selector {
+    pub(crate) fn new() -> io::Result<Selector> {
+        Ok(Selector {
+            #[cfg(debug_assertions)]
+            id: NEXT_ID.fetch_add(1, Ordering::Relaxed),
+            inner: Arc::new(Inner {
+                regs: Mutex::new(HashMap::new()),
+                pending: Mutex::new(Pending::default()),
+                cv: Condvar::new(),
+            }),
+        })
+    }
+
+    #[cfg(debug_assertions)]
+    pub(crate) fn id(&self) -> usize {
+        self.id
+    }
+
+    pub(crate) fn try_clone(&self) -> io::Result<Selector> {
+        Ok(Selector {
+            #[cfg(debug_assertions)]
+            id: self.id,
+            inner: self.inner.clone(),
+        })
+    }
+
+    pub(crate) fn select(&self, events: &mut Events, timeout: Option<Duration>) -> io::Result<()> {
+        events.clear();
+        let deadline = timeout.map(|t| Instant::now() + t);
+        loop {
+            let (fds, wakes) = {
+                let mut p = lock(&self.inner.pending);
+                loop {
+                    if !p.fds.is_empty() || !p.wakes.is_empty() {
+                        break;
+                    }
+                    match deadline {
+                        None => p = self.inner.cv.wait(p).unwrap_or_else(|e| e.into_inner()),
+                        Some(d) => {
+                            let now = Instant::now();
+                            if now >= d {
+                                return Ok(());
+                            }
+                            p = self.inner.cv.wait_timeout(p, d - now).unwrap_or_else(|e| e.into_inner()).0;
+                        }
+                    }
+                }
+                (std::mem::take(&mut p.fds), std::mem::take(&mut p.wakes))
+            };
+            for token in wakes {
+                events.push(Event {
+                    token,
+                    readable: true,
+                    writable: false,
+                    error: false,
+                    read_closed: false,
+                    write_closed: false,
+                });
+            }
+            let regs = lock(&self.inner.regs);
+            for fd in fds {
+                let Some(reg) = regs.get(&fd) else { continue };
+                let r = readiness(fd);
+                let readable = reg.interests.is_readable() && r.readable;
+                let writable = reg.interests.is_writable() && (r.writable || r.error);
+                if readable || writable || r.error {
+                    events.push(Event {
+                        token: reg.token,
+                        readable,
+                        writable,
+                        error: r.error,
+                        read_closed: r.read_closed,
+                        write_closed: r.write_closed,
+                    });
+                }
+            }
+            drop(regs);
+            // only sources not ready for what they are registered for: wait again (or
+            // return at the deadline)
+            if !events.is_empty() || timeout == Some(Duration::ZERO) {
+                return Ok(());
+            }
+        }
+    }
+
+    pub(crate) fn register(&self, fd: RawFd, token: Token, interests: Interest) -> io::Result<()> {
+        lock(&self.inner.regs).insert(fd, Reg { token, interests });
+        let inner = Arc::downgrade(&self.inner);
+        let r = set_ready_hook(
+            fd,
+            Some(Arc::new(move || {
+                if let Some(i) = inner.upgrade() {
+                    i.changed(fd);
+                }
+            })),
+        );
+        if r.is_err() {
+            lock(&self.inner.regs).remove(&fd);
+        }
+        r
+    }
+
+    pub(crate) fn reregister(&self, fd: RawFd, token: Token, interests: Interest) -> io::Result<()> {
+        match lock(&self.inner.regs).get_mut(&fd) {
+            Some(r) => {
+                r.token = token;
+                r.interests = interests;
+            }
+            None => return Err(io::Error::from(io::ErrorKind::NotFound)),
+        }
+        // its state for the new interests
+        self.inner.changed(fd);
+        Ok(())
+    }
+
+    pub(crate) fn deregister(&self, fd: RawFd) -> io::Result<()> {
+        if lock(&self.inner.regs).remove(&fd).is_none() {
+            return Err(io::Error::from(io::ErrorKind::NotFound));
+        }
+        // the socket may be closed already: then it has no hook to clear
+        let _ = set_ready_hook(fd, None);
+        Ok(())
+    }
