     ) -> Option<curl_sys::curl_socket_t> {
+        // 9front: libcurl is built against APE, Plan 9's POSIX layer, whose sockets
+        // are its emulation over /net (renamed __ape_, see 9front-rust's ape9)
+        #[cfg(target_os = "plan9")]
+        {
+            extern "C" {
+                fn __ape_socket(domain: c_int, ty: c_int, protocol: c_int) -> c_int;
+            }
+            let fd = unsafe { __ape_socket(family, socktype, protocol) };
+            return if fd < 0 { None } else { Some(fd as curl_sys::curl_socket_t) };
+        }
+
         // Note that we override this to calling a function in `socket2` to
         // ensure that we open all sockets with CLOEXEC. Otherwise if we rely on
         // libcurl to open sockets it won't use CLOEXEC.
+        #[cfg(not(target_os = "plan9"))]
         return Socket::new(family.into(), socktype.into(), Some(protocol.into()))
             .ok()
             .map(cvt);
