+// 9front (Plan 9): owners are names; the process's is cons(3)'s /dev/user.
+#[cfg(target_os = "plan9")]
+mod impl_ {
+    pub fn is_path_owned_by_current_user(path: &std::path::Path) -> std::io::Result<bool> {
+        use std::os::plan9::fs::MetadataExt;
+        let meta = std::fs::metadata(path)?;
+        let user = std::fs::read("/dev/user")?;
+        Ok(meta.uid().as_encoded_bytes() == user.as_slice())
+    }
