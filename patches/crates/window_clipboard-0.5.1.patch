+//! 9front: the snarf buffer of rio and wsys (/dev/snarf), shared with the
+//! other windows, as the clipboard.
+use crate::ClipboardProvider;
+
+use raw_window_handle::HasDisplayHandle;
+use std::io::Write;
+
+struct Snarf;
+
+pub fn connect<W: HasDisplayHandle>(
+    _window: &W,
+) -> Result<Box<dyn ClipboardProvider>, Box<dyn std::error::Error>> {
+    Ok(Box::new(Snarf))
+}
+
+impl ClipboardProvider for Snarf {
+    fn read(&self) -> Result<String, Box<dyn std::error::Error>> {
+        Ok(String::from_utf8_lossy(&std::fs::read("/dev/snarf")?).into_owned())
+    }
+
+    fn write(
+        &mut self,
+        contents: String,
+    ) -> Result<(), Box<dyn std::error::Error>> {
+        // the window system's file: opened, not created
+        let mut f = std::fs::OpenOptions::new()
+            .write(true)
+            .truncate(true)
+            .open("/dev/snarf")?;
+        f.write_all(contents.as_bytes())?;
+        Ok(())
+    }
+}
