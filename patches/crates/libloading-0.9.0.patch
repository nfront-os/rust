+//! 9front (Plan 9): no dynamic libraries. Opening one always fails, with that said in the
+//! error; the types are there so that programs which may load libraries build.
+use crate::as_filename::AsFilename;
+use crate::as_symbol_name::AsSymbolName;
+use crate::error::DlError;
+use alloc::ffi::CString;
+use core::{fmt, marker};
+
+fn none() -> crate::Error {
+    crate::Error::DlOpen {
+        source: DlError(CString::new("Plan 9 has no dynamic libraries").unwrap()),
+    }
+}
+
+/// A loaded library: never made on Plan 9.
+pub struct Library {
+    _never: (),
+}
+
+impl Library {
+    /// Always fails: Plan 9 has no dynamic libraries.
+    pub unsafe fn new(_filename: impl AsFilename) -> Result<Library, crate::Error> {
+        Err(none())
+    }
+
+    /// Always fails: no library.
+    pub unsafe fn get<T>(&self, _symbol: impl AsSymbolName) -> Result<Symbol<T>, crate::Error> {
+        Err(none())
+    }
+
+    /// Nothing to close.
+    pub fn close(self) -> Result<(), crate::Error> {
+        Ok(())
+    }
+}
+
+impl fmt::Debug for Library {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.write_str("Library@none")
+    }
+}
+
+/// A symbol of a library: never made on Plan 9.
+pub struct Symbol<T> {
+    pointer: *mut core::ffi::c_void,
+    pd: marker::PhantomData<T>,
+}
+
+impl<T> Symbol<T> {
+    /// The raw pointer.
+    pub fn into_raw(self) -> *mut core::ffi::c_void {
+        self.pointer
+    }
+
+    /// The raw pointer.
+    pub fn as_raw_ptr(self) -> *mut core::ffi::c_void {
+        self.pointer
+    }
+}
+
+impl<T> Symbol<Option<T>> {
+    /// Lift Option out of the symbol.
+    pub fn lift_option(self) -> Option<Symbol<T>> {
+        if self.pointer.is_null() {
+            None
+        } else {
+            Some(Symbol { pointer: self.pointer, pd: marker::PhantomData })
+        }
+    }
+}
+
+unsafe impl<T: Send> Send for Symbol<T> {}
+unsafe impl<T: Sync> Sync for Symbol<T> {}
+
+impl<T> Clone for Symbol<T> {
+    fn clone(&self) -> Symbol<T> {
+        Symbol { ..*self }
+    }
+}
+
+impl<T> core::ops::Deref for Symbol<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        unsafe { &*(&self.pointer as *const *mut _ as *const T) }
+    }
+}
+
+impl<T> fmt::Debug for Symbol<T> {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.write_fmt(format_args!("Symbol@{:p}", self.pointer))
+    }
+}
