+/// 9front (Plan 9): a dial through tokio (std connects in the background); no local
+/// address, interface or socket options.
+#[cfg(target_os = "plan9")]
+fn connect(
+    addr: &SocketAddr,
+    config: &Config,
+    connect_timeout: Option<Duration>,
+) -> Result<impl Future<Output = Result<TcpStream, ConnectError>>, ConnectError> {
+    if config.local_address_ipv4.is_some() || config.local_address_ipv6.is_some() {
+        return Err(ConnectError::new(
+            "tcp bind local error",
+            io::Error::from(io::ErrorKind::Unsupported),
+        ));
+    }
+    if config.tcp_keepalive_config.into_tcpkeepalive().is_some() {
+        debug!("tcp keepalive not supported on plan9");
+    }
+    let connect = TcpStream::connect(*addr);
+    Ok(async move {
+        match connect_timeout {
+            Some(dur) => match tokio::time::timeout(dur, connect).await {
+                Ok(Ok(s)) => Ok(s),
+                Ok(Err(e)) => Err(e),
+                Err(e) => Err(io::Error::new(io::ErrorKind::TimedOut, e)),
+            },
+            None => connect.await,
+        }
+        .map_err(ConnectError::m("tcp connect error"))
+    })
+}
