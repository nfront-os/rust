+/*
+ * APE's: the POSIX types of the C libraries built against Plan 9's POSIX layer
+ * (<sys/types.h> &c. of /sys/include/ape, as 9front's gcc port compiles them), for
+ * the bindings of such libraries (zlib, curl, ...). Its functions are not here.
+ */
+pub type off_t = c_longlong;
+pub type mode_t = c_ushort;
+pub type uid_t = c_short;
+pub type gid_t = c_short;
+pub type pid_t = c_int;
+pub type time_t = c_long;
+pub type socklen_t = c_int;
+
+s! {
+    pub struct fd_set {
+        pub fds_bits: [c_long; 3],
+    }
+
+    pub struct sockaddr {
+        pub sa_family: c_ushort,
+        pub sa_data: [c_char; 108],
+    }
+}
