+    #[link_name = "__p9_sleep"]
+    pub fn sleep(ms: c_long) -> c_int;
+    #[link_name = "__p9_alarm"]
+    pub fn alarm(ms: ulong) -> c_long;
+    #[link_name = "__p9_postnote"]
+    pub fn postnote(group: c_int, pid: c_int, note: *const c_char) -> c_int;
+    #[link_name = "__p9_notify"]
+    pub fn notify(f: Option<unsafe extern "C" fn(*mut c_void, *mut c_char)>) -> c_int;
+    #[link_name = "__p9_noted"]
+    pub fn noted(v: c_int) -> c_int;
