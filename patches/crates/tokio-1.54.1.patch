diff -ruN a/src/process/plan9.rs b/src/process/plan9.rs
--- a/src/process/plan9.rs
+++ b/src/process/plan9.rs
@@ -0,0 +1,309 @@
+//! 9front (Plan 9) asynchronous process handling.
+//!
+//! Plan 9 tells a child's end (its Waitmsg) only to the proc that forked it, and has no
+//! SIGCHLD. A thread of its own forks each child and waits for it (std's `Child::wait`),
+//! then completes a oneshot: it lives as long as the child, so the child's end has someone
+//! to go to. A child that is dropped without being waited for is still waited for (no
+//! orphan queue needed).
+//!
+//! The pipes are read and written as on Windows: blocking, in the blocking pool
+//! (`Blocking`), since Plan 9 pipes cannot be polled. A note the program catches
+//! (tokio::signal) interrupts a blocked read or write: it is tried again.
+
+use crate::io::{blocking::Blocking, AsyncRead, AsyncWrite, ReadBuf};
+use crate::process::kill::Kill;
+use crate::process::SpawnedChild;
+use crate::sync::oneshot;
+
+use std::fmt;
+use std::fs::File as StdFile;
+use std::future::Future;
+use std::io;
+use std::os::plan9::io::{AsRawFd, FromRawFd, IntoRawFd, RawFd};
+use std::pin::Pin;
+use std::process::{
+    Child as StdChild, ChildStderr as StdChildStderr, ChildStdin as StdChildStdin,
+    ChildStdout as StdChildStdout, Command, ExitStatus, Stdio,
+};
+use std::sync::Arc;
+use std::task::{Context, Poll};
+
+/// Stack of a waiter thread: it only waits.
+const WAITER_STACK: usize = 256 * 1024;
+
+#[must_use = "futures do nothing unless polled"]
+pub(crate) struct Child {
+    pid: u32,
+    rx: oneshot::Receiver<io::Result<ExitStatus>>,
+    status: Option<ExitStatus>,
+    /// the wait failed (its error was given)
+    failed: bool,
+}
+
+impl fmt::Debug for Child {
+    fn fmt(&self, fmt: &mut fmt::Formatter<'_>) -> fmt::Result {
+        fmt.debug_struct("Child")
+            .field("pid", &self.pid)
+            .field("status", &self.status)
+            .finish()
+    }
+}
+
+type Pipes = (
+    u32,
+    Option<StdChildStdin>,
+    Option<StdChildStdout>,
+    Option<StdChildStderr>,
+);
+
+/// The command borrowed by the waiter thread while `spawn` waits for it.
+struct CommandPtr(*mut Command);
+
+// SAFETY: `spawn` does not return before the thread is done with the command.
+unsafe impl Send for CommandPtr {}
+
+/// Command::spawn: the child is forked by its waiter thread.
+pub(crate) fn spawn(cmd: &mut Command) -> io::Result<SpawnedChild> {
+    let cmd = CommandPtr(cmd);
+    let (spawned_tx, spawned_rx) = std::sync::mpsc::sync_channel::<io::Result<Pipes>>(1);
+    let (tx, rx) = oneshot::channel();
+    std::thread::Builder::new()
+        .name("tokio-process".into())
+        .stack_size(WAITER_STACK)
+        .spawn(move || {
+            let cmd = cmd;
+            // SAFETY: CommandPtr
+            let r = unsafe { (*cmd.0).spawn() };
+            let mut child = match r {
+                Ok(c) => c,
+                Err(e) => {
+                    let _ = spawned_tx.send(Err(e));
+                    return;
+                }
+            };
+            let pipes = (
+                child.id(),
+                child.stdin.take(),
+                child.stdout.take(),
+                child.stderr.take(),
+            );
+            let _ = spawned_tx.send(Ok(pipes));
+            let _ = tx.send(child.wait());
+        })?;
+    let (pid, stdin, stdout, stderr) = spawned_rx
+        .recv()
+        .map_err(|_| io::Error::other("process waiter thread ended"))??;
+    Ok(SpawnedChild {
+        child: Child {
+            pid,
+            rx,
+            status: None,
+            failed: false,
+        },
+        stdin: stdin.map(stdio).transpose()?,
+        stdout: stdout.map(stdio).transpose()?,
+        stderr: stderr.map(stdio).transpose()?,
+    })
+}
+
+/// A child spawned by std (Command::spawn_with): waited for by a thread; its end goes to
+/// the proc that forked it, which must still be there.
+// 9front (Plan 9): only spawn_with (tokio_unstable) builds from a std Child
+#[cfg_attr(all(target_os = "plan9", not(tokio_unstable)), allow(dead_code))]
+pub(crate) fn build_child(mut child: StdChild) -> io::Result<SpawnedChild> {
+    let stdin = child.stdin.take().map(stdio).transpose()?;
+    let stdout = child.stdout.take().map(stdio).transpose()?;
+    let stderr = child.stderr.take().map(stdio).transpose()?;
+    let pid = child.id();
+    let (tx, rx) = oneshot::channel();
+    std::thread::Builder::new()
+        .name("tokio-process".into())
+        .stack_size(WAITER_STACK)
+        .spawn(move || {
+            let _ = tx.send(child.wait());
+        })?;
+    Ok(SpawnedChild {
+        child: Child {
+            pid,
+            rx,
+            status: None,
+            failed: false,
+        },
+        stdin,
+        stdout,
+        stderr,
+    })
+}
+
+impl Child {
+    pub(crate) fn id(&self) -> u32 {
+        self.pid
+    }
+
+    fn done(&mut self, r: Result<io::Result<ExitStatus>, ()>) -> io::Result<ExitStatus> {
+        match r {
+            Ok(Ok(s)) => {
+                self.status = Some(s);
+                Ok(s)
+            }
+            Ok(Err(e)) => {
+                self.failed = true;
+                Err(e)
+            }
+            Err(()) => {
+                self.failed = true;
+                Err(io::Error::other("process waiter thread ended"))
+            }
+        }
+    }
+
+    pub(crate) fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        if let Some(s) = self.status {
+            return Ok(Some(s));
+        }
+        if self.failed {
+            return Err(io::Error::other("waiting for the process failed"));
+        }
+        match self.rx.try_recv() {
+            Ok(r) => self.done(Ok(r)).map(Some),
+            Err(oneshot::error::TryRecvError::Empty) => Ok(None),
+            Err(oneshot::error::TryRecvError::Closed) => self.done(Err(())).map(Some),
+        }
+    }
+}
+
+impl Kill for Child {
+    /// proc(3)'s ctl "kill", as std's; a child that has ended is no error.
+    fn kill(&mut self) -> io::Result<()> {
+        if self.status.is_some() {
+            return Ok(());
+        }
+        match std::fs::OpenOptions::new()
+            .write(true)
+            .open(format!("/proc/{}/ctl", self.pid))
+            .and_then(|mut f| io::Write::write_all(&mut f, b"kill"))
+        {
+            Err(e) if e.kind() != io::ErrorKind::NotFound => Err(e),
+            _ => Ok(()),
+        }
+    }
+}
+
+impl Future for Child {
+    type Output = io::Result<ExitStatus>;
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let inner = Pin::get_mut(self);
+        if let Some(s) = inner.status {
+            return Poll::Ready(Ok(s));
+        }
+        if inner.failed {
+            return Poll::Ready(Err(io::Error::other("waiting for the process failed")));
+        }
+        match Pin::new(&mut inner.rx).poll(cx) {
+            Poll::Ready(r) => Poll::Ready(inner.done(r.map_err(|_| ()))),
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+#[derive(Debug)]
+struct ArcFile(Arc<StdFile>);
+
+impl io::Read for ArcFile {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        loop {
+            match (&*self.0).read(bytes) {
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                r => return r,
+            }
+        }
+    }
+}
+
+impl io::Write for ArcFile {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        loop {
+            match (&*self.0).write(bytes) {
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                r => return r,
+            }
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        (&*self.0).flush()
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct ChildStdio {
+    // Used for accessing the raw fd, even if the io version is busy
+    raw: Arc<StdFile>,
+    // For doing I/O operations asynchronously
+    io: Blocking<ArcFile>,
+}
+
+pub(crate) type ChildStdin = ChildStdio;
+pub(crate) type ChildStdout = ChildStdio;
+pub(crate) type ChildStderr = ChildStdio;
+
+impl ChildStdio {
+    pub(super) fn into_stdio(self) -> io::Result<Stdio> {
+        convert_to_file(self).map(Stdio::from)
+    }
+}
+
+impl AsRawFd for ChildStdio {
+    fn as_raw_fd(&self) -> RawFd {
+        self.raw.as_raw_fd()
+    }
+}
+
+impl AsyncRead for ChildStdio {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.io).poll_read(cx, buf)
+    }
+}
+
+impl AsyncWrite for ChildStdio {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.io).poll_write(cx, buf)
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.io).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.io).poll_shutdown(cx)
+    }
+}
+
+pub(super) fn stdio<T>(io: T) -> io::Result<ChildStdio>
+where
+    T: IntoRawFd,
+{
+    let raw = Arc::new(unsafe { StdFile::from_raw_fd(io.into_raw_fd()) });
+    let io = ArcFile(raw.clone());
+    // SAFETY: the `Read` implementation of `io` does not
+    // read from the buffer it is borrowing and correctly
+    // reports the length of the data written into the buffer.
+    let io = unsafe { Blocking::new(io) };
+    Ok(ChildStdio { raw, io })
+}
+
+fn convert_to_file(child_stdio: ChildStdio) -> io::Result<StdFile> {
+    let ChildStdio { raw, io } = child_stdio;
+    drop(io); // Try to drop the Arc count here
+
+    Arc::try_unwrap(raw).or_else(|raw| raw.try_clone())
+}
