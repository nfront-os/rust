@@ -0,0 +1,85 @@
+//! 9front (Plan 9) specific types for signal handling: notes.
+//!
+//! Plan 9 has notes (notify(2)) where unix has signals: `interrupt` (the console's Delete,
+//! [`ctrl_c`](crate::signal::ctrl_c)), `hangup`, or any other a program is sent. Listening
+//! for a note catches it (`std::os::plan9::note::catch`): from then on the program no
+//! longer ends of it, for the rest of the program, as with unix signals here. A thread
+//! waits for each note caught and wakes its listeners; notes that come before a listener
+//! looks are coalesced, as signals.
+//!
+//! A caught note interrupts the system calls blocked in every proc of the program
+//! ("interrupted"): std's own calls and tokio's try again, a program's own blocking reads
+//! may see `ErrorKind::Interrupted`.
+
+#![cfg(target_os = "plan9")]
+#![cfg_attr(docsrs, doc(cfg(all(target_os = "plan9", feature = "signal"))))]
+
+use crate::signal::RxFuture;
+use crate::sync::watch;
+
+use std::io;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll};
+
+/// Stack of a thread that waits for a note.
+const WAITER_STACK: usize = 128 * 1024;
+
+/// The notes caught: one sender each, fed by its thread.
+static NOTES: Mutex<Vec<(String, Arc<watch::Sender<()>>)>> = Mutex::new(Vec::new());
+
+fn receiver(name: &str) -> io::Result<watch::Receiver<()>> {
+    let mut notes = NOTES.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((_, tx)) = notes.iter().find(|(n, _)| n == name) {
+        return Ok(tx.subscribe());
+    }
+    let note = std::os::plan9::note::catch(name)?;
+    let (tx, rx) = watch::channel(());
+    let tx = Arc::new(tx);
+    let sender = tx.clone();
+    std::thread::Builder::new()
+        .name("tokio-note".into())
+        .stack_size(WAITER_STACK)
+        .spawn(move || loop {
+            note.wait();
+            sender.send_replace(());
+        })?;
+    notes.push((name.to_string(), tx));
+    Ok(rx)
+}
+
+/// A listener for the note `name` (exactly, e.g. `"interrupt"` or `"hangup"`).
+///
+/// # Errors
+///
+/// For notes that cannot be caught: traps (`sys: ...`) and std's own (`alarm`,
+/// `rust: ...`); or when no more notes can be caught.
+pub fn note(name: &str) -> io::Result<Note> {
+    Ok(Note {
+        inner: RxFuture::new(receiver(name)?),
+    })
+}
+
+/// Receives the notes of one name, from [`note`].
+#[must_use = "streams do nothing unless polled"]
+#[derive(Debug)]
+pub struct Note {
+    inner: RxFuture,
+}
+
+impl Note {
+    /// Receives the next note. Always `Some` (`Option` as unix's `Signal::recv`).
+    pub async fn recv(&mut self) -> Option<()> {
+        self.inner.recv().await;
+        Some(())
+    }
+
+    /// Polls to receive the next note.
+    pub fn poll_recv(&mut self, cx: &mut Context<'_>) -> Poll<Option<()>> {
+        self.inner.poll_recv(cx).map(Some)
+    }
+}
+
+/// `interrupt`: the console's Delete.
+pub(super) fn ctrl_c() -> io::Result<RxFuture> {
+    Ok(RxFuture::new(receiver("interrupt")?))
