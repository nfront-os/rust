+/// 9front (Plan 9): `UdpSocket::as_socket` where socket2 is not: no socket options.
+#[cfg(target_os = "plan9")]
+#[allow(dead_code)]
+struct Plan9Socket<'a>(&'a UdpSocket);
+
+#[cfg(target_os = "plan9")]
+#[allow(dead_code)]
+impl Plan9Socket<'_> {
+    fn unsupported<T>(&self) -> io::Result<T> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+    fn tos_v4(&self) -> io::Result<u32> {
+        self.unsupported()
+    }
