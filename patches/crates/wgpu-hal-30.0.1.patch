+    /// 9front: VK_PLAN9_surface, the process's window of wsys or rio (the screen
+    /// without either): the extension's function by name, its struct by hand
+    /// (ash has no VK_PLAN9_surface)
+    #[cfg(target_os = "plan9")]
+    fn create_surface_plan9(&self) -> Result<super::Surface, crate::InstanceError> {
+        #[repr(C)]
+        struct Plan9SurfaceCreateInfo {
+            s_type: vk::StructureType,
+            p_next: *const c_void,
+            flags: vk::Flags,
+            p_window_name: *const core::ffi::c_char, // null: /dev/winname, else the screen
+        }
+        type CreatePlan9Surface = unsafe extern "system" fn(
+            vk::Instance,
+            *const Plan9SurfaceCreateInfo,
+            *const vk::AllocationCallbacks<'_>,
+            *mut vk::SurfaceKHR,
+        ) -> vk::Result;
+
+        if !self.shared.extensions.contains(&PLAN9_SURFACE_NAME) {
+            return Err(crate::InstanceError::new(String::from(
+                "Vulkan driver does not support VK_PLAN9_surface",
+            )));
+        }
+        let instance = self.shared.raw.handle();
+        let f = unsafe {
+            self.shared
+                .entry
+                .get_instance_proc_addr(instance, c"vkCreatePlan9SurfacePLAN9".as_ptr())
+        }
+        .ok_or_else(|| crate::InstanceError::new(String::from("no vkCreatePlan9SurfacePLAN9")))?;
+        let create: CreatePlan9Surface = unsafe { core::mem::transmute(f) };
+        let info = Plan9SurfaceCreateInfo {
+            s_type: vk::StructureType::from_raw(1008999000),
+            p_next: core::ptr::null(),
+            flags: 0,
+            p_window_name: core::ptr::null(),
+        };
+        let mut surface = vk::SurfaceKHR::null();
+        let r = unsafe { create(instance, &info, core::ptr::null(), &mut surface) };
+        if r != vk::Result::SUCCESS {
+            return Err(crate::InstanceError::new(format!("vkCreatePlan9SurfacePLAN9: {r:?}")));
+        }
+        Ok(self.create_surface_from_vk_surface_khr(surface, None))
+    }
