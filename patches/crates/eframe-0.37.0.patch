diff -ruN '--exclude=target' eframe-0.37.0/src/native/painter.rs /home/stefan/Devel/9front-rust/crates/eframe-0.37.0/src/native/painter.rs
--- a/src/native/painter.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/src/native/painter.rs	2026-11-07 07:37:38.547292670 +0100
@@ -0,0 +1,334 @@
+//! 9front: the painter of [`super::wgpu_integration`]: wgpu's, or with the
+//! feature `software` egui's shapes drawn on the processor
+//! (`egui_software_backend`) into the window through softbuffer. The
+//! processor's painter is taken when wgpu finds no adapter for the first
+//! window (a machine without a GPU, or without a Vulkan driver for it), or
+//! when `EFRAME_RENDERER=software`; `EFRAME_RENDERER=wgpu` keeps wgpu (its
+//! error then ends the program, as without the feature).
+//!
+//! [`crate::Renderer::Software`] (or the feature `software` without `wgpu`)
+//! takes the processor's always.
+//!
+//! The application sees which one it got in
+//! [`crate::Frame::wgpu_render_state`]: `None` on the processor.
+
+use core::num::NonZeroU32;
+use std::sync::Arc;
+
+use egui::{ViewportId, ViewportIdSet};
+use winit::window::Window;
+
+pub enum Painter {
+    #[cfg(feature = "wgpu_no_default_features")]
+    Wgpu(egui_wgpu::winit::Painter),
+    #[cfg(feature = "software")]
+    Software(SoftwarePainter),
+}
+
+/// `EFRAME_RENDERER`: `Some(true)` software, `Some(false)` wgpu, `None` either
+#[cfg(all(feature = "software", feature = "wgpu_no_default_features"))]
+fn wanted_software() -> Option<bool> {
+    match std::env::var("EFRAME_RENDERER").as_deref() {
+        Ok("software") => Some(true),
+        Ok("wgpu") => Some(false),
+        _ => None,
+    }
+}
+
+impl Painter {
+    #[allow(clippy::allow_attributes, unused_variables)]
+    pub fn new(
+        egui_ctx: egui::Context,
+        native_options: &crate::NativeOptions,
+        event_loop: &winit::event_loop::ActiveEventLoop,
+    ) -> Self {
+        #[cfg(not(feature = "wgpu_no_default_features"))]
+        {
+            Self::Software(SoftwarePainter::new())
+        }
+        #[cfg(feature = "wgpu_no_default_features")]
+        {
+            #[cfg(feature = "software")]
+            if native_options.renderer == crate::Renderer::Software
+                || wanted_software() == Some(true)
+            {
+                log::info!("painting on the processor");
+                return Self::Software(SoftwarePainter::new());
+            }
+            // Inject the display handle into the wgpu setup so that wgpu can create
+            // surfaces on platforms that require it (e.g. GLES on Wayland).
+            let mut wgpu_options = native_options.wgpu_options.clone();
+            if let egui_wgpu::WgpuSetup::CreateNew(ref mut create_new) = wgpu_options.wgpu_setup
+                && create_new.display_handle.is_none()
+            {
+                create_new.display_handle = Some(Box::new(event_loop.owned_display_handle()));
+            }
+            Self::Wgpu(pollster::block_on(egui_wgpu::winit::Painter::new(
+                egui_ctx,
+                wgpu_options,
+                native_options.viewport.transparent.unwrap_or(false),
+                egui_wgpu::RendererOptions {
+                    msaa_samples: native_options.multisampling as _,
+                    depth_stencil_format: egui_wgpu::depth_format_from_bits(
+                        native_options.depth_buffer,
+                        native_options.stencil_buffer,
+                    ),
+                    dithering: native_options.dithering,
+                    ..Default::default()
+                },
+            )))
+        }
+    }
+
+    #[cfg(feature = "wgpu_no_default_features")]
+    pub fn render_state(&self) -> Option<egui_wgpu::RenderState> {
+        match self {
+            Self::Wgpu(p) => p.render_state(),
+            #[cfg(feature = "software")]
+            Self::Software(_) => None,
+        }
+    }
+
+    #[cfg(feature = "wgpu_no_default_features")]
+    pub fn set_surface_config(&mut self, surface_config: egui_wgpu::SurfaceConfig) {
+        match self {
+            Self::Wgpu(p) => p.set_surface_config(surface_config),
+            // no surface configuration on the processor
+            #[cfg(feature = "software")]
+            Self::Software(_) => {}
+        }
+    }
+
+    pub fn set_window(
+        &mut self,
+        viewport_id: ViewportId,
+        window: Option<Arc<Window>>,
+    ) -> crate::Result {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => {
+                #[cfg(feature = "software")]
+                if p.render_state().is_none()
+                    && window.is_some()
+                    && wanted_software() != Some(false)
+                {
+                    // the first window chooses the adapter: none, the processor
+                    if let Err(err) = pollster::block_on(p.set_window(viewport_id, window.clone()))
+                    {
+                        log::warn!("wgpu: {err}; painting on the processor");
+                        let mut sp = SoftwarePainter::new();
+                        sp.set_window(viewport_id, window);
+                        *self = Self::Software(sp);
+                    }
+                    return Ok(());
+                }
+                Ok(pollster::block_on(p.set_window(viewport_id, window))?)
+            }
+            #[cfg(feature = "software")]
+            Self::Software(p) => {
+                p.set_window(viewport_id, window);
+                Ok(())
+            }
+        }
+    }
+
+    pub fn max_texture_side(&self) -> Option<usize> {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => p.max_texture_side(),
+            #[cfg(feature = "software")]
+            Self::Software(_) => None,
+        }
+    }
+
+    #[allow(clippy::allow_attributes, unused_variables)]
+    pub fn on_window_resize_state_change(&mut self, viewport_id: ViewportId, resizing: bool) {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => p.on_window_resize_state_change(viewport_id, resizing),
+            #[cfg(feature = "software")]
+            Self::Software(_) => {}
+        }
+    }
+
+    #[allow(clippy::allow_attributes, unused_variables)]
+    pub fn on_window_resized(
+        &mut self,
+        viewport_id: ViewportId,
+        width_in_pixels: NonZeroU32,
+        height_in_pixels: NonZeroU32,
+    ) {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => p.on_window_resized(viewport_id, width_in_pixels, height_in_pixels),
+            // the buffer takes the window's size at each frame
+            #[cfg(feature = "software")]
+            Self::Software(_) => {}
+        }
+    }
+
+    #[expect(clippy::too_many_arguments)]
+    pub fn paint_and_update_textures(
+        &mut self,
+        viewport_id: ViewportId,
+        pixels_per_point: f32,
+        clear_color: [f32; 4],
+        clipped_primitives: &[egui::ClippedPrimitive],
+        textures_delta: &mut egui::TexturesDelta,
+        capture_data: Vec<egui::ScreenshotCallback>,
+        window: &Arc<Window>,
+    ) -> f32 {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => p.paint_and_update_textures(
+                viewport_id,
+                pixels_per_point,
+                clear_color,
+                clipped_primitives,
+                textures_delta,
+                capture_data,
+                window,
+            ),
+            #[cfg(feature = "software")]
+            Self::Software(p) => p.paint_and_update_textures(
+                viewport_id,
+                pixels_per_point,
+                clear_color,
+                clipped_primitives,
+                textures_delta,
+                capture_data,
+                window,
+            ),
+        }
+    }
+
+    pub fn gc_viewports(&mut self, active_viewports: &ViewportIdSet) {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => p.gc_viewports(active_viewports),
+            #[cfg(feature = "software")]
+            Self::Software(p) => p.surfaces.retain(|id, _| active_viewports.contains(id)),
+        }
+    }
+
+    pub fn destroy(&mut self) {
+        match self {
+            #[cfg(feature = "wgpu_no_default_features")]
+            Self::Wgpu(p) => p.destroy(),
+            #[cfg(feature = "software")]
+            Self::Software(p) => p.surfaces.clear(),
+        }
+    }
+}
+
+/// egui on the processor: one renderer (its textures are all viewports'),
+/// a softbuffer surface per window
+#[cfg(feature = "software")]
+pub struct SoftwarePainter {
+    render: egui_software_backend::EguiSoftwareRender,
+    surfaces: egui::ViewportIdMap<softbuffer::Surface<Arc<Window>, Arc<Window>>>,
+}
+
+#[cfg(feature = "software")]
+impl SoftwarePainter {
+    fn new() -> Self {
+        Self {
+            // softbuffer's pixels are 0x00RRGGBB: the bytes B G R X
+            render: egui_software_backend::EguiSoftwareRender::new(
+                egui_software_backend::ColorFieldOrder::Bgra,
+            ),
+            surfaces: Default::default(),
+        }
+    }
+
+    fn set_window(&mut self, viewport_id: ViewportId, window: Option<Arc<Window>>) {
+        let Some(window) = window else {
+            // as wgpu's painter: no window, no surfaces
+            self.surfaces.clear();
+            return;
+        };
+        if self.surfaces.contains_key(&viewport_id) {
+            return;
+        }
+        let surface = softbuffer::Context::new(Arc::clone(&window))
+            .and_then(|cx| softbuffer::Surface::new(&cx, window));
+        match surface {
+            Ok(s) => {
+                self.surfaces.insert(viewport_id, s);
+            }
+            Err(err) => log::error!("softbuffer: viewport {viewport_id:?}: {err}"),
+        }
+    }
+
+    #[expect(clippy::too_many_arguments)]
+    fn paint_and_update_textures(
+        &mut self,
+        viewport_id: ViewportId,
+        pixels_per_point: f32,
+        clear_color: [f32; 4],
+        clipped_primitives: &[egui::ClippedPrimitive],
+        textures_delta: &mut egui::TexturesDelta,
+        capture_data: Vec<egui::ScreenshotCallback>,
+        window: &Arc<Window>,
+    ) -> f32 {
+        profiling::function_scope!();
+        let Some(surface) = self.surfaces.get_mut(&viewport_id) else {
+            return 0.0;
+        };
+        let size = window.inner_size();
+        let (Some(w), Some(h)) = (NonZeroU32::new(size.width), NonZeroU32::new(size.height))
+        else {
+            return 0.0; // minimized: the deltas wait for a frame, as with wgpu
+        };
+        if let Err(err) = surface.resize(w, h) {
+            log::error!("softbuffer: resize {w}x{h}: {err}");
+            return 0.0;
+        }
+        let mut buf = match surface.buffer_mut() {
+            Ok(b) => b,
+            Err(err) => {
+                log::error!("softbuffer: {err}");
+                return 0.0;
+            }
+        };
+        // the clear colour (gamma, premultiplied), no alpha in the window
+        let c = |f: f32| (f.clamp(0.0, 1.0) * 255.0 + 0.5) as u32;
+        let bg = c(clear_color[0]) << 16 | c(clear_color[1]) << 8 | c(clear_color[2]);
+        buf.fill(bg);
+        let px: &mut [u32] = &mut buf;
+        // SAFETY: u32 and [u8; 4] have the same size, [u8; 4] the weaker alignment
+        #[expect(unsafe_code)]
+        let px4 = unsafe {
+            core::slice::from_raw_parts_mut(px.as_mut_ptr().cast::<[u8; 4]>(), px.len())
+        };
+        self.render.render(
+            &mut egui_software_backend::BufferMutRef::new(
+                px4,
+                w.get() as usize,
+                h.get() as usize,
+            ),
+            clipped_primitives,
+            textures_delta,
+            pixels_per_point,
+        );
+        textures_delta.clear();
+        if !capture_data.is_empty() {
+            let pixels = buf
+                .iter()
+                .map(|&p| egui::Color32::from_rgb((p >> 16) as u8, (p >> 8) as u8, p as u8))
+                .collect();
+            let image = Arc::new(egui::ColorImage::new(
+                [w.get() as usize, h.get() as usize],
+                pixels,
+            ));
+            for cb in capture_data {
+                cb.complete(Arc::clone(&image));
+            }
+        }
+        let start = web_time::Instant::now();
+        if let Err(err) = buf.present() {
+            log::error!("softbuffer: present: {err}");
+        }
+        start.elapsed().as_secs_f32()
+    }
+}
