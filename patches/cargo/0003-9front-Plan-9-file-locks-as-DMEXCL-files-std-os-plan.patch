+/// 9front (Plan 9) has no advisory locks: a lock is a file opened alone, an exclusive-use
+/// (DMEXCL) file (std::os::plan9::fs::lock_file). Only cargo's own lock files are made such
+/// (DMEXCL would stay on a data file as Cargo.lock, and others could not open it while cargo
+/// has it); the others are not locked, as on a file system without locks. There are no
+/// shared locks: a shared lock is exclusive between processes; in one process its locks of
+/// a file share one open (an exclusive lock after a shared one of the same process, which
+/// flock would refuse, is not kept apart).
+#[cfg(target_os = "plan9")]
+mod plan9 {
+    use super::*;
+    use std::os::plan9::fs::lock_file;
+    use std::sync::{Arc, Mutex, Weak};
+    use std::time::Duration;
+
+    const LOCK_FILES: &[&str] = &[
+        ".cargo-lock",
+        ".cargo-build-lock",
+        ".cargo-artifact-lock",
+        ".package-cache",
+        ".package-cache-mutate",
+        ".lock",
+    ];
+
+    /// This process' locks.
+    static HELD: Mutex<Vec<(PathBuf, Weak<std::os::plan9::fs::FileLock>)>> =
+        Mutex::new(Vec::new());
+
+    pub(super) enum Taken {
+        NotALockFile,
+        WouldBlock,
+        Locked(FileLock),
+    }
+
+    /// Locks a lock file of `fs`; `block`: wait for it, telling the shell, else
+    /// `WouldBlock`. Lock files that cannot be written: `NotALockFile` (read without a
+    /// lock, as cargo does where it cannot lock).
+    pub(super) fn take(
+        fs: &Filesystem,
+        path: &Path,
+        block: Option<(&GlobalContext, &str)>,
+    ) -> CargoResult<Taken> {
+        let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+        if !LOCK_FILES.contains(&name) {
+            return Ok(Taken::NotALockFile);
+        }
+        let path = fs.root.join(path);
+        let mut told = false;
+        loop {
+            {
+                let mut held = HELD.lock().unwrap();
+                held.retain(|(_, w)| w.strong_count() > 0);
+                if let Some(l) = held.iter().find(|(p, _)| *p == path).and_then(|(_, w)| w.upgrade()) {
+                    return Ok(Taken::Locked(FileLock { f: None, path, held: Some(l) }));
+                }
+                let mut r = lock_file(&path, false);
+                if matches!(&r, Err(e) if e.kind() == io::ErrorKind::NotFound) {
+                    paths::create_dir_all(path.parent().unwrap())?;
+                    r = lock_file(&path, false);
+                }
+                match r {
+                    Ok(l) => {
+                        let l = Arc::new(l);
+                        held.push((path.clone(), Arc::downgrade(&l)));
+                        return Ok(Taken::Locked(FileLock { f: None, path, held: Some(l) }));
+                    }
+                    Err(e) if e.kind() == io::ErrorKind::WouldBlock => {}
+                    Err(e)
+                        if matches!(
+                            e.kind(),
+                            io::ErrorKind::PermissionDenied | io::ErrorKind::ReadOnlyFilesystem
+                        ) =>
+                    {
+                        return Ok(Taken::NotALockFile);
+                    }
+                    Err(e) => {
+                        return Err(anyhow::Error::from(e)
+                            .context(format!("failed to lock file: {}", path.display())));
+                    }
+                }
+            }
+            let Some((gctx, msg)) = block else {
+                return Ok(Taken::WouldBlock);
+            };
+            if !told {
+                let msg = if gctx.extra_verbose() {
+                    format!("waiting for file lock on {} ({})", msg, path.display())
+                } else {
+                    format!("waiting for file lock on {}", msg)
+                };
+                gctx.shell().status_with_color("Blocking", &msg, &style::NOTE)?;
+                told = true;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+    }
+}
