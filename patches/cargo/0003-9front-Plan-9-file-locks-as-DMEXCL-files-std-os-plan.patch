 pub struct FileLock {
     f: Option<File>,
     path: PathBuf,
+    /// 9front (Plan 9): the file opened alone (DMEXCL), shared by this process' locks of it.
+    #[cfg(target_os = "plan9")]
+    held: Option<std::sync::Arc<std::os::plan9::fs::FileLock>>,
 }
 
 impl FileLock {
     /// Returns the underlying file handle of this lock.
     pub fn file(&self) -> &File {
+        #[cfg(target_os = "plan9")]
+        if let Some(l) = &self.held {
+            return l.file();
+        }
         self.f.as_ref().unwrap()
     }
 
