+/// 9front (Plan 9): no non-blocking I/O: a thread reads each pipe, `data` is called here.
+#[cfg(target_os = "plan9")]
+mod imp {
+    use std::io::{self, Read};
+    use std::process::{ChildStderr, ChildStdout};
+    use std::sync::mpsc;
+    use std::thread;
+
+    pub fn read2(
+        out_pipe: ChildStdout,
+        err_pipe: ChildStderr,
+        data: &mut dyn FnMut(bool, &mut Vec<u8>, bool),
+    ) -> io::Result<()> {
+        let (tx, rx) = mpsc::channel::<(bool, io::Result<Vec<u8>>)>();
+        fn reader<R: Read + Send + 'static>(
+            mut r: R,
+            is_out: bool,
+            tx: mpsc::Sender<(bool, io::Result<Vec<u8>>)>,
+        ) -> thread::JoinHandle<()> {
+            thread::spawn(move || {
+                let mut buf = vec![0u8; 8192];
+                loop {
+                    match r.read(&mut buf) {
+                        Ok(n) => {
+                            let done = n == 0;
+                            if tx.send((is_out, Ok(buf[..n].to_vec()))).is_err() || done {
+                                break;
+                            }
+                        }
+                        Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                        Err(e) => {
+                            let _ = tx.send((is_out, Err(e)));
+                            break;
+                        }
+                    }
+                }
+            })
+        }
+        let a = reader(out_pipe, true, tx.clone());
+        let b = reader(err_pipe, false, tx);
+        let (mut out, mut err) = (Vec::new(), Vec::new());
+        let mut open = 2;
+        let mut result = Ok(());
+        while open > 0 {
+            let Ok((is_out, chunk)) = rx.recv() else { break };
+            let dst = if is_out { &mut out } else { &mut err };
+            match chunk {
+                Ok(c) if c.is_empty() => {
+                    open -= 1;
+                    data(is_out, dst, true);
+                }
+                Ok(c) => {
+                    dst.extend_from_slice(&c);
+                    data(is_out, dst, false);
+                }
+                Err(e) => {
+                    open -= 1;
+                    result = Err(e);
+                }
+            }
+        }
+        let _ = a.join();
+        let _ = b.join();
+        result
+    }
+}
