+/// 9front (Plan 9): the execute bits of the mode
+#[cfg(target_os = "plan9")]
+fn is_executable<P: AsRef<Path>>(path: P) -> bool {
+    use std::os::plan9::prelude::*;
+    fs::metadata(path)
+        .map(|metadata| metadata.is_file() && metadata.permissions().mode() & 0o111 != 0)
+        .unwrap_or(false)
+}
 #[cfg(windows)]
 fn is_executable<P: AsRef<Path>>(path: P) -> bool {
     path.as_ref().is_file()
 }
 
