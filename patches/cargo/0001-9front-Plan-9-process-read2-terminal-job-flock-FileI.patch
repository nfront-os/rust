+/// 9front (Plan 9): the console is /dev/cons; dup(2) takes the new descriptor.
+#[cfg(target_os = "plan9")]
+mod imp {
+    use super::Stdio;
+    use std::{fs::File, io::Error, os::fd::AsRawFd};
+    pub const IN_DEVICE: &str = "/dev/cons";
+    pub const OUT_DEVICE: &str = "/dev/cons";
+    pub const NULL_DEVICE: &str = "/dev/null";
+
+    unsafe extern "C" {
+        fn dup(oldfd: i32, newfd: i32) -> i32;
+        fn close(fd: i32) -> i32;
+    }
+
+    /// Restores previous stdio when dropped.
+    pub struct ReplacementGuard {
+        std_fileno: i32,
+        previous: i32,
+    }
+
+    impl ReplacementGuard {
+        pub(super) fn new(stdio: Stdio, replacement: &mut File) -> Result<ReplacementGuard, Error> {
+            let std_fileno = match stdio {
+                Stdio::Stdin => 0,
+                Stdio::Stdout => 1,
+            };
+            let previous = unsafe { dup(std_fileno, -1) };
+            if previous == -1 {
+                return Err(std::io::Error::last_os_error());
+            }
+            if unsafe { dup(replacement.as_raw_fd(), std_fileno) } == -1 {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(ReplacementGuard { previous, std_fileno })
+        }
+    }
+
+    impl Drop for ReplacementGuard {
+        fn drop(&mut self) {
+            unsafe {
+                dup(self.previous, self.std_fileno);
+                close(self.previous);
+            }
+        }
+    }
+}
